@page "/login"
@using DotGlasses.App.Auth
@using DotGlasses.Contracts.Auth
@inject HttpClient Http
@inject AuthTokenStore TokenStore
@inject NavigationManager Navigation

<PageTitle>Log in</PageTitle>

<div class="dg-screen" style="justify-content:center; align-items:center;">
    <div style="width:100%; max-width:320px; text-align:center;">
        <img src="images/dot-glasses-logo.png" alt="Dot Glasses" style="width:180px; max-width:60%; margin-bottom:var(--space-5);" />

        @if (TokenStore.IsAuthenticated)
        {
            <div class="alert alert-success">Signed in — token expires @TokenStore.ExpiresAtUtc?.ToLocalTime().ToString("t").</div>
        }

        @if (PasswordSet == 1 && !TokenStore.IsAuthenticated)
        {
            <div class="alert alert-success" role="status">Password set. Sign in with your new password.</div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        <EditForm Model="_request" OnValidSubmit="HandleLoginAsync" style="text-align:left;">
            <div class="dg-field">
                <label>Email</label>
                <InputText @bind-Value="_request.UserName" autocomplete="username" />
            </div>
            <div class="dg-field">
                <label>Password</label>
                <InputText type="password" @bind-Value="_request.Password" autocomplete="current-password" />
            </div>
            <button type="submit" class="dg-btn dg-btn-primary" style="width:100%;" disabled="@_isSubmitting">Log in</button>
        </EditForm>

        <p style="font-size:13px; margin-top:var(--space-3);"><a href="forgot-password">Forgot password?</a></p>

        <p style="font-size:12px; color:#888; margin-top:var(--space-4);">
            Log in once online — you can keep working fully offline after that. Sign out from
            Settings when you hand the device to someone else.
        </p>
    </div>
</div>

@code {
    /// <summary>Set by the Admin Portal's set-password page when it sends someone back here
    /// after a reset they asked for from this app.</summary>
    [Parameter, SupplyParameterFromQuery] public int? PasswordSet { get; set; }

    private readonly LoginRequest _request = new();
    private string? _error;
    private bool _isSubmitting;

    private async Task HandleLoginAsync()
    {
        _isSubmitting = true;
        _error = null;

        try
        {
            // The device's own remembered location, if any — sent so the server can re-issue it
            // when it's still one of the technician's eligible locations (see AuthTokenStore's
            // LastKnownLocationId and CLAUDE.md's outbox/current-location notes).
            _request.PreferredLocationId = TokenStore.LastKnownLocationId;

            var response = await Http.PostAsJsonAsync("api/v1/auth/login", _request);
            if (!response.IsSuccessStatusCode)
            {
                _error = "Email or password is incorrect.";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<LoginResponse>();
            if (result is not null)
            {
                await TokenStore.SetTokenAsync(result.AccessToken, result.ExpiresAtUtc, result.DisplayName, result.CurrentLocationId, result.CurrentLocationName);
                // Home owns routing from here: straight to the dashboard when the token already
                // carries a location, otherwise to the outlet picker or the "can't record here"
                // screen depending on how many locations are eligible.
                Navigation.NavigateTo("/");
            }
        }
        catch (Exception)
        {
            _error = "Couldn't reach the server. Check your connection and try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
