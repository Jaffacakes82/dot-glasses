@page "/forgot-password"
@using DotGlasses.Contracts.Auth
@inject HttpClient Http

<PageTitle>Forgot password</PageTitle>

@* Calls the API directly rather than through the outbox: there is nothing to queue — a reset
   link is only useful now, and it needs a connection to arrive. *@
<div class="dg-screen" style="justify-content:center; align-items:center;">
    <div style="width:100%; max-width:320px; text-align:center;">
        <img src="images/dot-glasses-logo.png" alt="Dot Glasses" style="width:180px; max-width:60%; margin-bottom:var(--space-5);" />

        @if (_sentMessage is not null)
        {
            <div class="alert alert-success" role="status">@_sentMessage</div>
            <p style="font-size:12px; color:#888;">The link works for 24 hours. If nothing arrives, check your spam folder or ask an admin to reset your password.</p>
            <a class="dg-btn dg-btn-primary" style="width:100%; display:block; text-align:center;" href="login">Back to sign in</a>
        }
        else
        {
            <p style="font-size:13px; color:#555; text-align:left;">Enter the email address you sign in with and we'll send you a link to set a new password.</p>

            @if (_error is not null)
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }

            <EditForm Model="_request" OnSubmit="SubmitAsync" style="text-align:left;">
                <div class="dg-field">
                    <label>Email</label>
                    <InputText type="email" @bind-Value="_request.Email" autocomplete="username" />
                </div>
                <button type="submit" class="dg-btn dg-btn-primary" style="width:100%;" disabled="@_isSubmitting">Send link</button>
            </EditForm>

            <p style="font-size:13px; margin-top:var(--space-4);"><a href="login">Back to sign in</a></p>
        }
    </div>
</div>

@code {
    private readonly ForgotPasswordRequest _request = new();
    private string? _sentMessage;
    private string? _error;
    private bool _isSubmitting;

    private async Task SubmitAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_request.Email))
        {
            _error = "Enter your email address.";
            return;
        }

        _isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/forgot-password", _request);
            if (!response.IsSuccessStatusCode)
            {
                _error = "Couldn't send the link. Try again.";
                return;
            }

            // The server's own wording, the same for every address.
            var body = await response.Content.ReadFromJsonAsync<ForgotPasswordResponse>();
            _sentMessage = body?.Message ?? "If that email has an account, we've sent a link.";
        }
        catch (HttpRequestException)
        {
            // Nothing reached a server, so nothing was sent.
            _error = "You're offline. Connect to get a reset link.";
        }
        catch (Exception)
        {
            _error = "Couldn't send the link. Try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
