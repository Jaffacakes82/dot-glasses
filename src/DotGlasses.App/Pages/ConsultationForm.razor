    /// <summary>
    /// Rehydrates the form from a permanently-failed outbox item so the technician corrects what
    /// they originally typed instead of re-entering the whole consultation. The stored payload is
    /// the exact request that was rejected, so replaying it into the same controls is lossless.
    /// </summary>
    private async Task LoadFailedRecordAsync(Guid outboxId)
    {
        var item = await OutboxStore.GetByIdAsync(outboxId);
        if (item is null)
        {
            _summaryMessage = "That record is no longer in the queue — it may already have been sent or discarded.";
            return;
        }

        _summaryMessage = item.LastError;

        switch (item.EntityType)
        {
            case "Test":
                if (JsonSerializer.Deserialize<CreateTestRequest>(item.PayloadJson, JsonOptions) is { } test)
                {
                    _age = test.AgeYears;
                    _gender = test.Gender;
                    _occupationRefId = test.OccupationRefId;
                    _occupationOtherText = test.OccupationOtherText;
                    ApplyReferral(test.ReferredOrTreated, test.ReferralReasonRefId, test.ReferralOtherText, test.TreatedInFacility, test.ReferralLocationFreeText);
                    _testOutcome = test.Outcome;
                    _coatingPreferenceRefId = test.CoatingPreferenceRefId;
                    ApplyLensRange("record", test.LensRangeType, test.PresetCatalogueId,
                        test.SphereLeft, test.CylinderLeft, test.AxisLeft, test.AddLeft,
                        test.SphereRight, test.CylinderRight, test.AxisRight, test.AddRight,
                        test.LensTypeRefId, test.LensTypeOtherText,
                        test.PupilDistanceMm, test.PresetPupilDistanceBucket, test.ChildrensFrame);
                }

                break;

            case "Lead":
                if (JsonSerializer.Deserialize<CreateLeadRequest>(item.PayloadJson, JsonOptions) is { } lead)
                {
                    _age = lead.AgeYears;
                    _gender = lead.Gender;
                    _occupationRefId = lead.OccupationRefId;
                    _occupationOtherText = lead.OccupationOtherText;
                    ApplyReferral(lead.ReferredOrTreated, lead.ReferralReasonRefId, lead.ReferralOtherText, lead.TreatedInFacility, lead.ReferralLocationFreeText);
                    _name = lead.FullName;
                    _phone = lead.PhoneNumber;
                    _consentGiven = lead.ConsentGiven;
                    _reasonNotPurchasedRefId = lead.ReasonNotPurchasedRefId == Guid.Empty ? null : lead.ReasonNotPurchasedRefId;
                    _reasonNotPurchasedOtherText = lead.ReasonNotPurchasedOtherText;
                    _customerToldPrice = lead.CustomerToldPrice;
                    _coatingPreferenceRefId = lead.CoatingPreferenceRefId;
                    _orderFromDotGlasses = lead.OrderFromDotGlasses;
                    _coatingRefIds = lead.CoatingRefIds.ToList();
                    SourceTestId = lead.SourceTestId;
                    ApplyLensRange("record", lead.LensRangeType, lead.PresetCatalogueId,
                        lead.SphereLeft, lead.CylinderLeft, lead.AxisLeft, lead.AddLeft,
                        lead.SphereRight, lead.CylinderRight, lead.AxisRight, lead.AddRight,
                        lead.LensTypeRefId, lead.LensTypeOtherText,
                        lead.PupilDistanceMm, lead.PresetPupilDistanceBucket, lead.ChildrensFrame);
                }

                break;

            case "Sale":
                if (JsonSerializer.Deserialize<CreateSaleRequest>(item.PayloadJson, JsonOptions) is { } sale)
                {
                    _age = sale.AgeYears;
                    _gender = sale.Gender;
                    _occupationRefId = sale.OccupationRefId;
                    _occupationOtherText = sale.OccupationOtherText;
                    ApplyReferral(sale.ReferredOrTreated, sale.ReferralReasonRefId, sale.ReferralOtherText, sale.TreatedInFacility, sale.ReferralLocationFreeText);
                    SourceLeadId = sale.SourceLeadId;
                    _name = sale.FullName;
                    _phone = sale.PhoneNumber ?? string.Empty;
                    _consentGiven = sale.ConsentGiven;
                    _orderFromDotGlasses = sale.OrderFromDotGlasses;
                    _frameColourRefId = sale.FrameColourRefId == Guid.Empty ? null : sale.FrameColourRefId;
                    _frameColourOtherText = sale.FrameColourOtherText;
                    _frameCoverage = sale.FrameCoverage;
                    _coatingRefIds = sale.CoatingRefIds.ToList();
                    _hardCaseSold = sale.HardCaseSold;
                    _hardCaseColourRefId = sale.HardCaseColourRefId;
                    _hardCaseOtherColourText = sale.HardCaseOtherColourText;
                    ApplyLensRange("record", sale.LensRangeType, sale.PresetCatalogueId,
                        sale.SphereLeft, sale.CylinderLeft, sale.AxisLeft, sale.AddLeft,
                        sale.SphereRight, sale.CylinderRight, sale.AxisRight, sale.AddRight,
                        sale.LensTypeRefId, sale.LensTypeOtherText,
                        sale.PupilDistanceMm, sale.PresetPupilDistanceBucket, sale.ChildrensFrame);

                    if (sale.SourceLeadId is { } sourceLeadId)
                    {
                        await RelockToOrderedLeadAsync(sourceLeadId);
                    }
                }

                break;
        }
    }

    /// <summary>
    /// Puts a record's lens block into the controls — a converted Lead's (via SaleAssembly.Seed)
    /// or a Failed record's own. A record holds each eye's lens power and one lens type, not a lens
    /// id (ADR-0007), so on a lens set the lens each dropdown shows is found by matching the power
    /// and lens type in the set (LensSetLenses.Match — the one definition of "the same lens" the
    /// server and the Admin Portal use too). An eye whose lens is no longer in the set is left
    /// empty, power and all, for the technician to choose again; saving without choosing is then
    /// refused against that eye — and the note "The &lt;power&gt; on this &lt;Lead&gt; is no longer in
    /// &lt;set&gt;. Choose a lens." stands under it until a lens is chosen (<paramref name="source"/>
    /// names what the lens came from: "Lead", or "record" for a Failed record). "Same lens for both
    /// eyes" starts ticked only if the two eyes are the same lens. A lens set this device doesn't
    /// offer keeps the powers as recorded — LensRangeSelector says the set isn't available, and
    /// choosing another range clears them.
    /// </summary>
    private void ApplyLensRange(
        string source,
        LensRangeType? rangeType, Guid? catalogueId,
        decimal? sphereLeft, decimal? cylinderLeft, decimal? axisLeft, decimal? addLeft,
        decimal? sphereRight, decimal? cylinderRight, decimal? axisRight, decimal? addRight,
        Guid? lensTypeRefId, string? lensTypeOtherText,
        decimal? pupilDistanceMm, int? presetBucket, bool childrensFrame)
    {
        _lensRange.LensRangeType = rangeType;
        _lensRange.PresetCatalogueId = catalogueId;
        _lensRange.ForgetChosenLenses();
        _lensRange.SphereLeft = sphereLeft;
        _lensRange.CylinderLeft = cylinderLeft;
        _lensRange.AxisLeft = axisLeft;
        _lensRange.AddLeft = addLeft;
        _lensRange.SphereRight = sphereRight;
        _lensRange.CylinderRight = cylinderRight;
        _lensRange.AxisRight = axisRight;
        _lensRange.AddRight = addRight;
        _lensRange.LensTypeRefId = lensTypeRefId;
        _lensRange.LensTypeOtherText = lensTypeOtherText;
        _lensRange.PupilDistanceMm = pupilDistanceMm;
        _lensRange.PresetPupilDistanceBucket = presetBucket;
        _lensRange.ChildrensFrame = childrensFrame;

        if (rangeType is LensRangeType.LensSet && Snapshot.FindCatalogue(catalogueId) is { } lensSet)
        {
            var lenses = lensSet.LensOptions;
            var left = LensSetLenses.Match(lenses, sphereLeft, cylinderLeft, axisLeft, addLeft, lensTypeRefId);
            var right = LensSetLenses.Match(lenses, sphereRight, cylinderRight, axisRight, addRight, lensTypeRefId);
            _lensRange.ChooseLenses(lenses, left?.Id, right?.Id);

            // Read off the record's own powers, which ChooseLenses has just emptied for an eye with
            // no lens. An eye with no power at all (a record that never chose one) has nothing to
            // be "no longer in the set", so it gets no note.
            _lensRange.NoteMissingLenses(
                LensSetLenses.NoLongerInSetNote(source, lensSet.Name, sphereLeft, cylinderLeft, axisLeft, addLeft, left),
                LensSetLenses.NoLongerInSetNote(source, lensSet.Name, sphereRight, cylinderRight, axisRight, addRight, right));
            _lensRange.SameLensForBothEyes = LensSetLenses.SameLens(
                sphereLeft, cylinderLeft, axisLeft, addLeft, sphereRight, cylinderRight, axisRight, addRight);
        }

        // The coatings the record carried (a Lead's preference seeded as the Sale's coating set, or
        // a Failed record's own) meet the lenses just chosen: what they don't offer is unticked with
        // a note, and a trigger's paired coating is ticked — so the form opens in a state the
        // server would accept, or says why not. The caller sets the coatings before calling this.
        ReconcileCoatings();
    }

    /// <summary>What the chosen pair of lens set lenses offers (each lens's own coatings and
    /// pairings, ADR-0007 — <see cref="LensSetLenses.CoatingsFor"/>, the one definition the server
    /// checks a record against too: the coatings both lenses come in, minus any whose pairing
    /// demands one they don't, plus the pairings that apply). Null until both eyes have a lens (with
    /// "Same lens for both eyes" ticked, one choice is both) or when the range isn't a lens set.</summary>
    private LensPairCoatings? PairCoatings
    {
        get
        {
            if (_lensRange.LensRangeType is not LensRangeType.LensSet)
            {
                return null;
            }

            var lenses = Snapshot.FindCatalogue(_lensRange.PresetCatalogueId)?.LensOptions ?? [];
            var left = lenses.FirstOrDefault(l => l.Id == _lensRange.LensLeftId);
            var right = lenses.FirstOrDefault(l => l.Id == _lensRange.LensRightId);
            return left is not null && right is not null ? LensSetLenses.CoatingsFor(left, right) : null;
        }
    }

