    /// <summary>
    /// Queues the record and attempts one immediate push. Returns true when the technician can
    /// move on — either the server accepted it, or we're offline and it is safely queued for
    /// later. Returns false only when the server actively rejected it, in which case the errors
    /// are rendered against the fields and the form stays open with everything still filled in.
    /// </summary>
    private async Task<bool> SubmitAsync<TRequest>(Guid id, string entityType, string apiRoute, TRequest request)
    {
        _saving = true;
        try
        {
            var payloadJson = JsonSerializer.Serialize(request, JsonOptions);

            if (FixOutboxId is not null)
            {
                await OutboxStore.RequeueAsync(id, payloadJson);
            }
            else
            {
                await OutboxStore.EnqueueAsync(new OutboxItem
                {
                    Id = id,
                    EntityType = entityType,
                    ApiRoute = apiRoute,
                    PayloadJson = payloadJson,
                });
            }

            var item = new OutboxItem { Id = id, EntityType = entityType, ApiRoute = apiRoute, PayloadJson = payloadJson };
            var result = await SyncService.TrySyncItemAsync(item);

            if (result.Outcome != SyncAttemptOutcome.Rejected)
            {
                return true;
            }

            _showPriceConfirm = false;
            _summaryMessage = result.Message ?? "The server rejected this record.";
            if (result.FieldErrors is not null)
            {
                _errors.Merge(result.FieldErrors, KnownFields);
            }

            return false;
        }
        finally
        {
            _saving = false;
        }
    }

    private RenderFragment RenderFrameSwatches() => @<div class="dg-field">
        <label>Frame colour</label>
        <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:flex-start;">
            @{
                var frameColours = ReferenceDataClient.GetByCategory(ReferenceDataCategory.FrameColour);
            }
            @foreach (var colour in frameColours.OrderBy(c => c.SortOrder))
            {
                var selected = _frameColourRefId == colour.Id;
                <button type="button" title="@colour.Label" @onclick="() => _frameColourRefId = colour.Id"
                        style="display:flex; flex-direction:column; align-items:center; gap:4px; width:64px; padding:4px; background:none; cursor:pointer;
                               border-radius:var(--radius-md); border: @(selected ? "2px solid var(--dot-orange)" : "1px solid var(--border-default)");">
                    @if (colour.ImageUrl is { } imageUrl)
                    {
                        <img src="@imageUrl" alt="@colour.Label" style="width:48px; height:48px; object-fit:contain;"
                             onerror="this.style.visibility='hidden'" />
                    }
                    else
                    {
                        <div style="width:48px; height:48px; border-radius:50%; background:#eee; display:flex; align-items:center; justify-content:center; font-size:10px; color:#888;">?</div>
                    }
                    <span style="font-size:10px; text-align:center; line-height:1.2;">@colour.Label</span>
                </button>
            }
        </div>
        <FieldError Errors="_errors" For="FrameColourRefId" />
        @{
            var selectedIsOther = _frameColourRefId is { } id && frameColours.FirstOrDefault(c => c.Id == id)?.IsOtherOption == true;
        }
        @if (selectedIsOther)
        {
            <div class="dg-field" style="margin-top:var(--space-2);">
                <label>Frame colour — please specify</label>
                <input @bind="_frameColourOtherText" />
                <FieldError Errors="_errors" For="FrameColourOtherText" />
            </div>
        }
    </div>;
