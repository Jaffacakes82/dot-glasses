@page "/consultation/{Type}"
@using System.Text.Json
@using DotGlasses.App.Leads
@using DotGlasses.App.ReferenceData
@using DotGlasses.App.Validation
@using DotGlasses.Contracts.Common
@using DotGlasses.Contracts.Leads
@using DotGlasses.Contracts.ReferenceData
@using DotGlasses.Contracts.Sales
@using DotGlasses.Contracts.Sync
@using DotGlasses.Contracts.Tests
@using DotGlasses.Rules
@using DotGlasses.Rules.LensPowers
@using DotGlasses.Rules.LensSets
@using DotGlasses.Rules.ReferenceData
@using DotGlasses.Rules.Sales
@using DotGlasses.App.Auth
@implements IDisposable
@inject NavigationManager Navigation
@inject AuthTokenStore TokenStore
@inject IReferenceDataClient ReferenceDataClient
@inject ILeadsClient LeadsClient
@inject ISyncQueueStore OutboxStore
@inject ISyncService SyncService
@inject IJSRuntime JS

<PageTitle>Record @Type</PageTitle>

<div class="dg-screen">
    <div class="dg-top-strip">
        <button class="back" type="button" @onclick="NavigateBackAsync">&#8592;</button>
        <h1>Record @Type</h1>
    </div>

    @if (!ReferenceDataClient.IsLoaded && ReferenceDataClient.LoadError is not null)
    {
        <div class="dg-card" style="margin-bottom:var(--space-3);">
            <p style="color:#c00;">@ReferenceDataClient.LoadError</p>
            <button class="dg-btn dg-btn-ghost" type="button" @onclick="RetryReferenceDataAsync">Retry</button>
        </div>
    }
    else if (!_optionsReady || !ReferenceDataClient.IsLoaded)
    {
        <p>Loading options…</p>
    }
    else if (_showLeadMatchConfirm)
    {
        <div class="dg-card" style="text-align:center;">
            <p style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; font-size:16px;">
                Existing lead found</p>
            @if (_leadMatch?.OrderFromDotGlasses == true)
            {
                @* The Lead's lens is already being made (ADR-0008), and this form's lens has already
                   been typed, so it can't be locked to the ordered one from here. Converting it
                   starts from the Leads list instead, which opens the form with the lens locked. *@
                <p style="color:#555;">
                    @_leadMatch.CustomerFullName already has an open lead, and its lens is already ordered
                    (@(_leadMatch.CustomOrderStatus?.Label() ?? "status unknown")). To record the sale of that lens,
                    open the lead from the Leads list. Saving here records a separate sale and leaves the order unpaid.
                </p>
                <div style="display:flex; gap:8px; margin-top:var(--space-4);">
                    <button class="dg-btn dg-btn-ghost" style="flex:1;" disabled="@_saving"
                            @onclick="DeclineMatchedLead">Save as a separate sale
                    </button>
                    <a class="dg-btn dg-btn-primary" style="flex:1; text-align:center;" href="leads">Go to Leads</a>
                </div>
            }
            else
            {
                <p style="color:#555;">
                    @_leadMatch?.CustomerFullName already has an open lead from an earlier visit. Convert it into this
                    sale
                    instead of creating a separate record?
                </p>
                <div style="display:flex; gap:8px; margin-top:var(--space-4);">
                    <button class="dg-btn dg-btn-ghost" style="flex:1;" disabled="@_saving"
                            @onclick="DeclineMatchedLead">No, new customer
                    </button>
                    <button class="dg-btn dg-btn-primary" style="flex:1;" disabled="@_saving"
                            @onclick="ConvertMatchedLead">Yes, convert it
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <EditForm Model="this" OnValidSubmit="HandleSubmit" style="display:flex; flex-direction:column; flex:1;">
            @if (ReferenceDataClient.IsFromCache)
            {
                <p style="font-size:12px; color:#8a6d00; background:#fff8e1; border-radius:var(--radius-md); padding:8px 12px; margin-bottom:var(--space-3);">
                    Using options saved on this
                    device@(ReferenceDataClient.CachedAtUtc is { } at ? $" on {at.ToLocalTime():d MMM, HH:mm}" : "") —
                    reconnect to pick up any changes.
                </p>
            }

            @if (_summaryMessage is not null || _errors.Unattributed.Count > 0)
            {
                <div class="dg-form-error-summary" role="alert">
                    @if (_summaryMessage is not null)
                    {
                        <span>@_summaryMessage</span>
                    }
                    @if (_errors.Unattributed.Count > 0)
                    {
                        <ul>
                            @foreach (var message in _errors.Unattributed)
                            {
                                <li>@message</li>
                            }
                        </ul>
                    }
                </div>
            }

            <div class="dg-field">
                <label>Age</label>
                <input type="number" min="0" max="120" @bind="_age"
                       @oninput="() => ClearErrors(nameof(CreateTestRequest.AgeYears))"/>
                <FieldError Errors="_errors" For="AgeYears"/>
            </div>
            <div class="dg-field">
                <label>Gender</label>
                <select @bind="_gender" @bind:after="() => ClearErrors(nameof(CreateTestRequest.Gender))">
                    <option value="Female">Female</option>
                    <option value="Male">Male</option>
                </select>
            </div>

            @* One order on every form (Spec D): Age, Gender, Occupation open it and "Referred or
               treated" closes it — on a Test, just ahead of the contact-details question. *@
            <ReferenceDataDropdown Label="Occupation (optional)"
                                   Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Occupation)"
                                   SelectedId="_occupationRefId" SelectedIdChanged="v => _occupationRefId = v"
                                   OtherText="@_occupationOtherText" OtherTextChanged="v => _occupationOtherText = v"
                                   Errors="_errors" Field="OccupationRefId" OtherField="OccupationOtherText"/>

            @if (IsTest)
            {
                <div class="dg-field">
                    <label>Outcome</label>
                    <select @bind="_testOutcome" @bind:after="OnOutcomeChanged">
                        <option value="NoGlassesNeeded">No glasses needed</option>
                        <option value="NeedsGlasses">Needs glasses</option>
                    </select>
                    <FieldError Errors="_errors" For="Outcome"/>
                </div>

                @if (_testOutcome == TestOutcome.NeedsGlasses)
                {
                    <LensRangeSelector Model="_lensRange" Catalogues="ReferenceDataClient.Catalogues"
                                       ReferenceData="Snapshot"
                                       LensTypes="ReferenceDataClient.GetByCategory(ReferenceDataCategory.LensType)"
                                       AllowNoPreference="true" Errors="_errors"
                                       SelectionChanged="OnLensSelectionChanged"/>

                    @RenderCoatingPreference()
                }

                @RenderReferral()

                @if (_testOutcome == TestOutcome.NeedsGlasses)
                {
                    <div class="dg-field">
                        <label>Did the customer share contact details?</label>
                        <div style="display:flex; gap:8px;">
                            <button type="button"
                                    class="dg-btn @(_contactShared == false ? "dg-btn-primary" : "dg-btn-ghost")"
                                    style="flex:1;" @onclick="() => SetContactShared(false)">No
                            </button>
                            <button type="button"
                                    class="dg-btn @(_contactShared == true ? "dg-btn-primary" : "dg-btn-ghost")"
                                    style="flex:1;" @onclick="() => SetContactShared(true)">Yes
                            </button>
                        </div>
                        @if (_contactShared == true)
                        {
                            <p style="font-size:12px; color:#666; text-align:right; margin:var(--space-3) 0 4px;">
                                Recording at @(TokenStore.CurrentLocationName ?? "—")
                            </p>
                            <button type="button" class="dg-btn dg-btn-primary" style="width:100%;" disabled="@_saving"
                                    @onclick="ContinueAsLeadAsync">Continue as Lead &rarr;
                            </button>
                        }
                        else if (_contactShared == false)
                        {
                            <p style="font-size:12px; color:#888; margin-top:var(--space-2);">Recorded as a test only —
                                not entered into the leads pipeline.</p>
                        }
                    </div>
                }
            }
            else
            {
                <div class="dg-field">
                    <label>Full name</label>
                    <input @bind="_name" @oninput="() => ClearErrors(nameof(CreateLeadRequest.FullName))"/>
                    <FieldError Errors="_errors" For="FullName"/>
                </div>
                <div class="dg-field">
                    <label>Phone number@(IsSale ? " (optional)" : "")</label>
                    <input @bind="_phone" @oninput="() => ClearErrors(nameof(CreateLeadRequest.PhoneNumber))"/>
                    <FieldError Errors="_errors" For="PhoneNumber"/>
                </div>
                <div class="dg-field">
                    <label><input type="checkbox" @bind="_consentGiven" style="width:auto; margin-right:8px;"/>Customer
                        consents to be contacted by Dot Glasses for follow-ups/marketing</label>
                </div>

                @if (IsSale && _orderedLead is not null)
                {
                    @RenderOrderedLens(_orderedLead)
                }
                else if (IsSale)
                {
                    <LensRangeSelector Model="_lensRange" Catalogues="ReferenceDataClient.Catalogues"
                                       ReferenceData="Snapshot"
                                       LensTypes="ReferenceDataClient.GetByCategory(ReferenceDataCategory.LensType)"
                                       AllowNoPreference="false" Errors="_errors"
                                       SelectionChanged="OnLensSelectionChanged"
                                       ChildrensFrameChanged="OnChildrensFrameChanged"/>

                    @RenderCoatingRemovedNote()

                    @if (_lensRange.LensRangeType is LensRangeType.LensSet && PairCoatings is { } pairCoatings)
                    {
                        @if (pairCoatings.Offered.Count > 0)
                        {
                            <CoatingMultiSelector Label="Coating"
                                                  AllItems="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Coating)"
                                                  RestrictToIds="pairCoatings.Offered"
                                                  RequiredPairings="pairCoatings.RequiredPairings"
                                                  SelectedIds="_coatingRefIds"
                                                  SelectedIdsChanged="v => _coatingRefIds = v"
                                                  Exclusions="ReferenceDataClient.CoatingExclusions"
                                                  Errors="_errors" Field="CoatingRefIds"/>
                        }
                        else
                        {
                            <p class="dg-lens-note" role="status">No coating can be made on both of these lenses, so
                                they can't be sold together. Choose different lenses.</p>
                        }
                    }

                    @if (_lensRange.LensRangeType == LensRangeType.Custom)
                    {
                        <CoatingMultiSelector Label="Coating"
                                              AllItems="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Coating)"
                                              SelectedIds="_coatingRefIds" SelectedIdsChanged="v => _coatingRefIds = v"
                                              Exclusions="ReferenceDataClient.CoatingExclusions"
                                              Errors="_errors" Field="CoatingRefIds"/>
                        @* Last in the lens section: the order is placed once everything about the
                           lens, its coatings included, has been chosen. *@
                        <div class="dg-field">
                            <label class="dg-choice"><input type="checkbox" @bind="_orderFromDotGlasses"
                                                            @bind:after="() => ClearErrors(nameof(CreateSaleRequest.OrderFromDotGlasses))"/>Order
                                this lens from Dot Glasses (outlet doesn't have stock)</label>
                            <FieldError Errors="_errors" For="OrderFromDotGlasses"/>
                        </div>
                    }
                }

                @if (IsSale)
                {
                    @RenderFrameSwatches()

                    <div class="dg-field">
                        <label><input type="checkbox" @bind="_hardCaseSold"
                                      @bind:after="() => ClearErrors(HardCaseFields)"
                                      style="width:auto; margin-right:8px;"/>Did this person buy a hard case?</label>
                    </div>
                    @if (_hardCaseSold)
                    {
                        <ReferenceDataDropdown Label="Hard case colour"
                                               Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.HardCaseColour)"
                                               SelectedId="_hardCaseColourRefId"
                                               SelectedIdChanged="v => _hardCaseColourRefId = v"
                                               OtherText="@_hardCaseOtherColourText"
                                               OtherTextChanged="v => _hardCaseOtherColourText = v"
                                               Errors="_errors" Field="HardCaseColourRefId"
                                               OtherField="HardCaseOtherColourText"/>
                    }
                }
                else
                {
                    <ReferenceDataDropdown Label="Reason not purchased"
                                           Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.ReasonNotPurchased)"
                                           SelectedId="_reasonNotPurchasedRefId"
                                           SelectedIdChanged="v => _reasonNotPurchasedRefId = v"
                                           OtherText="@_reasonNotPurchasedOtherText"
                                           OtherTextChanged="v => _reasonNotPurchasedOtherText = v"
                                           Errors="_errors" Field="ReasonNotPurchasedRefId"
                                           OtherField="ReasonNotPurchasedOtherText"/>

                    <div class="dg-field">
                        <label>Has the customer been told the price?</label>
                        <div style="display:flex; gap:8px;">
                            <button type="button"
                                    class="dg-btn @(_customerToldPrice == true ? "dg-btn-primary" : "dg-btn-ghost")"
                                    style="flex:1;" @onclick="() => SetCustomerToldPrice(true)">Yes
                            </button>
                            <button type="button"
                                    class="dg-btn @(_customerToldPrice == false ? "dg-btn-primary" : "dg-btn-ghost")"
                                    style="flex:1;" @onclick="() => SetCustomerToldPrice(false)">No
                            </button>
                        </div>
                        <FieldError Errors="_errors" For="CustomerToldPrice"/>
                    </div>

                    <LensRangeSelector Model="_lensRange" Catalogues="ReferenceDataClient.Catalogues"
                                       ReferenceData="Snapshot"
                                       LensTypes="ReferenceDataClient.GetByCategory(ReferenceDataCategory.LensType)"
                                       AllowNoPreference="true" Errors="_errors"
                                       SelectionChanged="OnLensSelectionChanged"/>

                    @* A Lead can order its Custom lens before the customer pays (ADR-0008). An
                       ordered lens is made with a full coating set, so ticking swaps the single
                       optional preference for the coating selector a Sale uses. *@
                    @if (LeadOrdersLens)
                    {
                        <CoatingMultiSelector Label="Coating"
                                              AllItems="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Coating)"
                                              SelectedIds="_coatingRefIds" SelectedIdsChanged="v => _coatingRefIds = v"
                                              Exclusions="ReferenceDataClient.CoatingExclusions"
                                              Errors="_errors" Field="CoatingRefIds"/>
                    }
                    else
                    {
                        @RenderCoatingPreference()
                    }

                    @if (_lensRange.LensRangeType == LensRangeType.Custom)
                    {
                        <div class="dg-field">
                            <label class="dg-choice"><input type="checkbox" @bind="_orderFromDotGlasses"
                                                            @bind:after="OnLeadOrderChanged"/>Order this lens from Dot
                                Glasses</label>
                            @if (_orderFromDotGlasses)
                            {
                                <p style="font-size:12px; color:#666; margin:4px 0 0;">The lens is ordered when this
                                    lead is saved, before the customer pays. It needs both eyes, the pupil distance and
                                    its coatings, and it can't be changed afterwards.</p>
                            }
                            <FieldError Errors="_errors" For="OrderFromDotGlasses"/>
                        </div>
                    }
                }

                @RenderReferral()
            }

            @if (!(IsTest && _testOutcome == TestOutcome.NeedsGlasses && _contactShared == true))
            {
                <div style="padding-top:var(--space-4);">
                    <p style="font-size:12px; color:#666; text-align:right; margin-bottom:4px;">
                        Recording at @(TokenStore.CurrentLocationName ?? "—")
                    </p>
                    <div style="display:flex; gap:8px;">
                        <a class="dg-btn dg-btn-ghost" style="flex:1; text-align:center;" href="/">Cancel</a>
                        <button type="submit" class="dg-btn dg-btn-primary" style="flex:1;"
                                disabled="@_saving">@(IsTest ? "Save test" : "Save")</button>
                    </div>
                </div>
            }
        </EditForm>
    }
</div>

@code {
    [Parameter] public string Type { get; set; } = "test";
    [Parameter, SupplyParameterFromQuery] public Guid? SourceTestId { get; set; }

    /// <summary>Set when this Sale form was opened from the Leads worklist to convert an open
    /// Lead — see Leads.razor. Prefills name/phone/prescription/preference from the Lead, and is
    /// submitted back as CreateSaleRequest.SourceLeadId so the server links them atomically.</summary>
    [Parameter, SupplyParameterFromQuery]
    public Guid? SourceLeadId { get; set; }

    [Parameter, SupplyParameterFromQuery] public int? PrefillAge { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? PrefillGender { get; set; }

    // The Test's "Referred or treated" answers, offered to the Lead it continues into as starting
    // values: loaded into the controls once, changeable, and each record stores its own answer.
    [Parameter, SupplyParameterFromQuery] public bool? PrefillReferred { get; set; }
    [Parameter, SupplyParameterFromQuery] public Guid? PrefillReferralReason { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? PrefillReferralOther { get; set; }
    [Parameter, SupplyParameterFromQuery] public bool? PrefillTreatedInFacility { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? PrefillReferralLocation { get; set; }

    /// <summary>Set when this form was opened to correct a permanently-failed outbox record —
    /// see FailedRecords.razor. The corrected payload is re-queued under the same Id so the
    /// server's idempotent upsert still applies.</summary>
    [Parameter, SupplyParameterFromQuery]
    public Guid? FixOutboxId { get; set; }

    private bool IsTest => Type.Equals("test", StringComparison.OrdinalIgnoreCase);
    private bool IsSale => Type.Equals("sale", StringComparison.OrdinalIgnoreCase);

    private int? _age;
    private Gender _gender = Gender.Female;
    private Guid? _occupationRefId;
    private string? _occupationOtherText;
    private bool _saving;

    // Automatic conversion-match prompt (Sale only, and only when not already converting a
    // specific Lead via SourceLeadId) — see HandleSubmit.
    private bool _showLeadMatchConfirm;
    private LeadDto? _leadMatch;
    private bool _leadMatchChecked;

    private readonly FormErrors _errors = new();
    private string? _summaryMessage;

    /// <summary>True while <see cref="_summaryMessage"/> is the line over highlighted field errors
    /// (the client's "Fix the highlighted fields…", or a server rejection that landed against fields), so it can go
    /// when the last of them is corrected. Other summaries — a Failed record's stored reason, a
    /// whole-record rejection, "that lead couldn't be loaded" — aren't about a field and stay.</summary>
    private bool _summaryFollowsFieldErrors;

    // Test-only
    private TestOutcome _testOutcome = TestOutcome.NoGlassesNeeded;
    private bool? _contactShared;

    // "Referred or treated" — shared across all three (Test/Lead/Sale), unconditional on outcome.
    private bool _referredOrTreated;
    private Guid? _referralReasonRefId;
    private string? _referralOtherText;
    private string? _referralLocationFreeText;
    private bool _treatedInFacility;

    // Lead/Sale shared
    private string _name = string.Empty;
    private string _phone = string.Empty;
    private bool _consentGiven;
    private readonly LensRangeSelection _lensRange = new();

    // Lead-only
    private Guid? _reasonNotPurchasedRefId;
    private string? _reasonNotPurchasedOtherText;
    private bool? _customerToldPrice;

    // Custom-range coating preference — shared between Test (NeedsGlasses) and Lead, both of
    // which treat coating as optional (unlike Sale, which requires it).
    private Guid? _coatingPreferenceRefId;

    // Sale-only
    private Guid? _frameColourRefId;
    private string? _frameColourOtherText;
    private FrameCoverage _frameCoverage = FrameCoverage.FullFrame;

    // The Coating set and the order tick: a Sale's, and a Lead's when it orders its Custom lens
    // (ADR-0008).
    private List<Guid> _coatingRefIds = [];
    private bool _orderFromDotGlasses;

    /// <summary>Whether this Lead is ordering its lens. The tick only shows for a Custom range, so
    /// a tick left over from an earlier Custom choice is ignored rather than becoming an error
    /// against a control the technician can no longer see — as BuildSaleAnswers does for a Sale.</summary>
    private bool LeadOrdersLens => !IsTest && !IsSale && _lensRange.LensRangeType == LensRangeType.Custom && _orderFromDotGlasses;

    /// <summary>The Lead this Sale converts, when that Lead's lens is already ordered: the lens
    /// and its coatings are then shown read-only and sent as the Lead holds them, and no second
    /// order is asked for. Null for every other Sale.</summary>
    private LeadDto? _orderedLead;

    private bool _hardCaseSold;
    private Guid? _hardCaseColourRefId;
    private string? _hardCaseOtherColourText;

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    // Which server error keys this form has a control for. Anything outside these lands in the
    // summary band instead of being silently dropped — see FormErrors.Merge.
    private static readonly string[] TestFields =
    [
        "AgeYears", "Gender", "OccupationRefId", "OccupationOtherText", "Outcome",
        "ReferredOrTreated", "ReferralReasonRefId", "ReferralOtherText", "ReferralLocationFreeText", "TreatedInFacility"
    ];

    // The referral block's keys: "Referred or treated" shows or hides all of them together.
    private static readonly string[] ReferralFields =
        ["ReferredOrTreated", "ReferralReasonRefId", "ReferralOtherText", "ReferralLocationFreeText", "TreatedInFacility"];

    private static readonly string[] LensFields = LensErrorKeys.All;

    private static readonly string[] TreatedFields = ["TreatedInFacility", "ReferralLocationFreeText"];
    private static readonly string[] HardCaseFields = ["HardCaseSold", "HardCaseColourRefId", "HardCaseOtherColourText"];
    private static readonly string[] FrameColourFields = ["FrameColourRefId", "FrameColourOtherText"];

    private static readonly string[] LeadFields =
    [
        .. TestFields, .. LensFields, "FullName", "PhoneNumber", "ReasonNotPurchasedRefId", "ReasonNotPurchasedOtherText", "CustomerToldPrice", "CoatingPreferenceRefId",
        "CoatingRefIds", "OrderFromDotGlasses"
    ];

    private static readonly string[] LeadOrderFields = ["OrderFromDotGlasses", "CoatingRefIds", "CoatingPreferenceRefId", "PupilDistanceMm"];

    /// <summary>Ticking or unticking the order swaps which coating control is on screen and
    /// whether the pupil distance is required, so messages about any of them no longer apply.</summary>
    private void OnLeadOrderChanged() => ClearErrors(LeadOrderFields);

    // HardCaseSold and OrderFromDotGlasses each own a checkbox on this form, so a failure keyed to
    // either belongs against that checkbox rather than in the summary band. Both rules are
    // unreachable today only because BuildSaleRequest defensively nulls their dependent fields —
    // exactly the hand-coordination this ticket removes elsewhere, so don't rely on it here.
    // FrameCoverage and Id are deliberately absent: neither has a control (frame coverage is
    // pinned to FullFrame, Id is a generated key), so their failures are genuinely unattributable.
    private static readonly string[] SaleFields =
    [
        .. TestFields, .. LensFields, "FullName", "PhoneNumber", "CoatingRefIds", "FrameColourRefId", "FrameColourOtherText",
        "HardCaseSold", "HardCaseColourRefId", "HardCaseOtherColourText", "OrderFromDotGlasses"
    ];

    private string[] KnownFields => IsTest ? [.. TestFields, .. LensFields] : IsSale ? SaleFields : LeadFields;

    /// <summary>Rebuilt per check rather than cached at init: the technician can Retry a
    /// reference-data fetch mid-form, and a snapshot pinned at OnInitializedAsync would then be
    /// answering from data the dropdowns no longer show. It is an in-memory projection over lists
    /// this device already holds — no I/O, and Validate() runs only on a save.</summary>
    private ReferenceDataSnapshot Snapshot => ReferenceDataClient.ToSnapshot();

    protected override void OnInitialized() => _errors.Changed += OnErrorsChanged;

    public void Dispose() => _errors.Changed -= OnErrorsChanged;

    /// <summary>Drops the messages against the control(s) the technician just changed — see
    /// <see cref="FormErrors.ClearFields"/>. Nothing is re-validated; Save runs the whole check.</summary>
    private void ClearErrors(params IEnumerable<string> fields) => _errors.ClearFields(fields);

    /// <summary>Controls clear their own keys, often from a child component, so the form hears about
    /// it through the bag: the summary line goes with the last field message, and the form re-renders
    /// so every FieldError (and the band) reflects it.</summary>
    private void OnErrorsChanged()
    {
        if (_summaryFollowsFieldErrors && !_errors.HasMessages)
        {
            _summaryMessage = null;
            _summaryFollowsFieldErrors = false;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnOutcomeChanged()
    {
        ClearErrors("Outcome");

        // "No glasses needed" hides the lens section and the coating preference.
        if (_testOutcome != TestOutcome.NeedsGlasses)
        {
            ClearErrors(LensFields);
            ClearErrors("CoatingPreferenceRefId");
        }
    }

    private void SetContactShared(bool shared)
    {
        _contactShared = shared;

        // The only message tied to this answer is the "continue as a Lead instead" one on Outcome.
        ClearErrors("Outcome");
    }

    private void SetCustomerToldPrice(bool told)
    {
        _customerToldPrice = told;
        ClearErrors(nameof(CreateLeadRequest.CustomerToldPrice));
    }

    private bool _optionsReady;

    protected override async Task OnInitializedAsync()
    {
        // Fresh at every form open, and only then — see IReferenceDataClient.RefreshAsync. The
        // form stays on "Loading options…" until this returns, even when a copy is already held:
        // rendering it first would let the refresh swap the options under answers already given.
        await ReferenceDataClient.RefreshAsync();
        _optionsReady = true;

        if (FixOutboxId is { } fixId)
        {
            await LoadFailedRecordAsync(fixId);
            return;
        }

        if (SourceLeadId is { } leadId)
        {
            await LoadFromLeadAsync(leadId);
        }

        if (PrefillAge is { } age)
        {
            _age = age;
        }

        if (PrefillGender is not null && Enum.TryParse<Gender>(PrefillGender, out var gender))
        {
            _gender = gender;
        }

        if (PrefillReferred == true)
        {
            ApplyReferral(true, PrefillReferralReason, PrefillReferralOther, PrefillTreatedInFacility == true,
                PrefillTreatedInFacility == true ? null : PrefillReferralLocation);
        }
    }

    /// <summary>
    /// Prefills a Sale from an open Lead's already-captured details when converting from the
    /// Leads worklist. Frame colour, coating (for a Custom range), and hard case are deliberately
    /// left for the technician to fill in as normal — Lead never captures them (they're genuinely
    /// new decisions made at the point of sale, not something a Lead could have recorded).
    /// </summary>
    private async Task LoadFromLeadAsync(Guid leadId)
    {
        var lead = await LeadsClient.GetByIdAsync(leadId);
        if (lead is null)
        {
            _summaryMessage = "That lead couldn't be loaded — it may already have been converted or removed.";
            return;
        }

        // What a Lead contributes is SaleAssembly.Seed's to decide, shared with the Admin Portal's
        // conversion screen. Applied into the controls rather than over the request, which is what
        // keeps the technician's edits — and the automatic conversion-match path, where the Lead is
        // only found after the form is filled in — working; see Seed.
        var seeded = SaleAssembly.Seed(lead);

        _name = seeded.FullName;
        _phone = seeded.PhoneNumber ?? string.Empty;
        _age = seeded.AgeYears;
        _gender = seeded.Gender;
        _occupationRefId = seeded.OccupationRefId;
        _occupationOtherText = seeded.OccupationOtherText;
        _consentGiven = seeded.ConsentGiven;
        _coatingRefIds = seeded.CoatingRefIds;
        ApplyLensRange("Lead", seeded.LensRangeType, seeded.PresetCatalogueId,
            seeded.SphereLeft, seeded.CylinderLeft, seeded.AxisLeft, seeded.AddLeft,
            seeded.SphereRight, seeded.CylinderRight, seeded.AxisRight, seeded.AddRight,
            seeded.LensTypeRefId, seeded.LensTypeOtherText,
            seeded.PupilDistanceMm, seeded.PresetPupilDistanceBucket, seeded.ChildrensFrame);

        // An ordered Lead's lens and coatings are locked to what was ordered: seeded above like
        // any Lead's, then shown read-only instead of in controls.
        _orderedLead = lead.OrderFromDotGlasses ? lead : null;
    }

    /// <summary>A Failed Sale that converts an ordered Lead reopens locked like the first time:
    /// the lens and coatings are put back to what the Lead ordered, since a difference there is
    /// the one thing the technician could not correct from this form anyway. Everything else
    /// keeps what was typed. Offline, the Lead can't be read and the form opens unlocked; the
    /// server still refuses a mismatch.</summary>
    private async Task RelockToOrderedLeadAsync(Guid leadId)
    {
        if (await LeadsClient.GetByIdAsync(leadId) is not { OrderFromDotGlasses: true } lead)
        {
            return;
        }

        var seeded = SaleAssembly.Seed(lead);
        _coatingRefIds = seeded.CoatingRefIds;
        _orderFromDotGlasses = false;
        ApplyLensRange("Lead", seeded.LensRangeType, seeded.PresetCatalogueId,
            seeded.SphereLeft, seeded.CylinderLeft, seeded.AxisLeft, seeded.AddLeft,
            seeded.SphereRight, seeded.CylinderRight, seeded.AxisRight, seeded.AddRight,
            seeded.LensTypeRefId, seeded.LensTypeOtherText,
            seeded.PupilDistanceMm, seeded.PresetPupilDistanceBucket, seeded.ChildrensFrame);
        _orderedLead = lead;
    }

