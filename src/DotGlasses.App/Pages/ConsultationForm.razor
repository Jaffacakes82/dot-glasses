@page "/consultation/{Type}"
@using System.Text.Json
@using DotGlasses.App.Leads
@using DotGlasses.App.ReferenceData
@using DotGlasses.App.Validation
@using DotGlasses.Contracts.Common
@using DotGlasses.Contracts.Leads
@using DotGlasses.Contracts.ReferenceData
@using DotGlasses.Contracts.Sales
@using DotGlasses.Contracts.Sync
@using DotGlasses.Contracts.Tests
@using DotGlasses.Rules
@using DotGlasses.Rules.ReferenceData
@using DotGlasses.Rules.Sales
@inject NavigationManager Navigation
@inject IReferenceDataClient ReferenceDataClient
@inject ILeadsClient LeadsClient
@inject ISyncQueueStore OutboxStore
@inject ISyncService SyncService
@inject IJSRuntime JS

<PageTitle>Record @Type</PageTitle>

<div class="dg-screen">
    <div class="dg-top-strip">
        <button class="back" type="button" @onclick="NavigateBackAsync">&#8592;</button>
        <h1>Record @Type</h1>
    </div>

    @if (!ReferenceDataClient.IsLoaded && ReferenceDataClient.LoadError is not null)
    {
        <div class="dg-card" style="margin-bottom:var(--space-3);">
            <p style="color:#c00;">@ReferenceDataClient.LoadError</p>
            <button class="dg-btn dg-btn-ghost" type="button" @onclick="RetryReferenceDataAsync">Retry</button>
        </div>
    }
    else if (!ReferenceDataClient.IsLoaded)
    {
        <p>Loading options…</p>
    }
    else if (_showLeadMatchConfirm)
    {
        <div class="dg-card" style="text-align:center;">
            <p style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; font-size:16px;">Existing lead found</p>
            <p style="color:#555;">
                @_leadMatch?.CustomerFullName already has an open lead from an earlier visit. Convert it into this sale
                instead of creating a separate record?
            </p>
            <div style="display:flex; gap:8px; margin-top:var(--space-4);">
                <button class="dg-btn dg-btn-ghost" style="flex:1;" @onclick="DeclineMatchedLead">No, new customer</button>
                <button class="dg-btn dg-btn-primary" style="flex:1;" @onclick="ConvertMatchedLead">Yes, convert it</button>
            </div>
        </div>
    }
    else if (_showPriceConfirm)
    {
        <div class="dg-card" style="text-align:center;">
            <p style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; font-size:16px;">Confirm price awareness</p>
            <p style="color:#555;">Has the customer been told the price for this order?</p>
            <div style="display:flex; gap:8px; margin-top:var(--space-4);">
                <button class="dg-btn dg-btn-ghost" style="flex:1;" @onclick="() => _showPriceConfirm = false">Not yet</button>
                <button class="dg-btn dg-btn-primary" style="flex:1;" disabled="@_saving" @onclick="ConfirmAndSaveAsync">Yes, save</button>
            </div>
        </div>
    }
    else
    {
        <EditForm Model="this" OnValidSubmit="HandleSubmit" style="display:flex; flex-direction:column; flex:1;">
            @if (ReferenceDataClient.IsFromCache)
            {
                <p style="font-size:12px; color:#8a6d00; background:#fff8e1; border-radius:var(--radius-md); padding:8px 12px; margin-bottom:var(--space-3);">
                    Using options saved on this device@(ReferenceDataClient.CachedAtUtc is { } at ? $" on {at.ToLocalTime():d MMM, HH:mm}" : "") — reconnect to pick up any changes.
                </p>
            }

            @if (_summaryMessage is not null || _errors.Unattributed.Count > 0)
            {
                <div class="dg-form-error-summary" role="alert">
                    @if (_summaryMessage is not null)
                    {
                        <span>@_summaryMessage</span>
                    }
                    @if (_errors.Unattributed.Count > 0)
                    {
                        <ul>
                            @foreach (var message in _errors.Unattributed)
                            {
                                <li>@message</li>
                            }
                        </ul>
                    }
                </div>
            }

            <div class="dg-field">
                <label>Age</label>
                <input type="number" min="0" max="120" @bind="_age" />
                <FieldError Errors="_errors" For="AgeYears" />
            </div>
            <div class="dg-field">
                <label>Gender</label>
                <select @bind="_gender">
                    <option value="Female">Female</option>
                    <option value="Male">Male</option>
                </select>
            </div>

            <div class="dg-field">
                <label><input type="checkbox" @bind="_referredOrTreated" style="width:auto; margin-right:8px;" />Referred or treated</label>
            </div>
            @if (_referredOrTreated)
            {
                <ReferenceDataDropdown Label="Reason for referral/treatment" Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.ReferralReason)"
                                        SelectedId="_referralReasonRefId" SelectedIdChanged="v => _referralReasonRefId = v"
                                        OtherText="@_referralOtherText" OtherTextChanged="v => _referralOtherText = v"
                                        Errors="_errors" Field="ReferralReasonRefId" OtherField="ReferralOtherText" />
                <div class="dg-field">
                    <label><input type="checkbox" @bind="_treatedInFacility" style="width:auto; margin-right:8px;" />Treated in facility</label>
                </div>
                @if (!_treatedInFacility)
                {
                    <div class="dg-field">
                        <label>Referral location (hospital, clinic, etc.)</label>
                        <input @bind="_referralLocationFreeText" />
                        <FieldError Errors="_errors" For="ReferralLocationFreeText" />
                    </div>
                }
            }

            @if (IsTest)
            {
                <div class="dg-field">
                    <label>Outcome</label>
                    <select @bind="_testOutcome">
                        <option value="NoGlassesNeeded">No glasses needed</option>
                        <option value="NeedsGlasses">Needs glasses</option>
                    </select>
                    <FieldError Errors="_errors" For="Outcome" />
                </div>

                @if (_testOutcome == TestOutcome.NeedsGlasses)
                {
                    <ReferenceDataDropdown Label="Occupation (optional)" Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Occupation)"
                                            SelectedId="_occupationRefId" SelectedIdChanged="v => _occupationRefId = v"
                                            OtherText="@_occupationOtherText" OtherTextChanged="v => _occupationOtherText = v"
                                            Errors="_errors" Field="OccupationRefId" OtherField="OccupationOtherText" />

                    <LensRangeSelector Model="_lensRange" Catalogues="ReferenceDataClient.Catalogues"
                                       LensTypes="ReferenceDataClient.GetByCategory(ReferenceDataCategory.LensType)"
                                       AllowNoPreference="true" Errors="_errors" SelectionChanged="OnLensSelectionChanged" />

                    @if (_lensRange.LensRangeType is LensRangeType.SixLensSet or LensRangeType.NineLensSet && _lensRange.LensOptionLeftId is not null && AvailableCoatingIdsForSelectedPreset.Count > 0)
                    {
                        <ReferenceDataDropdown Label="Coating preference (optional)"
                                                Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Coating).Where(c => AvailableCoatingIdsForSelectedPreset.Contains(c.Id)).ToList()"
                                                SelectedId="_coatingPreferenceRefId" SelectedIdChanged="v => _coatingPreferenceRefId = v"
                                                Errors="_errors" Field="CoatingPreferenceRefId" />
                    }
                    @if (_lensRange.LensRangeType is not (LensRangeType.SixLensSet or LensRangeType.NineLensSet))
                    {
                        <ReferenceDataDropdown Label="Coating preference (optional)" Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Coating)"
                                                SelectedId="_coatingPreferenceRefId" SelectedIdChanged="v => _coatingPreferenceRefId = v"
                                                Errors="_errors" Field="CoatingPreferenceRefId" />
                    }

                    <div class="dg-field">
                        <label>Did the customer share contact details?</label>
                        <div style="display:flex; gap:8px;">
                            <button type="button" class="dg-btn dg-btn-ghost" style="flex:1;" @onclick="() => _contactShared = false">No</button>
                            <button type="button" class="dg-btn dg-btn-ghost" style="flex:1;" @onclick="() => _contactShared = true">Yes</button>
                        </div>
                        @if (_contactShared == true)
                        {
                            <button type="button" class="dg-btn dg-btn-primary" style="width:100%; margin-top:var(--space-3);" disabled="@_saving" @onclick="ContinueAsLeadAsync">Continue as Lead &rarr;</button>
                        }
                        else if (_contactShared == false)
                        {
                            <p style="font-size:12px; color:#888; margin-top:var(--space-2);">Recorded as a test only — not entered into the leads pipeline.</p>
                        }
                    </div>
                }
                else
                {
                    <ReferenceDataDropdown Label="Occupation (optional)" Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Occupation)"
                                            SelectedId="_occupationRefId" SelectedIdChanged="v => _occupationRefId = v"
                                            OtherText="@_occupationOtherText" OtherTextChanged="v => _occupationOtherText = v"
                                            Errors="_errors" Field="OccupationRefId" OtherField="OccupationOtherText" />
                }
            }
            else
            {
                <div class="dg-field">
                    <label>Full name</label>
                    <input @bind="_name" />
                    <FieldError Errors="_errors" For="FullName" />
                </div>
                <div class="dg-field">
                    <label>Phone number@(IsSale ? " (optional)" : "")</label>
                    <input @bind="_phone" />
                    <FieldError Errors="_errors" For="PhoneNumber" />
                </div>
                <ReferenceDataDropdown Label="Occupation (optional)" Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Occupation)"
                                        SelectedId="_occupationRefId" SelectedIdChanged="v => _occupationRefId = v"
                                        OtherText="@_occupationOtherText" OtherTextChanged="v => _occupationOtherText = v"
                                        Errors="_errors" Field="OccupationRefId" OtherField="OccupationOtherText" />
                <div class="dg-field">
                    <label><input type="checkbox" @bind="_consentGiven" style="width:auto; margin-right:8px;" />Customer consents to be contacted by Dot Glasses for follow-ups/marketing</label>
                </div>

                @if (IsSale)
                {
                    <LensRangeSelector Model="_lensRange" Catalogues="ReferenceDataClient.Catalogues"
                                       LensTypes="ReferenceDataClient.GetByCategory(ReferenceDataCategory.LensType)"
                                       AllowNoPreference="false" Errors="_errors" SelectionChanged="OnLensSelectionChanged" />

                    @if (_lensRange.LensRangeType is LensRangeType.SixLensSet or LensRangeType.NineLensSet && _lensRange.LensOptionLeftId is not null && AvailableCoatingIdsForSelectedPreset.Count > 0)
                    {
                        <CoatingMultiSelector Label="Coating" AllItems="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Coating)"
                                               RestrictToIds="AvailableCoatingIdsForSelectedPreset"
                                               SelectedIds="_coatingRefIds" SelectedIdsChanged="v => _coatingRefIds = v"
                                               Pairings="ReferenceDataClient.CoatingPairings" Exclusions="ReferenceDataClient.CoatingExclusions"
                                               Errors="_errors" Field="CoatingRefIds" />
                    }

                    @if (_lensRange.LensRangeType == LensRangeType.Custom)
                    {
                        <div class="dg-field">
                            <label><input type="checkbox" @bind="_orderFromDotGlasses" style="width:auto; margin-right:8px;" />Order this lens from Dot Glasses (outlet doesn't have stock)</label>
                        </div>
                        <CoatingMultiSelector Label="Coating" AllItems="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Coating)"
                                               SelectedIds="_coatingRefIds" SelectedIdsChanged="v => _coatingRefIds = v"
                                               Pairings="ReferenceDataClient.CoatingPairings" Exclusions="ReferenceDataClient.CoatingExclusions"
                                               Errors="_errors" Field="CoatingRefIds" />
                    }

                    @RenderFrameSwatches()

                    <div class="dg-field">
                        <label style="display:flex; align-items:center; justify-content:space-between; gap:8px;">Did this person buy a hard case? (click for yes)<input type="checkbox" @bind="_hardCaseSold" style="width:auto; flex:none;" /></label>
                    </div>
                    @if (_hardCaseSold)
                    {
                        <ReferenceDataDropdown Label="Hard case colour" Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.HardCaseColour)"
                                                SelectedId="_hardCaseColourRefId" SelectedIdChanged="v => _hardCaseColourRefId = v"
                                                OtherText="@_hardCaseOtherColourText" OtherTextChanged="v => _hardCaseOtherColourText = v"
                                                Errors="_errors" Field="HardCaseColourRefId" OtherField="HardCaseOtherColourText" />
                    }
                }
                else
                {
                    <ReferenceDataDropdown Label="Reason not purchased" Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.ReasonNotPurchased)"
                                            SelectedId="_reasonNotPurchasedRefId" SelectedIdChanged="v => _reasonNotPurchasedRefId = v"
                                            OtherText="@_reasonNotPurchasedOtherText" OtherTextChanged="v => _reasonNotPurchasedOtherText = v"
                                            Errors="_errors" Field="ReasonNotPurchasedRefId" OtherField="ReasonNotPurchasedOtherText" />

                    <LensRangeSelector Model="_lensRange" Catalogues="ReferenceDataClient.Catalogues"
                                       LensTypes="ReferenceDataClient.GetByCategory(ReferenceDataCategory.LensType)"
                                       AllowNoPreference="true" Errors="_errors" SelectionChanged="OnLensSelectionChanged" />

                    @if (_lensRange.LensRangeType is LensRangeType.SixLensSet or LensRangeType.NineLensSet && _lensRange.LensOptionLeftId is not null && AvailableCoatingIdsForSelectedPreset.Count > 0)
                    {
                        <ReferenceDataDropdown Label="Coating preference (optional)"
                                                Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Coating).Where(c => AvailableCoatingIdsForSelectedPreset.Contains(c.Id)).ToList()"
                                                SelectedId="_coatingPreferenceRefId" SelectedIdChanged="v => _coatingPreferenceRefId = v"
                                                Errors="_errors" Field="CoatingPreferenceRefId" />
                    }
                    @if (_lensRange.LensRangeType is not (LensRangeType.SixLensSet or LensRangeType.NineLensSet))
                    {
                        <ReferenceDataDropdown Label="Coating preference (optional)" Items="ReferenceDataClient.GetByCategory(ReferenceDataCategory.Coating)"
                                                SelectedId="_coatingPreferenceRefId" SelectedIdChanged="v => _coatingPreferenceRefId = v"
                                                Errors="_errors" Field="CoatingPreferenceRefId" />
                    }
                }
            }

            @if (!(IsTest && _testOutcome == TestOutcome.NeedsGlasses && _contactShared == true))
            {
                <div style="margin-top:auto; display:flex; gap:8px; padding-top:var(--space-4);">
                    <a class="dg-btn dg-btn-ghost" style="flex:1; text-align:center;" href="/">Cancel</a>
                    <button type="submit" class="dg-btn dg-btn-primary" style="flex:1;" disabled="@_saving">@(IsTest ? "Save test" : "Save")</button>
                </div>
            }
        </EditForm>
    }
</div>

@code {
    [Parameter] public string Type { get; set; } = "test";
    [Parameter, SupplyParameterFromQuery] public Guid? SourceTestId { get; set; }

    /// <summary>Set when this Sale form was opened from the Leads worklist to convert an open
    /// Lead — see Leads.razor. Prefills name/phone/prescription/preference from the Lead, and is
    /// submitted back as CreateSaleRequest.SourceLeadId so the server links them atomically.</summary>
    [Parameter, SupplyParameterFromQuery] public Guid? SourceLeadId { get; set; }

    [Parameter, SupplyParameterFromQuery] public int? PrefillAge { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? PrefillGender { get; set; }

    /// <summary>Set when this form was opened to correct a permanently-failed outbox record —
    /// see FailedRecords.razor. The corrected payload is re-queued under the same Id so the
    /// server's idempotent upsert still applies.</summary>
    [Parameter, SupplyParameterFromQuery] public Guid? FixOutboxId { get; set; }

    private bool IsTest => Type.Equals("test", StringComparison.OrdinalIgnoreCase);
    private bool IsSale => Type.Equals("sale", StringComparison.OrdinalIgnoreCase);

    private int? _age;
    private Gender _gender = Gender.Female;
    private Guid? _occupationRefId;
    private string? _occupationOtherText;
    private bool _saving;
    private bool _showPriceConfirm;

    // Automatic conversion-match prompt (Sale only, and only when not already converting a
    // specific Lead via SourceLeadId) — see HandleSubmit.
    private bool _showLeadMatchConfirm;
    private LeadDto? _leadMatch;
    private bool _leadMatchChecked;

    private readonly FormErrors _errors = new();
    private string? _summaryMessage;

    // Test-only
    private TestOutcome _testOutcome = TestOutcome.NoGlassesNeeded;
    private bool? _contactShared;

    // "Referred or treated" — shared across all three (Test/Lead/Sale), unconditional on outcome.
    private bool _referredOrTreated;
    private Guid? _referralReasonRefId;
    private string? _referralOtherText;
    private string? _referralLocationFreeText;
    private bool _treatedInFacility;

    // Lead/Sale shared
    private string _name = string.Empty;
    private string _phone = string.Empty;
    private bool _consentGiven;
    private readonly LensRangeSelection _lensRange = new();

    // Lead-only
    private Guid? _reasonNotPurchasedRefId;
    private string? _reasonNotPurchasedOtherText;

    // Custom-range coating preference — shared between Test (NeedsGlasses) and Lead, both of
    // which treat coating as optional (unlike Sale, which requires it).
    private Guid? _coatingPreferenceRefId;

    // Sale-only
    private Guid? _frameColourRefId;
    private string? _frameColourOtherText;
    private FrameCoverage _frameCoverage = FrameCoverage.FullFrame;
    private List<Guid> _coatingRefIds = [];
    private bool _orderFromDotGlasses;
    private bool _hardCaseSold;
    private Guid? _hardCaseColourRefId;
    private string? _hardCaseOtherColourText;

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    // Which server error keys this form has a control for. Anything outside these lands in the
    // summary band instead of being silently dropped — see FormErrors.Merge.
    private static readonly string[] TestFields =
        ["AgeYears", "Gender", "OccupationRefId", "OccupationOtherText", "Outcome",
         "ReferredOrTreated", "ReferralReasonRefId", "ReferralOtherText", "ReferralLocationFreeText", "TreatedInFacility"];

    private static readonly string[] LensFields =
        ["LensRangeType", "PresetCatalogueId", "LensOptionLeftId", "LensOptionRightId", "CustomSphereLeft", "CustomSphereRight",
         "CustomCylinderLeft", "CustomCylinderRight", "CustomAxisLeft", "CustomAxisRight", "CustomAddPowerLeft", "CustomAddPowerRight",
         "LensTypeRefId", "LensTypeOtherText", "PupilDistanceMm", "PresetPupilDistanceBucket"];

    private static readonly string[] LeadFields =
        [.. TestFields, .. LensFields, "FullName", "PhoneNumber", "ReasonNotPurchasedRefId", "ReasonNotPurchasedOtherText", "CoatingPreferenceRefId"];

    // HardCaseSold and OrderFromDotGlasses each own a checkbox on this form, so a failure keyed to
    // either belongs against that checkbox rather than in the summary band. Both rules are
    // unreachable today only because BuildSaleRequest defensively nulls their dependent fields —
    // exactly the hand-coordination this ticket removes elsewhere, so don't rely on it here.
    // FrameCoverage and Id are deliberately absent: neither has a control (frame coverage is
    // pinned to FullFrame, Id is a generated key), so their failures are genuinely unattributable.
    private static readonly string[] SaleFields =
        [.. TestFields, .. LensFields, "FullName", "PhoneNumber", "CoatingRefIds", "FrameColourRefId", "FrameColourOtherText",
         "HardCaseSold", "HardCaseColourRefId", "HardCaseOtherColourText", "OrderFromDotGlasses"];

    private string[] KnownFields => IsTest ? [.. TestFields, .. LensFields] : IsSale ? SaleFields : LeadFields;

    /// <summary>Rebuilt per check rather than cached at init: the technician can Retry a
    /// reference-data fetch mid-form, and a snapshot pinned at OnInitializedAsync would then be
    /// answering from data the dropdowns no longer show. It is an in-memory projection over lists
    /// this device already holds — no I/O, and Validate() runs only on a save.</summary>
    private ReferenceDataSnapshot Snapshot => ReferenceDataClient.ToSnapshot();

    protected override async Task OnInitializedAsync()
    {
        await ReferenceDataClient.EnsureLoadedAsync();

        if (FixOutboxId is { } fixId)
        {
            await LoadFailedRecordAsync(fixId);
            return;
        }

        if (SourceLeadId is { } leadId)
        {
            await LoadFromLeadAsync(leadId);
        }

        if (PrefillAge is { } age)
        {
            _age = age;
        }

        if (PrefillGender is not null && Enum.TryParse<Gender>(PrefillGender, out var gender))
        {
            _gender = gender;
        }
    }

    /// <summary>
    /// Prefills a Sale from an open Lead's already-captured details when converting from the
    /// Leads worklist. Frame colour, coating (for a Custom range), and hard case are deliberately
    /// left for the technician to fill in as normal — Lead never captures them (they're genuinely
    /// new decisions made at the point of sale, not something a Lead could have recorded).
    /// </summary>
    private async Task LoadFromLeadAsync(Guid leadId)
    {
        var lead = await LeadsClient.GetByIdAsync(leadId);
        if (lead is null)
        {
            _summaryMessage = "That lead couldn't be loaded — it may already have been converted or removed.";
            return;
        }

        // What a Lead contributes is SaleAssembly.Seed's to decide, shared with the Admin Portal's
        // conversion screen. Applied into the controls rather than over the request, which is what
        // keeps the technician's edits — and the automatic conversion-match path, where the Lead is
        // only found after the form is filled in — working; see Seed.
        var seeded = SaleAssembly.Seed(lead);

        _name = seeded.FullName;
        _phone = seeded.PhoneNumber ?? string.Empty;
        _age = seeded.AgeYears;
        _gender = seeded.Gender;
        _occupationRefId = seeded.OccupationRefId;
        _occupationOtherText = seeded.OccupationOtherText;
        _consentGiven = seeded.ConsentGiven;
        _coatingRefIds = seeded.CoatingRefIds;
        ApplyLensRange(seeded.LensRangeType, seeded.PresetCatalogueId, seeded.LensOptionLeftId, seeded.LensOptionRightId,
            seeded.CustomSphereLeft, seeded.CustomCylinderLeft, seeded.CustomAxisLeft, seeded.CustomAddPowerLeft,
            seeded.CustomSphereRight, seeded.CustomCylinderRight, seeded.CustomAxisRight, seeded.CustomAddPowerRight,
            seeded.PupilDistanceMm, seeded.PresetPupilDistanceBucket, seeded.ChildrensFrame);
    }

    /// <summary>
    /// Rehydrates the form from a permanently-failed outbox item so the technician corrects what
    /// they originally typed instead of re-entering the whole consultation. The stored payload is
    /// the exact request that was rejected, so replaying it into the same controls is lossless.
    /// </summary>
    private async Task LoadFailedRecordAsync(Guid outboxId)
    {
        var item = await OutboxStore.GetByIdAsync(outboxId);
        if (item is null)
        {
            _summaryMessage = "That record is no longer in the queue — it may already have been sent or discarded.";
            return;
        }

        _summaryMessage = item.LastError;

        switch (item.EntityType)
        {
            case "Test":
                if (JsonSerializer.Deserialize<CreateTestRequest>(item.PayloadJson, JsonOptions) is { } test)
                {
                    _age = test.AgeYears;
                    _gender = test.Gender;
                    _occupationRefId = test.OccupationRefId;
                    _occupationOtherText = test.OccupationOtherText;
                    _testOutcome = test.Outcome;
                    _referralReasonRefId = test.ReferralReasonRefId;
                    _referralOtherText = test.ReferralOtherText;
                    _referralLocationFreeText = test.ReferralLocationFreeText;
                }

                break;

            case "Lead":
                if (JsonSerializer.Deserialize<CreateLeadRequest>(item.PayloadJson, JsonOptions) is { } lead)
                {
                    _age = lead.AgeYears;
                    _gender = lead.Gender;
                    _occupationRefId = lead.OccupationRefId;
                    _occupationOtherText = lead.OccupationOtherText;
                    _name = lead.FullName;
                    _phone = lead.PhoneNumber;
                    _consentGiven = lead.ConsentGiven;
                    _reasonNotPurchasedRefId = lead.ReasonNotPurchasedRefId == Guid.Empty ? null : lead.ReasonNotPurchasedRefId;
                    _reasonNotPurchasedOtherText = lead.ReasonNotPurchasedOtherText;
                    _coatingPreferenceRefId = lead.CoatingPreferenceRefId;
                    SourceTestId = lead.SourceTestId;
                    ApplyLensRange(lead.LensRangeType, lead.PresetCatalogueId, lead.LensOptionLeftId, lead.LensOptionRightId,
                        lead.CustomSphereLeft, lead.CustomCylinderLeft, lead.CustomAxisLeft, lead.CustomAddPowerLeft,
                        lead.CustomSphereRight, lead.CustomCylinderRight, lead.CustomAxisRight, lead.CustomAddPowerRight,
                        lead.PupilDistanceMm, lead.PresetPupilDistanceBucket, lead.ChildrensFrame);
                }

                break;

            case "Sale":
                if (JsonSerializer.Deserialize<CreateSaleRequest>(item.PayloadJson, JsonOptions) is { } sale)
                {
                    _age = sale.AgeYears;
                    _gender = sale.Gender;
                    _occupationRefId = sale.OccupationRefId;
                    _occupationOtherText = sale.OccupationOtherText;
                    _name = sale.FullName;
                    _phone = sale.PhoneNumber ?? string.Empty;
                    _consentGiven = sale.ConsentGiven;
                    _orderFromDotGlasses = sale.OrderFromDotGlasses;
                    _frameColourRefId = sale.FrameColourRefId == Guid.Empty ? null : sale.FrameColourRefId;
                    _frameColourOtherText = sale.FrameColourOtherText;
                    _frameCoverage = sale.FrameCoverage;
                    _coatingRefIds = sale.CoatingRefIds.ToList();
                    _hardCaseSold = sale.HardCaseSold;
                    _hardCaseColourRefId = sale.HardCaseColourRefId;
                    _hardCaseOtherColourText = sale.HardCaseOtherColourText;
                    ApplyLensRange(sale.LensRangeType, sale.PresetCatalogueId, sale.LensOptionLeftId, sale.LensOptionRightId,
                        sale.CustomSphereLeft, sale.CustomCylinderLeft, sale.CustomAxisLeft, sale.CustomAddPowerLeft,
                        sale.CustomSphereRight, sale.CustomCylinderRight, sale.CustomAxisRight, sale.CustomAddPowerRight,
                        sale.PupilDistanceMm, sale.PresetPupilDistanceBucket, sale.ChildrensFrame);
                }

                break;
        }
    }

    private void ApplyLensRange(
        LensRangeType? rangeType, Guid? catalogueId, Guid? leftId, Guid? rightId,
        decimal? sphereLeft, decimal? cylinderLeft, decimal? axisLeft, decimal? addLeft,
        decimal? sphereRight, decimal? cylinderRight, decimal? axisRight, decimal? addRight,
        decimal? pupilDistanceMm, int? presetBucket, bool childrensFrame)
    {
        _lensRange.LensRangeType = rangeType;
        _lensRange.PresetCatalogueId = catalogueId;
        _lensRange.LensOptionLeftId = leftId;
        _lensRange.LensOptionRightId = rightId;
        _lensRange.CustomSphereLeft = sphereLeft;
        _lensRange.CustomCylinderLeft = cylinderLeft;
        _lensRange.CustomAxisLeft = axisLeft;
        _lensRange.CustomAddPowerLeft = addLeft;
        _lensRange.CustomSphereRight = sphereRight;
        _lensRange.CustomCylinderRight = cylinderRight;
        _lensRange.CustomAxisRight = axisRight;
        _lensRange.CustomAddPowerRight = addRight;
        _lensRange.PupilDistanceMm = pupilDistanceMm;
        _lensRange.PresetPupilDistanceBucket = presetBucket;
        _lensRange.ChildrensFrame = childrensFrame;
    }

    /// <summary>Coatings configured as available for the currently-chosen preset left-eye
    /// LensOption — mirrors the lookup LensRangeSelector used to do internally before coating
    /// moved out to the parent (see ADR-0001). Empty when no left lens is chosen yet, or the
    /// chosen lens has no coatings configured.</summary>
    private IReadOnlyList<Guid> AvailableCoatingIdsForSelectedPreset =>
        ReferenceDataClient.Catalogues
            .SelectMany(c => c.LensOptions)
            .FirstOrDefault(o => o.Id == _lensRange.LensOptionLeftId)?.AvailableCoatingIds ?? [];

    /// <summary>Fired by LensRangeSelector whenever the range type or left lens changes — any
    /// coating already picked may no longer be valid (a different lens option may not offer it,
    /// or Custom vs preset draws from a different set entirely), so both possible coating fields
    /// are cleared; only the one the current form actually renders has any visible effect.</summary>
    private void OnLensSelectionChanged()
    {
        _coatingRefIds = [];
        _coatingPreferenceRefId = null;
        StateHasChanged();
    }

    private async Task RetryReferenceDataAsync() => await ReferenceDataClient.RefreshAsync();

    /// <summary>Heuristic "has the technician started filling this in" check — not a field-by-field
    /// diff against a pristine snapshot, just the fields a technician would actually type or pick
    /// before abandoning the form. Drives the explicit back-navigation confirmation below so
    /// leaving a part-filled form is never silent data loss.</summary>
    private bool HasUnsavedData =>
        _age is not null || !string.IsNullOrWhiteSpace(_name) || !string.IsNullOrWhiteSpace(_phone)
        || _occupationRefId is not null || _consentGiven
        || (IsTest && _testOutcome != TestOutcome.NoGlassesNeeded) || _referredOrTreated
        || _reasonNotPurchasedRefId is not null || _coatingPreferenceRefId is not null
        || _frameColourRefId is not null || _coatingRefIds.Count > 0 || _hardCaseSold
        || _lensRange.LensOptionLeftId is not null || _lensRange.LensOptionRightId is not null
        || _lensRange.CustomSphereLeft is not null || _lensRange.CustomSphereRight is not null
        || _lensRange.PupilDistanceMm is not null || _lensRange.PresetPupilDistanceBucket is not null;

    /// <summary>Explicit in-app back control (see CLAUDE.md ticket 02) — steps back to Home via
    /// the app's own navigation rather than a bare history.back(), and warns before discarding a
    /// part-filled form instead of silently losing it. Purely additive: the phone's native back
    /// gesture/button is untouched by this.</summary>
    private async Task NavigateBackAsync()
    {
        if (HasUnsavedData && !await JS.InvokeAsync<bool>("confirm", "Discard this record? Anything entered so far will be lost."))
        {
            return;
        }

        Navigation.NavigateTo("/");
    }

    private async Task HandleSubmit()
    {
        // A technician who has indicated the customer shared contact details must continue as a
        // Lead — the Test entity has nowhere to store name/phone, so saving a plain Test here
        // would silently discard them. The submit button is hidden in this state, but this
        // backstops an Enter-key submit bypassing that. Deliberately not folded into Validate()/
        // ValidateTest(): ContinueAsLeadAsync calls Validate() too, and this check must NOT block
        // that path — only the plain-Test submit HandleSubmit itself drives.
        if (IsTest && _testOutcome == TestOutcome.NeedsGlasses && _contactShared == true)
        {
            _errors.Clear();
            _errors.Unattributed.Clear();
            _errors.Add("Outcome", "This customer shared contact details — continue as a Lead instead of saving a plain test.");
            _summaryMessage = "Please fix the highlighted fields before saving.";
            return;
        }

        if (!Validate())
        {
            return;
        }

        // Test saves immediately (per the design brief); Lead and Sale require the
        // price-awareness confirmation step first.
        if (IsTest)
        {
            await SaveTestAsync();
            return;
        }

        // A fresh Sale (not already converting a specific Lead) for a name+phone that matches an
        // open Lead offers to convert it instead of silently creating an unlinked duplicate —
        // checked once per form visit (_leadMatchChecked), so declining doesn't re-prompt on a
        // second submit attempt after fixing an unrelated validation error.
        if (IsSale && SourceLeadId is null && !_leadMatchChecked)
        {
            _leadMatch = await LeadsClient.FindOpenMatchAsync(_name, _phone);
            _leadMatchChecked = true;
            if (_leadMatch is not null)
            {
                _showLeadMatchConfirm = true;
                return;
            }
        }

        _showPriceConfirm = true;
    }

    private void ConvertMatchedLead()
    {
        SourceLeadId = _leadMatch?.Id;
        _showLeadMatchConfirm = false;
        _showPriceConfirm = true;
    }

    private void DeclineMatchedLead()
    {
        _showLeadMatchConfirm = false;
        _showPriceConfirm = true;
    }

    private async Task ConfirmAndSaveAsync()
    {
        if (IsSale)
        {
            await SaveSaleAsync();
        }
        else
        {
            await SaveLeadAsync();
        }
    }

    private async Task ContinueAsLeadAsync()
    {
        if (!Validate())
        {
            return;
        }

        var testId = await SaveTestCoreAsync();
        if (testId is null)
        {
            return;
        }

        var url = $"consultation/lead?sourceTestId={testId}&prefillGender={_gender}";
        if (_age is { } age)
        {
            url += $"&prefillAge={age}";
        }

        Navigation.NavigateTo(url);
    }

    // --- Validation ------------------------------------------------------------------------

    /// <summary>
    /// The whole pre-submit check: build the request this form would send, and hand it to the
    /// shared module — the same call the create endpoint makes (ADR-0002). The device and the
    /// server are no longer two implementations kept in step by hand, they are one, so a message
    /// shown here is character-for-character the one the server would have produced.
    ///
    /// It runs against the snapshot built from this device's own cached reference data, so it
    /// answers identically with no connectivity — which is the point: a technician offline for
    /// hours must not discover at sync time that a batch of records is bad.
    /// </summary>
    private bool Validate()
    {
        _errors.Clear();
        _errors.Unattributed.Clear();
        _summaryMessage = null;

        var result = IsTest
            ? ConsultationRules.Check(BuildTestRequest(), Snapshot)
            : IsSale
                ? ConsultationRules.Check(BuildSaleRequest(), Snapshot)
                : ConsultationRules.Check(BuildLeadRequest(), Snapshot);

        _errors.AddRuleFailures(result, KnownFields);

        if (_errors.Any || _errors.Unattributed.Count > 0)
        {
            _summaryMessage = "Please fix the highlighted fields before saving.";
        }

        return !_errors.Any && _errors.Unattributed.Count == 0;
    }

    // --- Request assembly ---------------------------------------------------------------------
    //
    // Built once here and used twice: Validate() checks the request that would actually be sent,
    // and the save path below queues it. Keeping assembly in one place per type is what makes
    // "validated" and "queued" the same object rather than two hand-matched projections of the
    // same fields — the drift this ticket exists to remove would otherwise just move here.
    //
    // That holds for the Sale only so far: SaveSaleAsync calls BuildSaleRequest, which goes through
    // the shared SaleAssembly the Admin Portal also assembles through. SaveTestCoreAsync and
    // SaveLeadAsync still build their own copy of what BuildTestRequest/BuildLeadRequest produce,
    // so those two are validated and queued as two hand-matched objects — the same drift, one
    // entity type down. Collapse them the same way when either next needs a field.

    /// <summary>A fresh idempotency key per save attempt, or the failed record's own when
    /// correcting one — the server's upsert keys on it. Never Guid.Empty, which is why the
    /// module's NotEmpty(Id) can't fire from this form.</summary>
    private Guid NewRecordId() => FixOutboxId ?? Guid.NewGuid();

    private CreateTestRequest BuildTestRequest()
    {
        // A Test that needs no glasses records no product preference at all — every lens field
        // must be empty, which the module checks explicitly (LensRangeType null branch).
        var needsGlasses = _testOutcome == TestOutcome.NeedsGlasses;

        return new CreateTestRequest
        {
            Id = NewRecordId(),
            AgeYears = _age,
            Gender = _gender,
            OccupationRefId = _occupationRefId,
            OccupationOtherText = _occupationOtherText,
            Outcome = _testOutcome,
            ReferredOrTreated = _referredOrTreated,
            ReferralReasonRefId = _referredOrTreated ? _referralReasonRefId : null,
            ReferralOtherText = _referredOrTreated ? _referralOtherText : null,
            ReferralLocationFreeText = _referredOrTreated && !_treatedInFacility ? _referralLocationFreeText : null,
            TreatedInFacility = _referredOrTreated && _treatedInFacility,
            LensRangeType = needsGlasses ? _lensRange.LensRangeType : null,
            PresetCatalogueId = needsGlasses ? _lensRange.PresetCatalogueId : null,
            LensOptionLeftId = needsGlasses ? _lensRange.LensOptionLeftId : null,
            LensOptionRightId = needsGlasses ? _lensRange.LensOptionRightId : null,
            CustomSphereLeft = needsGlasses ? _lensRange.CustomSphereLeft : null,
            CustomCylinderLeft = needsGlasses ? _lensRange.CustomCylinderLeft : null,
            CustomAxisLeft = needsGlasses ? _lensRange.CustomAxisLeft : null,
            CustomAddPowerLeft = needsGlasses ? _lensRange.CustomAddPowerLeft : null,
            CustomSphereRight = needsGlasses ? _lensRange.CustomSphereRight : null,
            CustomCylinderRight = needsGlasses ? _lensRange.CustomCylinderRight : null,
            CustomAxisRight = needsGlasses ? _lensRange.CustomAxisRight : null,
            CustomAddPowerRight = needsGlasses ? _lensRange.CustomAddPowerRight : null,
            LensTypeRefId = needsGlasses ? _lensRange.LensTypeRefId : null,
            LensTypeOtherText = needsGlasses ? _lensRange.LensTypeOtherText : null,
            PupilDistanceMm = needsGlasses ? _lensRange.PupilDistanceMm : null,
            PresetPupilDistanceBucket = needsGlasses ? _lensRange.PresetPupilDistanceBucket : null,
            ChildrensFrame = needsGlasses && _lensRange.ChildrensFrame,
            CoatingPreferenceRefId = needsGlasses ? _coatingPreferenceRefId : null,
