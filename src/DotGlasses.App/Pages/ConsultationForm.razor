    /// <summary>The note left behind when a lens change unticked a coating (or cleared the coating
    /// preference) the new lens no longer offers, so nothing surprises the technician at save time.</summary>
    private RenderFragment RenderCoatingRemovedNote() => @<text>
                                                              @if (_coatingRemovedNote is not null)
                                                              {
                                                                  <p class="dg-lens-note"
                                                                     role="status">@_coatingRemovedNote</p>
                                                              }
                                                          </text>;

    /// <summary>Set when a lens change removes coatings the technician had ticked; replaced by the
    /// next lens change (null when that one removes nothing).</summary>
    private string? _coatingRemovedNote;

    /// <summary>Fired by LensRangeSelector whenever the range type or either lens changes — the
    /// coatings on offer are the ones both chosen lenses come in, so a pick may no longer be valid.
    /// Ticks the new pair still offers are kept; the rest are unticked with a note.</summary>
    private void OnLensSelectionChanged()
    {
        ReconcileCoatings();

        // A coating the new lens doesn't offer was just unticked, so a message about it is moot.
        if (_coatingRemovedNote is not null)
        {
            ClearErrors("CoatingRefIds", "CoatingPreferenceRefId");
        }

        StateHasChanged();
    }

    /// <summary>
    /// Brings the coating selection and the coating preference in line with what the lens choice
    /// offers: still-offered ticks stay, removed ones are unticked and named in a note, and the
    /// paired coating of every ticked trigger is ticked (a Lead's preference that is a trigger comes
    /// across with its pair). Custom (and no range) offers every active coating. A lens set whose
    /// pair isn't complete yet offers nothing to compare against, so the selection is left alone
    /// until both eyes have a lens — a mid-change state (the right eye emptied by a left lens of
    /// another type) shouldn't wipe the technician's ticks — and reconciled the moment it completes.
    /// </summary>
    private void ReconcileCoatings()
    {
        IReadOnlyCollection<Guid> offered;
        IReadOnlyList<CoatingPairingRule> pairings;

        if (_lensRange.LensRangeType is LensRangeType.LensSet)
        {
            if (PairCoatings is not { } pair)
            {
                return;
            }

            offered = pair.Offered;
            pairings = pair.RequiredPairings;
        }
        else
        {
            offered = ReferenceDataClient.GetByCategory(ReferenceDataCategory.Coating).Select(c => c.Id).ToList();
            pairings = [];
        }

        var reconciled = CoatingSelection.Reconcile(_coatingRefIds, offered, pairings);
        _coatingRefIds = reconciled.Selected;

        if (_coatingPreferenceRefId is { } preference && !offered.Contains(preference))
        {
            reconciled.Removed.Add(preference);
            _coatingPreferenceRefId = null;
        }

        if (reconciled.Removed.Count == 0)
        {
            _coatingRemovedNote = null;
            return;
        }

        var coatings = ReferenceDataClient.GetByCategory(ReferenceDataCategory.Coating);
        var names = reconciled.Removed.Select(id => coatings.FirstOrDefault(c => c.Id == id)?.Label ?? "A coating");
        _coatingRemovedNote = $"Removed {string.Join(", ", names)} — not available on the lens you've now chosen.";
    }

    /// <summary>Adult and children's frames come in different colours, so a colour chosen for
    /// one is not a colour for the other: changing the tick clears the choice and its "Other"
    /// text rather than saving a colour from the wrong list.</summary>
    private void OnChildrensFrameChanged()
    {
        _frameColourRefId = null;
        _frameColourOtherText = null;
        ClearErrors(FrameColourFields);
        StateHasChanged();
    }

    private async Task RetryReferenceDataAsync() => await ReferenceDataClient.RefreshAsync();

    /// <summary>Heuristic "has the technician started filling this in" check — not a field-by-field
    /// diff against a pristine snapshot, just the fields a technician would actually type or pick
    /// before abandoning the form. Drives the explicit back-navigation confirmation below so
    /// leaving a part-filled form is never silent data loss.</summary>
    private bool HasUnsavedData =>
        _age is not null || !string.IsNullOrWhiteSpace(_name) || !string.IsNullOrWhiteSpace(_phone)
        || _occupationRefId is not null || _consentGiven
        || (IsTest && _testOutcome != TestOutcome.NoGlassesNeeded) || _referredOrTreated
        || _reasonNotPurchasedRefId is not null || _customerToldPrice is not null || _coatingPreferenceRefId is not null
        || _frameColourRefId is not null || _coatingRefIds.Count > 0 || _hardCaseSold
        || _lensRange.LensLeftId is not null || _lensRange.LensRightId is not null
        || _lensRange.SphereLeft is not null || _lensRange.SphereRight is not null
        || _lensRange.PupilDistanceMm is not null || _lensRange.PresetPupilDistanceBucket is not null;

    /// <summary>Explicit in-app back control (see CLAUDE.md ticket 02) — steps back to Home via
    /// the app's own navigation rather than a bare history.back(), and warns before discarding a
    /// part-filled form instead of silently losing it. Purely additive: the phone's native back
    /// gesture/button is untouched by this.</summary>
    private async Task NavigateBackAsync()
    {
        if (HasUnsavedData && !await JS.InvokeAsync<bool>("confirm", "Discard this record? Anything entered so far will be lost."))
        {
            return;
        }

        Navigation.NavigateTo("/");
    }

    private async Task HandleSubmit()
    {
        // A technician who has indicated the customer shared contact details must continue as a
        // Lead — the Test entity has nowhere to store name/phone, so saving a plain Test here
        // would silently discard them. The submit button is hidden in this state, but this
        // backstops an Enter-key submit bypassing that. Deliberately not folded into Validate()/
        // ValidateTest(): ContinueAsLeadAsync calls Validate() too, and this check must NOT block
        // that path — only the plain-Test submit HandleSubmit itself drives.
        if (IsTest && _testOutcome == TestOutcome.NeedsGlasses && _contactShared == true)
        {
            _errors.Clear();
            _errors.Unattributed.Clear();
            _errors.Add("Outcome", "This customer shared contact details — continue as a Lead instead of saving a plain test.");
            _summaryMessage = "Fix the highlighted fields, then save.";
            _summaryFollowsFieldErrors = true;
            return;
        }

        if (!Validate())
        {
            return;
        }

        if (IsTest)
        {
            await SaveTestAsync();
            return;
        }

        // A fresh Sale (not already converting a specific Lead) for a name+phone that matches an
        // open Lead offers to convert it instead of silently creating an unlinked duplicate —
        // checked once per form visit (_leadMatchChecked), so declining doesn't re-prompt on a
        // second submit attempt after fixing an unrelated validation error.
        if (IsSale && SourceLeadId is null && !_leadMatchChecked)
        {
            _leadMatch = await LeadsClient.FindOpenMatchAsync(_name, _phone);
            _leadMatchChecked = true;
            if (_leadMatch is not null)
            {
                _showLeadMatchConfirm = true;
                return;
            }
        }

        await SaveLeadOrSaleAsync();
    }

    // The match prompt is the only step between Save and saving: either answer saves the Sale
    // that was already checked.
    private async Task ConvertMatchedLead()
    {
        SourceLeadId = _leadMatch?.Id;
        _showLeadMatchConfirm = false;
        await SaveLeadOrSaleAsync();
    }

    private async Task DeclineMatchedLead()
    {
        _showLeadMatchConfirm = false;
        await SaveLeadOrSaleAsync();
    }

    private async Task SaveLeadOrSaleAsync()
    {
        if (IsSale)
        {
            await SaveSaleAsync();
        }
        else
        {
            await SaveLeadAsync();
        }
    }

    private async Task ContinueAsLeadAsync()
    {
        if (!Validate())
        {
            return;
        }

        var testId = await SaveTestCoreAsync();
        if (testId is null)
        {
            return;
        }

        var url = Navigation.GetUriWithQueryParameters(
            Navigation.ToAbsoluteUri("consultation/lead").ToString(),
            new Dictionary<string, object?>
            {
                ["sourceTestId"] = testId,
                ["prefillGender"] = _gender.ToString(),
                ["prefillAge"] = _age,
                ["prefillReferred"] = _referredOrTreated ? true : null,
                ["prefillReferralReason"] = _referredOrTreated ? _referralReasonRefId : null,
                ["prefillReferralOther"] = _referredOrTreated ? _referralOtherText : null,
                ["prefillTreatedInFacility"] = _referredOrTreated && _treatedInFacility ? true : null,
                ["prefillReferralLocation"] = _referredOrTreated && !_treatedInFacility ? _referralLocationFreeText : null,
            });

        Navigation.NavigateTo(url);
    }

    // --- Validation ------------------------------------------------------------------------

    /// <summary>
    /// The whole pre-submit check: build the request this form would send, and hand it to the
    /// shared module — the same call the create endpoint makes (ADR-0002). The device and the
    /// server are no longer two implementations kept in step by hand, they are one, so a message
    /// shown here is character-for-character the one the server would have produced.
    ///
    /// It runs against the snapshot built from this device's own cached reference data, so it
    /// answers identically with no connectivity — which is the point: a technician offline for
    /// hours must not discover at sync time that a batch of records is bad.
    /// </summary>
    private bool Validate()
    {
        _errors.Clear();
        _errors.Unattributed.Clear();
        _summaryMessage = null;
        _summaryFollowsFieldErrors = false;

        // A Sale has no default lens range (ADR-0005) — the same rule the Admin Portal's conversion
        // asks through. FormErrors keeps the first message per field, so this one wins over the
        // rules' Custom-prescription failure that an unmade choice would otherwise produce below.
        if (IsSale && SaleAssembly.LensRangeNotChosen(BuildSaleAnswers()) is { } notChosen)
        {
            _errors.Add(notChosen.Key, notChosen.Message);
        }

        var result = IsTest
            ? ConsultationRules.Check(BuildTestRequest(), Snapshot)
            : IsSale
                ? CheckSale()
                : ConsultationRules.Check(BuildLeadRequest(), Snapshot);

        _errors.AddRuleFailures(result, KnownFields);

        if (_errors.Any || _errors.Unattributed.Count > 0)
        {
            _summaryMessage = "Fix the highlighted fields, then save.";
            _summaryFollowsFieldErrors = true;
        }

        return !_errors.Any && _errors.Unattributed.Count == 0;
    }

    // --- Request assembly ---------------------------------------------------------------------
    //
    // Built once here and used twice: Validate() checks the request that would actually be sent,
    // and the save path below queues it. Keeping assembly in one place per type is what makes
    // "validated" and "queued" the same object rather than two hand-matched projections of the
    // same fields — the drift this ticket exists to remove would otherwise just move here.
    //
    // All three save paths go through the Build* method Validate() checked, so "would the server
    // refuse this" and "what gets queued" are the same object rather than two hand-matched
    // projections. The Sale's assembly lives in the shared SaleAssembly the Admin Portal also
    // builds through; Test and Lead have only the one write path each, so theirs stay here.

    /// <summary>A fresh idempotency key per save attempt, or the failed record's own when
    /// correcting one — the server's upsert keys on it. Never Guid.Empty, which is why the
    /// module's NotEmpty(Id) can't fire from this form.</summary>
    private Guid NewRecordId() => FixOutboxId ?? Guid.NewGuid();

    private CreateTestRequest BuildTestRequest()
    {
        // A Test that needs no glasses records no product preference at all — every lens field
        // must be empty, which the module checks explicitly (LensRangeType null branch).
        var needsGlasses = _testOutcome == TestOutcome.NeedsGlasses;

        return new CreateTestRequest
        {
            Id = NewRecordId(),
            AgeYears = _age,
            Gender = _gender,
            OccupationRefId = _occupationRefId,
            OccupationOtherText = _occupationOtherText,
            Outcome = _testOutcome,
            ReferredOrTreated = _referredOrTreated,
            ReferralReasonRefId = _referredOrTreated ? _referralReasonRefId : null,
            ReferralOtherText = _referredOrTreated ? _referralOtherText : null,
            ReferralLocationFreeText = _referredOrTreated && !_treatedInFacility ? BlankToNull(_referralLocationFreeText) : null,
            TreatedInFacility = _referredOrTreated && _treatedInFacility,
            LensRangeType = needsGlasses ? _lensRange.LensRangeType : null,
            PresetCatalogueId = needsGlasses ? _lensRange.PresetCatalogueId : null,
            SphereLeft = needsGlasses ? _lensRange.SphereLeft : null,
            CylinderLeft = needsGlasses ? _lensRange.CylinderLeft : null,
            AxisLeft = needsGlasses ? _lensRange.AxisLeft : null,
            AddLeft = needsGlasses ? _lensRange.AddLeft : null,
            SphereRight = needsGlasses ? _lensRange.SphereRight : null,
            CylinderRight = needsGlasses ? _lensRange.CylinderRight : null,
            AxisRight = needsGlasses ? _lensRange.AxisRight : null,
            AddRight = needsGlasses ? _lensRange.AddRight : null,
            LensTypeRefId = needsGlasses ? _lensRange.LensTypeRefId : null,
            LensTypeOtherText = needsGlasses ? _lensRange.LensTypeOtherText : null,
            PupilDistanceMm = needsGlasses ? _lensRange.PupilDistanceMm : null,
            PresetPupilDistanceBucket = needsGlasses ? _lensRange.PresetPupilDistanceBucket : null,
            ChildrensFrame = needsGlasses && _lensRange.ChildrensFrame,
            CoatingPreferenceRefId = needsGlasses ? _coatingPreferenceRefId : null,
        };
    }

    /// <summary>The referral location is optional: a box typed in and emptied again is no
    /// location, not an empty one.</summary>
    private static string? BlankToNull(string? text) => string.IsNullOrWhiteSpace(text) ? null : text;

    private CreateLeadRequest BuildLeadRequest() => new()
    {
        Id = NewRecordId(),
        SourceTestId = SourceTestId,
        FullName = _name,
        PhoneNumber = _phone,
        AgeYears = _age,
        Gender = _gender,
        OccupationRefId = _occupationRefId,
        OccupationOtherText = _occupationOtherText,
        ConsentGiven = _consentGiven,
        ReferredOrTreated = _referredOrTreated,
        ReferralReasonRefId = _referredOrTreated ? _referralReasonRefId : null,
        ReferralOtherText = _referredOrTreated ? _referralOtherText : null,
        ReferralLocationFreeText = _referredOrTreated && !_treatedInFacility ? BlankToNull(_referralLocationFreeText) : null,
        TreatedInFacility = _referredOrTreated && _treatedInFacility,
        ReasonNotPurchasedRefId = _reasonNotPurchasedRefId ?? Guid.Empty,
        ReasonNotPurchasedOtherText = _reasonNotPurchasedOtherText,
        CustomerToldPrice = _customerToldPrice,
        LensRangeType = _lensRange.LensRangeType,
        PresetCatalogueId = _lensRange.PresetCatalogueId,
        SphereLeft = _lensRange.SphereLeft,
        CylinderLeft = _lensRange.CylinderLeft,
        AxisLeft = _lensRange.AxisLeft,
        AddLeft = _lensRange.AddLeft,
        SphereRight = _lensRange.SphereRight,
        CylinderRight = _lensRange.CylinderRight,
        AxisRight = _lensRange.AxisRight,
        AddRight = _lensRange.AddRight,
        LensTypeRefId = _lensRange.LensTypeRefId,
        LensTypeOtherText = _lensRange.LensTypeOtherText,
        PupilDistanceMm = _lensRange.PupilDistanceMm,
        PresetPupilDistanceBucket = _lensRange.PresetPupilDistanceBucket,
        ChildrensFrame = _lensRange.ChildrensFrame,
        // An ordering Lead sends the Coating set its lens is made with and no preference; any
        // other Lead sends its one optional preference and no set. Whichever control is hidden
        // contributes nothing, so a value left in it can't become an error nobody can see.
        CoatingPreferenceRefId = LeadOrdersLens ? null : _coatingPreferenceRefId,
        OrderFromDotGlasses = LeadOrdersLens,
        CoatingRefIds = LeadOrdersLens ? _coatingRefIds.ToList() : [],
    };

    /// <summary>
    /// This form's answers, handed to the shared builder — the same one the Admin Portal's
    /// conversion screen assembles through, so a field added to CreateSaleRequest cannot reach one
    /// write path and miss the other. The conditional blanking (referral, hard case) and the
    /// absence encodings live in SaleAssembly.Build; what stays here is only what is genuinely this
    /// form's own — which controls it is currently rendering.
    ///
    /// SourceLeadId is passed rather than re-seeded from the Lead: on the conversion-match path it
    /// is only set at submit time, after these answers were typed, and re-applying the Lead then
    /// would overwrite them (see SaleAssembly.Seed).
    /// </summary>
    private CreateSaleRequest BuildSaleRequest() => SaleAssembly.Build(NewRecordId(), SourceLeadId, BuildSaleAnswers());

    /// <summary>The Sale rules, and for a Lead whose lens is already ordered the lock over them
    /// (ADR-0008) — the same two calls the server makes, so an ordered lens whose coating has
    /// since been retired is accepted here exactly as it is there.</summary>
    private RuleResult CheckSale()
    {
        var request = BuildSaleRequest();
        var rules = ConsultationRules.Check(request, Snapshot);
        return _orderedLead is null ? rules : OrderedLeadConversion.Over(rules, request, _orderedLead);
    }

    private SaleAnswers BuildSaleAnswers() => new SaleAnswers
    {
        FullName = _name,
        PhoneNumber = _phone,
        AgeYears = _age,
        Gender = _gender,
        OccupationRefId = _occupationRefId,
        OccupationOtherText = _occupationOtherText,
        ConsentGiven = _consentGiven,
        ReferredOrTreated = _referredOrTreated,
        ReferralReasonRefId = _referralReasonRefId,
        ReferralOtherText = _referralOtherText,
        ReferralLocationFreeText = BlankToNull(_referralLocationFreeText),
        TreatedInFacility = _treatedInFacility,
        // Suppressed here, not in the builder: this form hides the checkbox outside a Custom range,
        // so a value left over from an earlier Custom selection would otherwise become an error
        // against a control the technician can no longer see or clear. The Admin Portal renders it
        // unconditionally and needs the opposite — see SaleAnswers.OrderFromDotGlasses.
        // And never for a Lead that already ordered: its Sale shares that order.
        OrderFromDotGlasses = _orderedLead is null && _lensRange.LensRangeType == LensRangeType.Custom && _orderFromDotGlasses,
        FrameColourRefId = _frameColourRefId,
        FrameColourOtherText = _frameColourOtherText,
        FrameCoverage = _frameCoverage,
        CoatingRefIds = _coatingRefIds,
        HardCaseSold = _hardCaseSold,
        HardCaseColourRefId = _hardCaseColourRefId,
        HardCaseOtherColourText = _hardCaseOtherColourText,
    }.WithLens(
        _lensRange.LensRangeType, _lensRange.PresetCatalogueId,
        _lensRange.SphereLeft, _lensRange.CylinderLeft, _lensRange.AxisLeft, _lensRange.AddLeft,
        _lensRange.SphereRight, _lensRange.CylinderRight, _lensRange.AxisRight, _lensRange.AddRight,
        _lensRange.LensTypeRefId, _lensRange.LensTypeOtherText,
        _lensRange.PupilDistanceMm, _lensRange.PresetPupilDistanceBucket, _lensRange.ChildrensFrame);

    // --- Saving ----------------------------------------------------------------------------

    private async Task SaveTestAsync()
    {
        var testId = await SaveTestCoreAsync();
        if (testId is not null)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task<Guid?> SaveTestCoreAsync()
    {
        var request = BuildTestRequest();

        return await SubmitAsync(request.Id, "Test", "api/v1/tests", request) ? request.Id : null;
    }

    private async Task SaveLeadAsync()
    {
        var request = BuildLeadRequest();

        if (await SubmitAsync(request.Id, "Lead", "api/v1/leads", request))
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task SaveSaleAsync()
    {
        // The same assembly Validate() checked, not a second hand-matched copy of it — what the
        // pre-submit check passed is exactly what gets queued.
        var request = BuildSaleRequest();

        if (await SubmitAsync(request.Id, "Sale", "api/v1/sales", request))
        {
            Navigation.NavigateTo("/");
        }
    }

    /// <summary>
    /// Queues the record and attempts one immediate push. Returns true when the technician can
    /// move on — either the server accepted it, or we're offline and it is safely queued for
    /// later. Returns false only when the server actively rejected it, in which case the errors
    /// are rendered against the fields and the form stays open with everything still filled in.
    /// </summary>
    private async Task<bool> SubmitAsync<TRequest>(Guid id, string entityType, string apiRoute, TRequest request)
    {
        _saving = true;
        try
        {
            var payloadJson = JsonSerializer.Serialize(request, JsonOptions);

            if (FixOutboxId is not null)
            {
                await OutboxStore.RequeueAsync(id, payloadJson);
            }
            else
            {
                await OutboxStore.EnqueueAsync(new OutboxItem
                {
                    Id = id,
                    EntityType = entityType,
                    ApiRoute = apiRoute,
                    PayloadJson = payloadJson,
                });
            }

            var item = new OutboxItem { Id = id, EntityType = entityType, ApiRoute = apiRoute, PayloadJson = payloadJson };
            var result = await SyncService.TrySyncItemAsync(item);

            if (result.Outcome != SyncAttemptOutcome.Rejected)
            {
                return true;
            }

            _summaryMessage = result.Message ?? "The server rejected this record.";
            if (result.FieldErrors is not null)
            {
                _errors.Merge(result.FieldErrors, KnownFields);

                // A whole-record ("") rejection lands in _errors.Unattributed too (FormErrors.
                // Attribute — every caller must see it, Settings' change-password path has no
                // other way to). This form already shows the identical text as _summaryMessage
                // above, so drop the exact duplicate here rather than printing it a second time
                // as a bullet under its own summary line.
                _errors.Unattributed.RemoveAll(message => message == _summaryMessage);
            }

            // The server's line stands over the field messages it came with; with none left (a
            // whole-record rejection, which this line is the only copy of) it is not about a field.
            _summaryFollowsFieldErrors = _errors.HasMessages;

            return false;
        }
        finally
        {
            _saving = false;
        }
    }

    private RenderFragment RenderFrameSwatches() => @<div class="dg-field">
                                                        <label>Frame colour</label>
                                                        <div
                                                            style="display:flex; flex-wrap:wrap; gap:10px; align-items:flex-start;">
                                                            @{
                                                                // The list that matches the "children's frame" tick — the rule's own choice of
                                                                // category. A device whose cached lists predate the children's list has none to
                                                                // offer for a children's frame; it says so rather than fall back to adult colours.
                                                                var frameColours = ReferenceDataClient.GetByCategory(ConsultationRules.FrameColourCategory(_lensRange.ChildrensFrame));
                                                            }
                                                            @if (frameColours.Count == 0)
                                                            {
                                                                <p class="dg-lens-note" role="status">
                                                                    @(_lensRange.ChildrensFrame
                                                                        ? "The children's frame colours aren't on this device yet. Connect to load them."
                                                                        : "The frame colours aren't on this device yet. Connect to load them.")
                                                                </p>
                                                            }
                                                            @foreach (var colour in frameColours.OrderBy(c => c.SortOrder))
                                                            {
                                                                var selected = _frameColourRefId == colour.Id;
                                                                <button type="button" title="@colour.Label"
                                                                        @onclick="() => { ClearErrors(FrameColourFields); _frameColourRefId = colour.Id; }"
                                                                        style="display:flex; flex-direction:column; align-items:center; gap:4px; width:64px; padding:4px; background:none; cursor:pointer;
                                                                            border-radius:var(--radius-md); border: @(selected ? "2px solid var(--dot-orange)" : "1px solid var(--border-default)");">
                                                                    @if (ReferenceDataClient.PictureSource(colour) is { } picture)
                                                                    {
                                                                        @* A picture that can't load — offline with no copy on this device, say — gives
                           way to the same placeholder a colour with no picture shows. *@
                                                                        <img src="@picture" alt="@colour.Label"
                                                                             style="width:48px; height:48px; object-fit:contain;"
                                                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"/>
                                                                        <div
                                                                            style="width:48px; height:48px; border-radius:50%; background:#eee; display:none; align-items:center; justify-content:center; font-size:10px; color:#888;">
                                                                            ?
                                                                        </div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div
                                                                            style="width:48px; height:48px; border-radius:50%; background:#eee; display:flex; align-items:center; justify-content:center; font-size:10px; color:#888;">
                                                                            ?
                                                                        </div>
                                                                    }
                                                                    <span
                                                                        style="font-size:10px; text-align:center; line-height:1.2;">@colour.Label</span>
                                                                </button>
                                                            }
                                                        </div>
                                                        <FieldError Errors="_errors" For="FrameColourRefId"/>
                                                        @{
                                                            var selectedIsOther = _frameColourRefId is { } id && frameColours.FirstOrDefault(c => c.Id == id)?.IsOtherOption == true;
                                                        }
                                                        @if (selectedIsOther)
                                                        {
                                                            <div class="dg-field" style="margin-top:var(--space-2);">
                                                                <label>Frame colour — say which</label>
                                                                <input @bind="_frameColourOtherText"
                                                                       @oninput="() => ClearErrors(nameof(CreateSaleRequest.FrameColourOtherText))"/>
                                                                <FieldError Errors="_errors"
                                                                            For="FrameColourOtherText"/>
                                                            </div>
                                                        }
                                                    </div>;

}
