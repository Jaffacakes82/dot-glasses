@using System.Globalization
@using DotGlasses.App.ReferenceData
@using DotGlasses.App.Validation
@using DotGlasses.Contracts.Common
@using DotGlasses.Contracts.PresetCatalogues
@using DotGlasses.Contracts.ReferenceData
@using DotGlasses.Rules.LensPowers
@using DotGlasses.Rules.LensRanges
@using DotGlasses.Rules.LensSets
@using DotGlasses.Rules.ReferenceData

@* The lens section's first half, in the order a technician works in (ADR-0007): lens range, the lens
   (or a Custom prescription), children's frame, pupil distance. ConsultationForm renders what
   follows — the coatings or coating preference, then "Order this lens from Dot Glasses" (Custom
   only, last). *@

<div class="dg-field">
    <label>Lens range</label>
    @* Every lens set reaching this retail point, in the order the server sends them (alphabetical,
       empty sets already left out), then Custom — ADR-0005. No lens range is preselected. *@
    <select value="@SelectedRangeValue" @onchange="OnRangeChanged">
        @if (AllowNoPreference)
        {
            <option value="@NoPreference">No preference yet</option>
        }
        else
        {
            <option value="@NotChosen">Select a lens range…</option>
        }
        @foreach (var lensSet in Catalogues)
        {
            <option value="@lensSet.Id">@lensSet.Name</option>
        }
        <option value="@CustomRange">Custom prescription</option>
    </select>
    <FieldError Errors="Errors" For="LensRangeType" />
    <FieldError Errors="Errors" For="PresetCatalogueId" />
    @if (Catalogues.Count == 0)
    {
        <p style="font-size:12px;">No lens sets are assigned to this retail point — ask your administrator.</p>
    }
</div>

@if (Model.LensRangeType is LensRangeType.LensSet)
{
    @if (SelectedLensSet is null)
    {
        @* A converted Lead's lens set carries over as-is (SaleAssembly.Seed); if it has since been
           retired or unassigned here, say so rather than silently swapping in another. *@
        <p style="color:#c00; font-size:12px;">This lens set isn't available at your retail point — choose another lens range.</p>
    }
    else
    {
        @* A record holds each eye's lens power and the pair's lens type, not the lens (ADR-0007):
           choosing a lens records its power (LensRangeSelection.ChooseLenses), so a rejection
           about a lens comes back keyed on that eye's sphere, and a lens type mismatch on the lens
           type — both rendered here, since this branch shows no power or lens type controls.
           Lenses are listed by label in the Rules' fixed order, and each chosen lens's power reads
           underneath, so a vague label can be checked against what is behind it. *@
        <div class="dg-field">
            <label class="dg-choice"><input type="checkbox" checked="@Model.SameLensForBothEyes" @onchange="OnSameLensChanged" />Same lens for both eyes</label>
        </div>

        @if (Model.SameLensForBothEyes)
        {
            <div class="dg-field">
                <label>Lens</label>
                <select value="@Model.LensLeftId" @onchange="OnSameLensChosen">
                    <option value="">Select...</option>
                    @foreach (var lens in OrderedLenses)
                    {
                        <option value="@lens.Id">@lens.Label</option>
                    }
                </select>
                @RenderPowerLine(Model.LensLeftId)
                @RenderNote(Model.LensNoteLeft ?? Model.LensNoteRight)
                <FieldError Errors="Errors" For="SphereLeft" />
                <FieldError Errors="Errors" For="SphereRight" />
                <FieldError Errors="Errors" For="LensTypeRefId" />
            </div>
        }
        else
        {
            <div class="dg-field">
                <label>Lens — left eye</label>
                <select value="@Model.LensLeftId" @onchange="OnLeftLensChosen">
                    <option value="">Select...</option>
                    @foreach (var lens in OrderedLenses)
                    {
                        <option value="@lens.Id">@lens.Label</option>
                    }
                </select>
                @RenderPowerLine(Model.LensLeftId)
                @RenderNote(Model.LensNoteLeft)
                <FieldError Errors="Errors" For="SphereLeft" />
            </div>
            <div class="dg-field">
                <label>Lens — right eye</label>
                <select value="@Model.LensRightId" @onchange="OnRightLensChosen">
                    <option value="">Select...</option>
                    @foreach (var lens in RightLensChoices)
                    {
                        <option value="@lens.Id">@lens.Label</option>
                    }
                </select>
                @if (LeftLens is not null)
                {
                    <p class="dg-lens-hint">Only lenses of the left eye's lens type are listed.</p>
                }
                @RenderPowerLine(Model.LensRightId)
                @RenderNote(Model.LensNoteRight)
                <FieldError Errors="Errors" For="SphereRight" />
                <FieldError Errors="Errors" For="LensTypeRefId" />
            </div>
        }

        @if (ChosenLensesWithoutCoatings)
        {
            <p style="color:#c00; font-size:12px;">No coatings are configured for this lens yet — it can't be sold on a lens set until DGI adds one on Lens Sets.</p>
        }
    }
}
else if (Model.LensRangeType == LensRangeType.Custom)
{
    @* Every value list below is LensPowerValues' (ADR-0007) — the shop's values, in its order. The
       axis dropdown shows only while that eye has a cylinder, because the rules refuse an axis
       without one (OnCylinderChanged clears it when the cylinder goes back to 0.00); an axis a
       record already carries with no cylinder (a Failed record queued before the rules applied)
       keeps its control so the rejection has somewhere to land. Every field carries its own
       FieldError so a server rejection lands against the control it's about. *@
    <div style="display:flex; flex-wrap:wrap; gap:8px;">
        <LensPowerSelect Label="Sphere — left" Values="LensPowerValues.Sphere" Value="Model.SphereLeft"
                         ValueChanged="v => OnSphereChanged(left: true, v)" Errors="Errors" Field="SphereLeft" />
        <LensPowerSelect Label="Cylinder — left" Values="LensPowerValues.Cylinder" Value="Model.CylinderLeft"
                         ValueChanged="v => OnCylinderChanged(left: true, v)" Errors="Errors" Field="CylinderLeft" />
        @if (LensPowerRules.HasCylinder(Model.CylinderLeft) || Model.AxisLeft is not null)
        {
            <LensPowerSelect Label="Axis — left" Values="LensPowerValues.Axis" Display="AxisText" Value="Model.AxisLeft"
                             ValueChanged="v => Model.AxisLeft = v" Errors="Errors" Field="AxisLeft" />
        }
        <LensPowerSelect Label="Add power — left" Values="LensPowerValues.Add" Value="Model.AddLeft"
                         ValueChanged="v => OnAddPowerChanged(left: true, v)" Errors="Errors" Field="AddLeft" />
    </div>
    <div style="display:flex; flex-wrap:wrap; gap:8px;">
        <LensPowerSelect Label="Sphere — right" Values="LensPowerValues.Sphere" Value="Model.SphereRight"
                         ValueChanged="v => OnSphereChanged(left: false, v)" Errors="Errors" Field="SphereRight" />
        <LensPowerSelect Label="Cylinder — right" Values="LensPowerValues.Cylinder" Value="Model.CylinderRight"
                         ValueChanged="v => OnCylinderChanged(left: false, v)" Errors="Errors" Field="CylinderRight" />
        @if (LensPowerRules.HasCylinder(Model.CylinderRight) || Model.AxisRight is not null)
        {
            <LensPowerSelect Label="Axis — right" Values="LensPowerValues.Axis" Display="AxisText" Value="Model.AxisRight"
                             ValueChanged="v => Model.AxisRight = v" Errors="Errors" Field="AxisRight" />
        }
        <LensPowerSelect Label="Add power — right" Values="LensPowerValues.Add" Value="Model.AddRight"
                         ValueChanged="v => OnAddPowerChanged(left: false, v)" Errors="Errors" Field="AddRight" />
    </div>
    @* An add of 0.00 is no add (LensPowerRules.HasAdd), so it doesn't ask for a lens type. It is a
       radio group, never a dropdown. *@
    @if (LensPowerRules.HasAdd(Model.AddLeft) || LensPowerRules.HasAdd(Model.AddRight) || Model.LensTypeRefId is not null)
    {
        <ReferenceDataRadios Label="Lens type" Items="LensTypes"
                              SelectedId="Model.LensTypeRefId" SelectedIdChanged="v => Model.LensTypeRefId = v"
                              OtherText="Model.LensTypeOtherText" OtherTextChanged="v => Model.LensTypeOtherText = v"
                              Errors="Errors" Field="LensTypeRefId" OtherField="LensTypeOtherText" />
    }
}

<div class="dg-field">
    <label class="dg-choice"><input type="checkbox" checked="@Model.ChildrensFrame" @onchange="OnChildrensFrameChanged" />Children's frame</label>
</div>

@if (Model.LensRangeType is LensRangeType.LensSet && SelectedLensSet is not null)
{
    <div class="dg-field">
        <label>Pupil distance (0–@MaxPresetPdBucket@(Model.ChildrensFrame ? ", children's frame" : ""))</label>
        <select value="@Model.PresetPupilDistanceBucket" @onchange="e => { Errors?.ClearFields(nameof(Model.PresetPupilDistanceBucket)); Model.PresetPupilDistanceBucket = ParseInt(e.Value); }">
            <option value="">Select...</option>
            @foreach (var bucket in LensPowerValues.PresetPupilDistanceBuckets(Model.ChildrensFrame))
            {
                <option value="@bucket">@bucket</option>
            }
        </select>
        <FieldError Errors="Errors" For="PresetPupilDistanceBucket" />
    </div>
}
else if (Model.LensRangeType == LensRangeType.Custom)
{
    <div class="dg-field">
        <label>Pupil distance (mm, @LensPowerValues.PupilDistanceMmRange.Min–@LensPowerValues.PupilDistanceMmRange.Max)</label>
        <select value="@Model.PupilDistanceMm" @onchange="e => { Errors?.ClearFields(nameof(Model.PupilDistanceMm)); Model.PupilDistanceMm = ParseDecimal(e.Value); }">
            <option value="">Select...</option>
            @foreach (var mm in LensPowerValues.PupilDistanceMm)
            {
                <option value="@mm">@mm</option>
            }
        </select>
        <FieldError Errors="Errors" For="PupilDistanceMm" />
    </div>
}

@code {
    [Parameter, EditorRequired] public LensRangeSelection Model { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<PresetCatalogueDto> Catalogues { get; set; } = [];

    /// <summary>The lens type radios a Custom prescription offers once either eye carries an add
    /// above 0.00 — see the conditional group above.</summary>
    [Parameter] public IReadOnlyList<ReferenceDataItemDto> LensTypes { get; set; } = [];

    /// <summary>A Lead can carry no product preference at all; a Sale must always have one.</summary>
    [Parameter] public bool AllowNoPreference { get; set; }

    [Parameter] public FormErrors? Errors { get; set; }

    /// <summary>The same catalogues as <see cref="Catalogues"/>, as the shared rules read them —
    /// choosing a lens records its power through the Rules (LensRangeSelection.ChooseLenses), and
    /// the lenses are listed in the Rules' order (LensSetLenses.InDisplayOrder).</summary>
    [Parameter, EditorRequired] public ReferenceDataSnapshot ReferenceData { get; set; } = ReferenceDataSnapshot.Empty;

    /// <summary>Fired whenever Model.LensRangeType or a chosen lens changes. Model is a
    /// shared reference-type object, so mutating its properties here doesn't by itself make the
    /// parent re-render — without this, anything the parent conditionally shows/restricts based on
    /// these fields (the coating picker, restricted to the coatings both chosen lenses come in)
    /// only catches up the next time some unrelated field happens to trigger the parent's own
    /// render, not immediately when the range/lens changes. The parent is also responsible for
    /// clearing its own coating selection in response — this component no longer owns coating
    /// state at all, see ADR-0001.</summary>
    [Parameter] public EventCallback SelectionChanged { get; set; }

    // A Sale has no default lens range (ADR-0005): the first entry is an explicit "Select a lens
    // range…" whose value maps to a null model, so what the browser shows and what the model holds
    // agree from the start. (An earlier version defaulted a Sale to the 6-Lens set, and before
    // that showed it without selecting it, which submitted a null range.)
    private const string NoPreference = "none";
    private const string NotChosen = "";
    private const string CustomRange = LensRangeChoice.Custom;

    /// <summary>The lens set the model names, or null when it names one not reaching this retail
    /// point (a converted Lead's set, since retired or unassigned).</summary>
    private PresetCatalogueDto? SelectedLensSet => Catalogues.FirstOrDefault(c => c.Id == Model.PresetCatalogueId);

    /// <summary>A lens set that isn't in the list shows the placeholder — the red note below says
    /// why — rather than a value the dropdown has no option for.</summary>
    private string SelectedRangeValue =>
        (Model.LensRangeType is not LensRangeType.LensSet || SelectedLensSet is not null
            ? LensRangeChoice.Format(Model.LensRangeType, Model.PresetCatalogueId)
            : null)
        ?? (AllowNoPreference ? NoPreference : NotChosen);

    private IReadOnlyList<LensOptionSnapshot> SetLenses =>
        ReferenceData.FindCatalogue(Model.PresetCatalogueId)?.LensOptions ?? [];

    /// <summary>The chosen set's lenses in the fixed Rules order — single vision by sphere, then
    /// Bifocal, Progressive and Other by add, then by sphere.</summary>
    private IReadOnlyList<LensOptionSnapshot> OrderedLenses => LensSetLenses.InDisplayOrder(SetLenses, ReferenceData);

    private LensOptionSnapshot? LeftLens => SetLenses.FirstOrDefault(l => l.Id == Model.LensLeftId);

    /// <summary>The right eye is limited to the lenses the left can pair with — a pair has one
    /// lens type, and a mixed pair can't be sold (LensSetLenses.RightEyeChoices). Every lens is
    /// offered until the left is chosen.</summary>
    private IEnumerable<LensOptionSnapshot> RightLensChoices => LensSetLenses.RightEyeChoices(OrderedLenses, LeftLens);

    /// <summary>A chosen lens that comes in no coating can't be sold — say so up front.</summary>
    private bool ChosenLensesWithoutCoatings =>
        SetLenses.Any(l => (l.Id == Model.LensLeftId || l.Id == Model.LensRightId) && l.CoatingIds.Count == 0);

    private static string AxisText(decimal axis) => axis.ToString("0", CultureInfo.InvariantCulture);

    private RenderFragment RenderPowerLine(Guid? lensId) => builder =>
    {
        if (SetLenses.FirstOrDefault(l => l.Id == lensId) is { } lens)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "dg-lens-power");
            builder.AddContent(2, LensPowerValues.FormatLensPower(lens.Sphere, lens.Cylinder, lens.Axis, lens.Add));
            builder.CloseElement();
        }
    };

    private RenderFragment RenderNote(string? note) => builder =>
    {
        if (note is not null)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "dg-lens-note");
            builder.AddAttribute(2, "role", "status");
            builder.AddContent(3, note);
            builder.CloseElement();
        }
    };

    private async Task OnRangeChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        // Every lens-section message was about the range just left (or an answer it took with it).
        Errors?.ClearFields(LensErrorKeys.All);

        // Switching range type invalidates whichever fields belonged to the previous one — the
        // validator rejects preset+custom fields being set together.
        Model.PresetCatalogueId = null;
        Model.ForgetChosenLenses();
        Model.SphereLeft = null;
        Model.CylinderLeft = null;
        Model.AxisLeft = null;
        Model.AddLeft = null;
        Model.SphereRight = null;
        Model.CylinderRight = null;
        Model.AxisRight = null;
        Model.AddRight = null;
        Model.LensTypeRefId = null;
        Model.LensTypeOtherText = null;
        Model.PupilDistanceMm = null;
        Model.PresetPupilDistanceBucket = null;

        (Model.LensRangeType, Model.PresetCatalogueId) = LensRangeChoice.Parse(value);

        await SelectionChanged.InvokeAsync();
    }

    private static Guid? ParseGuid(object? value) =>
        Guid.TryParse(value?.ToString(), out var id) ? id : null;

    private static decimal? ParseDecimal(object? value) =>
        decimal.TryParse(value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var d) ? d : null;

    private static int? ParseInt(object? value) =>
        int.TryParse(value?.ToString(), out var i) ? i : null;

    /// <summary>The bucket ceiling, lowered for a children's frame — LensPowerValues, the one the
    /// rules check against.</summary>
    private int MaxPresetPdBucket => LensPowerValues.MaxPresetPupilDistanceBucket(Model.ChildrensFrame);

    private void OnChildrensFrameChanged(ChangeEventArgs e)
    {
        Model.ChildrensFrame = e.Value is true;

        // The frame size moves the pupil distance's ceiling, so a message about the old ceiling no
        // longer describes the answer.
        Errors?.ClearFields(nameof(Model.PresetPupilDistanceBucket));

        // A previously-picked bucket value may no longer be in range once the max drops from 4
        // to 2 — clear it rather than leaving a stale, no-longer-selectable value in the model.
        if (Model.PresetPupilDistanceBucket > MaxPresetPdBucket)
        {
            Model.PresetPupilDistanceBucket = null;
        }
    }

    /// <summary>Clears the now-hidden LensType pick the moment neither eye carries an add above
    /// 0.00 any more — the radio group itself disappears immediately (see the @if above), so a
    /// stale value the technician can no longer see or change must not linger to fail validation
    /// on submit.</summary>
    private void OnAddPowerChanged(bool left, decimal? value)
    {
        if (left)
        {
            Model.AddLeft = value;
        }
        else
        {
            Model.AddRight = value;
        }

        if (!LensPowerRules.HasAdd(Model.AddLeft) && !LensPowerRules.HasAdd(Model.AddRight))
        {
            Model.LensTypeRefId = null;
            Model.LensTypeOtherText = null;

            // The lens type control is gone, so its message has nothing left to point at.
            Errors?.ClearFields(LensErrorKeys.LensType);
        }
    }

    /// <summary>A Custom prescription with a sphere missing is reported against the lens range
    /// ("Choose a sphere for each eye."), not against either sphere, so choosing a sphere clears
    /// that message as well as the dropdown's own.</summary>
    private void OnSphereChanged(bool left, decimal? value)
    {
        if (left)
        {
            Model.SphereLeft = value;
        }
        else
        {
            Model.SphereRight = value;
        }

        Errors?.ClearFields(nameof(Model.LensRangeType));
    }

    /// <summary>Same reasoning for the axis: it is only asked while that eye has a cylinder, so
    /// going back to 0.00 (or blank) clears it rather than leaving a hidden value the rules
    /// refuse.</summary>
    private void OnCylinderChanged(bool left, decimal? value)
    {
        if (left)
        {
            Model.CylinderLeft = value;
            Errors?.ClearFields("AxisLeft");
            if (!LensPowerRules.HasCylinder(value))
            {
                Model.AxisLeft = null;
            }
        }
        else
        {
            Model.CylinderRight = value;
            Errors?.ClearFields("AxisRight");
            if (!LensPowerRules.HasCylinder(value))
            {
                Model.AxisRight = null;
            }
        }
    }

    // Every lens change tells the parent: the coatings on offer are the ones both chosen lenses
    // come in, so a change to either eye (or to "Same lens for both eyes") can invalidate a pick.

    private async Task OnSameLensChanged(ChangeEventArgs e)
    {
        Model.SetSameLensForBothEyes(SetLenses, e.Value is true);
        Errors?.ClearFields(LensErrorKeys.LensChoice);
        await SelectionChanged.InvokeAsync();
    }

    private async Task OnSameLensChosen(ChangeEventArgs e)
    {
        Model.ChooseSameLens(SetLenses, ParseGuid(e.Value));
        Errors?.ClearFields(LensErrorKeys.LensChoice);
        await SelectionChanged.InvokeAsync();
    }

    private async Task OnLeftLensChosen(ChangeEventArgs e)
    {
        Model.ChooseLeftLens(SetLenses, ParseGuid(e.Value));
        Errors?.ClearFields(LensErrorKeys.LensChoice);
        await SelectionChanged.InvokeAsync();
    }

    private async Task OnRightLensChosen(ChangeEventArgs e)
    {
        Model.ChooseRightLens(SetLenses, ParseGuid(e.Value));
        Errors?.ClearFields(LensErrorKeys.LensChoice);
        await SelectionChanged.InvokeAsync();
    }
}
