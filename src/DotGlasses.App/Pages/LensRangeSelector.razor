@using DotGlasses.App.ReferenceData
@using DotGlasses.App.Validation
@using DotGlasses.Contracts.Common
@using DotGlasses.Contracts.PresetCatalogues
@using DotGlasses.Contracts.ReferenceData
@using DotGlasses.Rules.LensPowers
@using DotGlasses.Rules.LensRanges

<div class="dg-field">
    <label>Lens range</label>
    @* Every lens set reaching this retail point, in the order the server sends them (alphabetical,
       empty sets already left out), then Custom — ADR-0005. No lens range is preselected. *@
    <select value="@SelectedRangeValue" @onchange="OnRangeChanged">
        @if (AllowNoPreference)
        {
            <option value="@NoPreference">No preference yet</option>
        }
        else
        {
            <option value="@NotChosen">Select a lens range…</option>
        }
        @foreach (var lensSet in Catalogues)
        {
            <option value="@lensSet.Id">@lensSet.Name</option>
        }
        <option value="@CustomRange">Custom prescription</option>
    </select>
    <FieldError Errors="Errors" For="LensRangeType" />
    <FieldError Errors="Errors" For="PresetCatalogueId" />
    @if (Catalogues.Count == 0)
    {
        <p style="font-size:12px;">No lens sets are assigned to this retail point — ask your administrator.</p>
    }
</div>

@if (Model.LensRangeType is LensRangeType.LensSet)
{
    var catalogue = SelectedLensSet;
    @if (catalogue is null)
    {
        @* A converted Lead's lens set carries over as-is (SaleAssembly.Seed); if it has since been
           retired or unassigned here, say so rather than silently swapping in another. *@
        <p style="color:#c00; font-size:12px;">This lens set isn't available at your retail point — choose another lens range.</p>
    }
    else
    {
        <div class="dg-field">
            <label>Lens power — left eye</label>
            <select value="@Model.LensOptionLeftId" @onchange="OnLeftLensChanged">
                <option value="">Select...</option>
                @foreach (var option in catalogue.LensOptions.OrderBy(o => o.SortOrder))
                {
                    <option value="@option.Id">@option.Label</option>
                }
            </select>
            <FieldError Errors="Errors" For="LensOptionLeftId" />
        </div>
        <div class="dg-field">
            <label>Lens power — right eye</label>
            <select value="@Model.LensOptionRightId" @onchange="e => Model.LensOptionRightId = ParseGuid(e.Value)">
                <option value="">Select...</option>
                @foreach (var option in catalogue.LensOptions.OrderBy(o => o.SortOrder))
                {
                    <option value="@option.Id">@option.Label</option>
                }
            </select>
            <FieldError Errors="Errors" For="LensOptionRightId" />
        </div>

        <div class="dg-field">
            <label>Pupil distance (0–@MaxPresetPdBucket@(Model.ChildrensFrame ? ", children's frame" : ""))</label>
            <select value="@Model.PresetPupilDistanceBucket" @onchange="e => Model.PresetPupilDistanceBucket = ParseInt(e.Value)">
                <option value="">Select...</option>
                @for (var i = 0; i <= MaxPresetPdBucket; i++)
                {
                    <option value="@i">@i</option>
                }
            </select>
            <FieldError Errors="Errors" For="PresetPupilDistanceBucket" />
        </div>

        @if (Model.LensOptionLeftId is not null)
        {
            var leftOption = catalogue.LensOptions.FirstOrDefault(o => o.Id == Model.LensOptionLeftId);
            @if ((leftOption?.AvailableCoatingIds ?? []).Count == 0)
            {
                <p style="color:#c00; font-size:12px;">No coatings are configured for this lens yet — it can't be sold on a lens set until DGI configures one in Reference Data.</p>
            }
        }
    }
}
else if (Model.LensRangeType == LensRangeType.Custom)
{
    @* Every value list below is LensPowerValues' (ADR-0007) — the shop's values, in its order. The
       axis box shows only while that eye has a cylinder, because the rules refuse an axis without
       one (OnCylinderChanged clears it when the cylinder goes back to 0.00). Every field carries
       its own FieldError so a server rejection — e.g. a positive cylinder queued before the shop's
       values applied — lands against the control it's about. *@
    <div style="display:flex; gap:8px;">
        <div class="dg-field" style="flex:1;">
            <label>Sphere — left</label>
            <select value="@Model.SphereLeft" @onchange="e => Model.SphereLeft = ParseDecimal(e.Value)">
                <option value="">Select...</option>
                @foreach (var v in LensPowerValues.Sphere)
                {
                    <option value="@v">@LensPowerValues.FormatPower(v)</option>
                }
            </select>
            <FieldError Errors="Errors" For="SphereLeft" />
        </div>
        <div class="dg-field" style="flex:1;">
            <label>Cylinder — left</label>
            <select value="@Model.CylinderLeft" @onchange="e => OnCylinderChanged(left: true, ParseDecimal(e.Value))">
                <option value="">Select...</option>
                @foreach (var v in LensPowerValues.Cylinder)
                {
                    <option value="@v">@LensPowerValues.FormatPower(v)</option>
                }
            </select>
            <FieldError Errors="Errors" For="CylinderLeft" />
        </div>
        @if (LensPowerRules.HasCylinder(Model.CylinderLeft) || Model.AxisLeft is not null)
        {
            <div class="dg-field" style="flex:1;"><label>Axis — left</label><input type="number" min="@LensPowerValues.AxisRange.Min" max="@LensPowerValues.AxisRange.Max" step="@LensPowerValues.AxisRange.Step" @bind="Model.AxisLeft" /><FieldError Errors="Errors" For="AxisLeft" /></div>
        }
        <div class="dg-field" style="flex:1;">
            <label>Add power — left</label>
            <select value="@Model.AddLeft" @onchange="e => OnAddPowerChanged(left: true, ParseDecimal(e.Value))">
                <option value="">Select...</option>
                @foreach (var v in LensPowerValues.Add)
                {
                    <option value="@v">@LensPowerValues.FormatPower(v)</option>
                }
            </select>
            <FieldError Errors="Errors" For="AddLeft" />
        </div>
    </div>
    <div style="display:flex; gap:8px;">
        <div class="dg-field" style="flex:1;">
            <label>Sphere — right</label>
            <select value="@Model.SphereRight" @onchange="e => Model.SphereRight = ParseDecimal(e.Value)">
                <option value="">Select...</option>
                @foreach (var v in LensPowerValues.Sphere)
                {
                    <option value="@v">@LensPowerValues.FormatPower(v)</option>
                }
            </select>
            <FieldError Errors="Errors" For="SphereRight" />
        </div>
        <div class="dg-field" style="flex:1;">
            <label>Cylinder — right</label>
            <select value="@Model.CylinderRight" @onchange="e => OnCylinderChanged(left: false, ParseDecimal(e.Value))">
                <option value="">Select...</option>
                @foreach (var v in LensPowerValues.Cylinder)
                {
                    <option value="@v">@LensPowerValues.FormatPower(v)</option>
                }
            </select>
            <FieldError Errors="Errors" For="CylinderRight" />
        </div>
        @if (LensPowerRules.HasCylinder(Model.CylinderRight) || Model.AxisRight is not null)
        {
            <div class="dg-field" style="flex:1;"><label>Axis — right</label><input type="number" min="@LensPowerValues.AxisRange.Min" max="@LensPowerValues.AxisRange.Max" step="@LensPowerValues.AxisRange.Step" @bind="Model.AxisRight" /><FieldError Errors="Errors" For="AxisRight" /></div>
        }
        <div class="dg-field" style="flex:1;">
            <label>Add power — right</label>
            <select value="@Model.AddRight" @onchange="e => OnAddPowerChanged(left: false, ParseDecimal(e.Value))">
                <option value="">Select...</option>
                @foreach (var v in LensPowerValues.Add)
                {
                    <option value="@v">@LensPowerValues.FormatPower(v)</option>
                }
            </select>
            <FieldError Errors="Errors" For="AddRight" />
        </div>
    </div>
    @* An add of 0.00 is no add (LensPowerRules.HasAdd), so it doesn't ask for a lens type. *@
    @if (LensPowerRules.HasAdd(Model.AddLeft) || LensPowerRules.HasAdd(Model.AddRight) || Model.LensTypeRefId is not null)
    {
        <ReferenceDataDropdown Label="Lens type" Items="LensTypes"
                                SelectedId="Model.LensTypeRefId" SelectedIdChanged="v => Model.LensTypeRefId = v"
                                OtherText="Model.LensTypeOtherText" OtherTextChanged="v => Model.LensTypeOtherText = v"
                                Errors="Errors" Field="LensTypeRefId" OtherField="LensTypeOtherText" />
    }
    <div class="dg-field">
        <label>Pupil distance (mm, @LensPowerValues.PupilDistanceMmRange.Min–@LensPowerValues.PupilDistanceMmRange.Max)</label>
        <select value="@Model.PupilDistanceMm" @onchange="e => Model.PupilDistanceMm = ParseDecimal(e.Value)">
            <option value="">Select...</option>
            @foreach (var mm in LensPowerValues.PupilDistanceMm)
            {
                <option value="@mm">@mm</option>
            }
        </select>
        <FieldError Errors="Errors" For="PupilDistanceMm" />
    </div>
}

<div class="dg-field">
    <label><input type="checkbox" checked="@Model.ChildrensFrame" @onchange="OnChildrensFrameChanged" style="width:auto; margin-right:8px;" />Children's frame</label>
</div>

@code {
    [Parameter, EditorRequired] public LensRangeSelection Model { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<PresetCatalogueDto> Catalogues { get; set; } = [];

    /// <summary>Only offered once either eye's Custom prescription carries an add above 0.00 (two
    /// distinct powers on that eye) — see the conditional dropdown above.</summary>
    [Parameter] public IReadOnlyList<ReferenceDataItemDto> LensTypes { get; set; } = [];

    /// <summary>A Lead can carry no product preference at all; a Sale must always have one.</summary>
    [Parameter] public bool AllowNoPreference { get; set; }

    [Parameter] public FormErrors? Errors { get; set; }

    /// <summary>Fired whenever Model.LensRangeType or Model.LensOptionLeftId changes. Model is a
    /// shared reference-type object, so mutating its properties here doesn't by itself make the
    /// parent re-render — without this, anything the parent conditionally shows/restricts based on
    /// these fields (the coating picker, restricted to the left lens's configured coatings) only
    /// catches up the next time some unrelated field happens to trigger the parent's own render,
    /// not immediately when the range/lens changes. The parent is also responsible for clearing
    /// its own coating selection in response — this component no longer owns coating state at
    /// all, see ADR-0001.</summary>
    [Parameter] public EventCallback SelectionChanged { get; set; }

    // A Sale has no default lens range (ADR-0005): the first entry is an explicit "Select a lens
    // range…" whose value maps to a null model, so what the browser shows and what the model holds
    // agree from the start. (An earlier version defaulted a Sale to the 6-Lens set, and before
    // that showed it without selecting it, which submitted a null range.)
    private const string NoPreference = "none";
    private const string NotChosen = "";
    private const string CustomRange = LensRangeChoice.Custom;

    /// <summary>The lens set the model names, or null when it names one not reaching this retail
    /// point (a converted Lead's set, since retired or unassigned).</summary>
    private PresetCatalogueDto? SelectedLensSet => Catalogues.FirstOrDefault(c => c.Id == Model.PresetCatalogueId);

    /// <summary>A lens set that isn't in the list shows the placeholder — the red note below says
    /// why — rather than a value the dropdown has no option for.</summary>
    private string SelectedRangeValue =>
        (Model.LensRangeType is not LensRangeType.LensSet || SelectedLensSet is not null
            ? LensRangeChoice.Format(Model.LensRangeType, Model.PresetCatalogueId)
            : null)
        ?? (AllowNoPreference ? NoPreference : NotChosen);

    private async Task OnRangeChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();

        // Switching range type invalidates whichever fields belonged to the previous one — the
        // validator rejects preset+custom fields being set together.
        Model.PresetCatalogueId = null;
        Model.LensOptionLeftId = null;
        Model.LensOptionRightId = null;
        Model.SphereLeft = null;
        Model.CylinderLeft = null;
        Model.AxisLeft = null;
        Model.AddLeft = null;
        Model.SphereRight = null;
        Model.CylinderRight = null;
        Model.AxisRight = null;
        Model.AddRight = null;
        Model.LensTypeRefId = null;
        Model.LensTypeOtherText = null;
        Model.PupilDistanceMm = null;
        Model.PresetPupilDistanceBucket = null;

        (Model.LensRangeType, Model.PresetCatalogueId) = LensRangeChoice.Parse(value);

        await SelectionChanged.InvokeAsync();
    }

    private static Guid? ParseGuid(object? value) =>
        Guid.TryParse(value?.ToString(), out var id) ? id : null;

    private static decimal? ParseDecimal(object? value) =>
        decimal.TryParse(value?.ToString(), out var d) ? d : null;

    private static int? ParseInt(object? value) =>
        int.TryParse(value?.ToString(), out var i) ? i : null;

    /// <summary>0-4 normally, 0-2 for a children's frame — see Sale/Lead.PresetPupilDistanceBucket.</summary>
    private int MaxPresetPdBucket => Model.ChildrensFrame ? 2 : 4;

    private void OnChildrensFrameChanged(ChangeEventArgs e)
    {
        Model.ChildrensFrame = e.Value is true;

        // A previously-picked bucket value may no longer be in range once the max drops from 4
        // to 2 — clear it rather than leaving a stale, no-longer-selectable value in the model.
        if (Model.PresetPupilDistanceBucket > MaxPresetPdBucket)
        {
            Model.PresetPupilDistanceBucket = null;
        }
    }

    /// <summary>Clears the now-hidden LensType pick the moment neither eye carries an add above
    /// 0.00 any more — the dropdown itself disappears immediately (see the @if above), so a stale
    /// value the technician can no longer see or change must not linger to fail validation on
    /// submit.</summary>
    private void OnAddPowerChanged(bool left, decimal? value)
    {
        if (left)
        {
            Model.AddLeft = value;
        }
        else
        {
            Model.AddRight = value;
        }

        if (!LensPowerRules.HasAdd(Model.AddLeft) && !LensPowerRules.HasAdd(Model.AddRight))
        {
            Model.LensTypeRefId = null;
            Model.LensTypeOtherText = null;
        }
    }

    /// <summary>Same reasoning for the axis: it is only asked while that eye has a cylinder, so
    /// going back to 0.00 (or blank) clears it rather than leaving a hidden value the rules
    /// refuse.</summary>
    private void OnCylinderChanged(bool left, decimal? value)
    {
        if (left)
        {
            Model.CylinderLeft = value;
            if (!LensPowerRules.HasCylinder(value))
            {
                Model.AxisLeft = null;
            }
        }
        else
        {
            Model.CylinderRight = value;
            if (!LensPowerRules.HasCylinder(value))
            {
                Model.AxisRight = null;
            }
        }
    }

    private async Task OnLeftLensChanged(ChangeEventArgs e)
    {
        Model.LensOptionLeftId = ParseGuid(e.Value);
        // Available coatings are keyed off the left-eye lens ("left eye wins" — see SaleService's
        // historical single-CoatingRefId simplification, still true for which lens drives
        // availability now that Coating is a set) — the parent must re-derive/clear its own
        // coating selection since any prior pick may no longer be valid.
        await SelectionChanged.InvokeAsync();
    }

}
