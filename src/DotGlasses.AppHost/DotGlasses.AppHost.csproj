<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <ItemGroup>
    <ProjectReference Include="..\DotGlasses.Web\DotGlasses.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddAzurePostgresFlexibleServer(...).RunAsContainer(...) replaces the plain
         Aspire.Hosting.PostgreSQL AddPostgres() call: same local-dev container experience, but
         now also generates Azure Database for PostgreSQL Flexible Server Bicep at publish time. -->
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" Version="13.4.6" />
    <!-- Explicit Azure Container Apps environment — required since Aspire 9.4 dropped the
         "hybrid" mode where azd silently created/owned this environment. -->
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.4.6" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>6375cd1e-1b69-4353-90dd-c7d5a723ccb2</UserSecretsId>
  </PropertyGroup>

</Project>
