@model DotGlasses.Web.Models.LeadConversionViewModel
@using DotGlasses.Rules.LensPowers
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Convert lead to sale";
}
@functions {
    // Option values use the request culture's own decimal format — the same culture the form
    // binder parses them back with — and the select tag helper's asp-for marks the posted value
    // selected on a re-render. The label is the shop's display format.
    private static IEnumerable<SelectListItem> PowerOptions(IEnumerable<decimal> values) =>
        values.Select(v => new SelectListItem(LensPowerValues.FormatPower(v), v.ToString()));

    private static IEnumerable<SelectListItem> AxisOptions() =>
        LensPowerValues.Axis.Select(v => new SelectListItem(v.ToString("0"), v.ToString("0")));
}

@await Html.PartialAsync("_PageHeader", new DotGlasses.Web.Models.PageHeaderViewModel
{
    Crumb = "Event History",
    Title = "Convert lead to sale",
})

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" style="border-radius:var(--radius-md); margin-bottom:var(--space-4);" asp-validation-summary="All"></div>
}

<div class="dg-card" style="max-width:640px; margin-bottom:var(--space-4);">
    <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin:0 0 4px; font-size:15px;">Lead details</h3>
    <p style="margin:0;"><strong>@Model.CustomerFullName</strong>@(string.IsNullOrWhiteSpace(Model.CustomerPhoneNumber) ? "" : $" · {Model.CustomerPhoneNumber}")</p>
    @if (Model.LensCarriedOver)
    {
        <p style="font-size:13px; color:var(--text-muted-2); margin:8px 0 0;">
            This lead already captured a product preference — it carries over unchanged:
            <br /><span style="color:inherit;">@Model.LensSummary</span>
        </p>
    }
    else if (Model.UnavailableLensSetName is { } unavailable)
    {
        <p style="font-size:13px; color:#c00; margin:8px 0 0;">
            This lead chose the lens set “@unavailable”, which isn't available at this lead's retail point any more
            (retired or unassigned since) — choose a lens range below.
        </p>
    }
    else
    {
        <p style="font-size:13px; color:var(--text-muted-2); margin:8px 0 0;">
            This lead has no lens/prescription preference on file — choose one below.
        </p>
    }
</div>

<form asp-controller="LeadConversion" asp-action="Convert" asp-route-id="@Model.Lead.Id" method="post" class="dg-card" style="max-width:640px; display:flex; flex-direction:column; gap:var(--space-3);">
    @Html.AntiForgeryToken()

    @if (!Model.LensCarriedOver)
    {
        <div>
            <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin:0 0 8px; font-size:15px;">Lens range</h3>
            @* The lens sets reaching the Lead's retail point, alphabetically, then Custom — ADR-0005. *@
            <label>Lens range</label>
            <select class="form-select" asp-for="Form.LensRange">
                <option value="">— Choose a lens range —</option>
                @foreach (var catalogue in Model.AvailableCatalogues)
                {
                    <option value="@catalogue.Id">@catalogue.Name</option>
                }
                <option value="@DotGlasses.Rules.LensRanges.LensRangeChoice.Custom">Custom prescription</option>
            </select>
            @if (Model.AvailableCatalogues.Count == 0)
            {
                <p class="dg-crumb" style="margin-top:4px;">No lens sets are assigned to this lead's retail point — only a Custom prescription can be recorded.</p>
            }

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px;">
                <div>
                    <label>Lens set pupil distance (0-4)</label>
                    <input class="form-control" type="number" min="0" max="4" asp-for="Form.PresetPupilDistanceBucket" />
                </div>
                <div>
                    <label>Left lens option</label>
                    <select class="form-select" asp-for="Form.LensOptionLeftId">
                        <option value="">—</option>
                        @foreach (var catalogue in Model.AvailableCatalogues)
                        {
                            @foreach (var option in catalogue.LensOptions)
                            {
                                <option value="@option.Id">@catalogue.Name — @option.Label</option>
                            }
                        }
                    </select>
                </div>
                <div>
                    <label>Right lens option</label>
                    <select class="form-select" asp-for="Form.LensOptionRightId">
                        <option value="">—</option>
                        @foreach (var catalogue in Model.AvailableCatalogues)
                        {
                            @foreach (var option in catalogue.LensOptions)
                            {
                                <option value="@option.Id">@catalogue.Name — @option.Label</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <p style="font-size:12px; color:var(--text-muted-2); margin:8px 0 4px;">— or, for a Custom range —</p>
            @* The shop's values, from LensPowerValues (ADR-0007) — nothing here lists them itself. *@
            <div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:8px;">
                <div><label>Sphere (R)</label><select class="form-select" asp-for="Form.SphereRight" asp-items="PowerOptions(LensPowerValues.Sphere)"><option value="">—</option></select></div>
                <div><label>Cylinder (R)</label><select class="form-select" asp-for="Form.CylinderRight" asp-items="PowerOptions(LensPowerValues.Cylinder)"><option value="">—</option></select></div>
                <div><label>Axis (R, only with a cylinder)</label><select class="form-select" asp-for="Form.AxisRight" asp-items="AxisOptions()"><option value="">—</option></select></div>
                <div><label>Add power (R)</label><select class="form-select" asp-for="Form.AddRight" asp-items="PowerOptions(LensPowerValues.Add)"><option value="">—</option></select></div>
                <div><label>Sphere (L)</label><select class="form-select" asp-for="Form.SphereLeft" asp-items="PowerOptions(LensPowerValues.Sphere)"><option value="">—</option></select></div>
                <div><label>Cylinder (L)</label><select class="form-select" asp-for="Form.CylinderLeft" asp-items="PowerOptions(LensPowerValues.Cylinder)"><option value="">—</option></select></div>
                <div><label>Axis (L, only with a cylinder)</label><select class="form-select" asp-for="Form.AxisLeft" asp-items="AxisOptions()"><option value="">—</option></select></div>
                <div><label>Add power (L)</label><select class="form-select" asp-for="Form.AddLeft" asp-items="PowerOptions(LensPowerValues.Add)"><option value="">—</option></select></div>
                <div><label>Pupil distance (mm)</label><input class="form-control" type="number" min="@LensPowerValues.PupilDistanceMmRange.Min" max="@LensPowerValues.PupilDistanceMmRange.Max" asp-for="Form.PupilDistanceMm" /></div>
                <div style="display:flex; align-items:flex-end;"><label><input type="checkbox" asp-for="Form.ChildrensFrame" style="width:auto; margin-right:6px;" />Children's frame</label></div>
                <div>
                    <label>Lens type (required if an add power above 0.00 is set)</label>
                    <select class="form-select" asp-for="Form.LensTypeRefId">
                        <option value="">—</option>
                        @foreach (var lensType in Model.LensTypes)
                        {
                            <option value="@lensType.Id">@lensType.Label</option>
                        }
                    </select>
                </div>
                <div>
                    <label>Lens type — "Other" text</label>
                    <input class="form-control" asp-for="Form.LensTypeOtherText" />
                </div>
            </div>
        </div>
    }

    <div>
        <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin:0 0 8px; font-size:15px;">Sale details</h3>

        <label><input type="checkbox" asp-for="Form.ConsentGiven" style="width:auto; margin-right:6px;" />Customer consents to be contacted for follow-ups/marketing</label>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px;">
            <div>
                <label>Coating (choose at least one)</label>
                @foreach (var coating in Model.Coatings)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="Form.CoatingRefIds" value="@coating.Id" id="coating-@coating.Id"
                               checked="@(Model.Form.CoatingRefIds.Contains(coating.Id) ? "checked" : null)" />
                        <label class="form-check-label" for="coating-@coating.Id">@coating.Label</label>
                    </div>
                }
            </div>
            <div>
                <label>Frame colour</label>
                <select class="form-select" asp-for="Form.FrameColourRefId">
                    <option value="">— Choose —</option>
                    @foreach (var colour in Model.FrameColours)
                    {
                        <option value="@colour.Id">@colour.Label</option>
                    }
                </select>
            </div>
            <div>
                <label>Frame colour — "Other" text</label>
                <input class="form-control" asp-for="Form.FrameColourOtherText" />
            </div>
        </div>

        <label style="display:block; margin-top:8px;"><input type="checkbox" asp-for="Form.HardCaseSold" style="width:auto; margin-right:6px;" />Hard case sold</label>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:4px;">
            <div>
                <label>Hard case colour</label>
                <select class="form-select" asp-for="Form.HardCaseColourRefId">
                    <option value="">—</option>
                    @foreach (var colour in Model.HardCaseColours)
                    {
                        <option value="@colour.Id">@colour.Label</option>
                    }
                </select>
            </div>
            <div>
                <label>Hard case colour — "Other" text</label>
                <input class="form-control" asp-for="Form.HardCaseOtherColourText" />
            </div>
        </div>

        <label style="display:block; margin-top:8px;"><input type="checkbox" asp-for="Form.OrderFromDotGlasses" style="width:auto; margin-right:6px;" />Order this lens from Dot Glasses (Custom range only)</label>
    </div>

    @* "Referred or treated" — asked here as it is on every other capture path. Every field is
       rendered unconditionally with its condition spelled out in the label, matching how this
       form already handles the "Other" text and hard-case fields: no client-side show/hide on
       this occasional manual-entry path, the rules are enforced server-side by
       ConsultationRules and come back as a validation summary on submit. *@
    <div>
        <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin:0 0 8px; font-size:15px;">Referred or treated</h3>

        <label><input type="checkbox" asp-for="Form.ReferredOrTreated" style="width:auto; margin-right:6px;" />Customer was referred or treated</label>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:8px;">
            <div>
                <label>Referral reason (required if referred or treated)</label>
                <select class="form-select" asp-for="Form.ReferralReasonRefId">
                    <option value="">—</option>
                    @foreach (var reason in Model.ReferralReasons)
                    {
                        <option value="@reason.Id">@reason.Label</option>
                    }
                </select>
            </div>
            <div>
                <label>Referral reason — "Other" text</label>
                <input class="form-control" asp-for="Form.ReferralOtherText" />
            </div>
        </div>

        <label style="display:block; margin-top:8px;"><input type="checkbox" asp-for="Form.TreatedInFacility" style="width:auto; margin-right:6px;" />Treated in this facility (rather than referred elsewhere)</label>

        <div style="margin-top:4px;">
            <label>Referral location (required unless treated in this facility)</label>
            <input class="form-control" asp-for="Form.ReferralLocationFreeText" />
        </div>
    </div>

    <div style="display:flex; gap:8px; margin-top:var(--space-2);">
        <a class="dg-btn dg-btn-ghost" asp-controller="EventHistory" asp-action="Index" asp-route-tab="leads">Cancel</a>
        <button class="dg-btn dg-btn-primary" type="submit">Convert to sale</button>
    </div>
</form>
