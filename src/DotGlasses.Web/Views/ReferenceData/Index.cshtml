@model IReadOnlyList<DotGlasses.Web.Models.ReferenceDataList>
@{
    ViewData["Title"] = "Manage Reference Data";
}

@await Html.PartialAsync("_PageHeader", new DotGlasses.Web.Models.PageHeaderViewModel
{
    Crumb = "Configuration",
    Title = "Manage Reference Data",
})

<p style="max-width:680px; color:var(--text-muted-2); margin-bottom:var(--space-5);">
    These lists feed dropdowns/checkboxes in both the Field App and this portal's consultation
    form. Only the DOT Glasses team edits them — not local distributors or retailers.
</p>

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-4);">
    @foreach (var list in Model)
    {
        <div class="dg-card">
            <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin:0 0 4px; font-size:16px;">@list.Name</h3>
            <p class="dg-crumb" style="margin-bottom:var(--space-3);">@list.ScopeNote</p>
            <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:var(--space-4);">
                @foreach (var option in list.Options)
                {
                    <span class="dg-badge" style="background:var(--dot-beige); display:inline-flex; align-items:center; gap:6px;">@option <span style="cursor:pointer;">&times;</span></span>
                }
            </div>
            <div style="display:flex; gap:var(--space-2);">
                <input class="form-control" placeholder="Add option" />
                <button class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px;" type="button">Add</button>
            </div>
        </div>
    }
</div>
