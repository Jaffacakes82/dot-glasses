@model IReadOnlyList<DotGlasses.Web.Models.ReferenceDataList>
@{
    ViewData["Title"] = "Manage Reference Data";
}

@await Html.PartialAsync("_PageHeader", new DotGlasses.Web.Models.PageHeaderViewModel
{
    Crumb = "Configuration",
    Title = "Manage Reference Data",
})

<p style="max-width:680px; color:var(--text-muted-2); margin-bottom:var(--space-5);">
    These lists feed dropdowns/checkboxes in both the Field App and this portal's consultation
    form. Only the Dot Glasses team edits them — not local distributors or retailers. Removing an
    option retires it (it stays attached to any past record that used it) rather than deleting it
    outright — retired options can be restored below.
</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" style="border-radius:var(--radius-md); margin-bottom:var(--space-4);" asp-validation-summary="All"></div>
}

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-4);">
    @foreach (var list in Model)
    {
        <div class="dg-card">
            <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin:0 0 4px; font-size:16px;">@list.Name</h3>
            <p class="dg-crumb" style="margin-bottom:var(--space-3);">@list.ScopeNote</p>

            <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:var(--space-3);">
                @if (!list.ActiveOptions.Any())
                {
                    <span style="font-size:13px; color:#999;">No options yet.</span>
                }
                @foreach (var option in list.ActiveOptions)
                {
                    <span class="dg-badge" style="background:var(--dot-beige); display:inline-flex; align-items:center; gap:6px;">
                        @if (list.ShowImageField && !string.IsNullOrEmpty(option.ImageUrl))
                        {
                            <img src="@option.ImageUrl" alt="@option.Label" style="width:18px; height:18px; border-radius:50%; object-fit:cover;" />
                        }
                        @option.Label
                        <form asp-action="MoveUp" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@option.Id" />
                            <button type="submit" aria-label="Move @option.Label up" style="border:none; background:none; cursor:pointer; padding:0; color:#888; font-size:11px; line-height:1;">&uarr;</button>
                        </form>
                        <form asp-action="MoveDown" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@option.Id" />
                            <button type="submit" aria-label="Move @option.Label down" style="border:none; background:none; cursor:pointer; padding:0; color:#888; font-size:11px; line-height:1;">&darr;</button>
                        </form>
                        <button type="button" aria-label="Edit @option.Label" data-bs-toggle="modal" data-bs-target="#editRefDataModal-@option.Id"
                                style="border:none; background:none; cursor:pointer; padding:0; color:#888; font-size:12px; line-height:1;">&#9998;</button>
                        <form asp-action="Deactivate" method="post" style="display:inline;">
                            <input type="hidden" name="id" value="@option.Id" />
                            <button type="submit" aria-label="Retire @option.Label" style="border:none; background:none; cursor:pointer; padding:0; color:#888; font-size:13px; line-height:1;">&times;</button>
                        </form>
                    </span>

                    <div class="modal fade" id="editRefDataModal-@option.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content" style="border-radius:var(--radius-md); border:none;">
                                <form asp-action="Update" method="post">
                                    <input type="hidden" name="Id" value="@option.Id" />
                                    <div class="modal-header">
                                        <h2 class="dg-page-title" style="font-size:20px;">Edit @option.Label</h2>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="dg-auth-field">
                                            <label>Label</label>
                                            <input class="form-control" name="Label" value="@option.Label" />
                                        </div>
                                        @if (list.ShowImageField)
                                        {
                                            <div class="dg-auth-field">
                                                <label>Image URL</label>
                                                <input class="form-control" name="ImageUrl" value="@option.ImageUrl" />
                                            </div>
                                        }
                                    </div>
                                    <div class="modal-footer">
                                        <button class="dg-btn dg-btn-ghost" type="button" data-bs-dismiss="modal">Cancel</button>
                                        <button class="dg-btn dg-btn-primary" type="submit">Save</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (list.RetiredOptions.Any())
            {
                <details style="margin-bottom:var(--space-3);">
                    <summary style="font-size:12px; color:#999; cursor:pointer;">Retired (@list.RetiredOptions.Count)</summary>
                    <div style="display:flex; flex-wrap:wrap; gap:6px; margin-top:var(--space-2);">
                        @foreach (var option in list.RetiredOptions)
                        {
                            <span class="dg-badge" style="background:#f2f2f2; color:#999; display:inline-flex; align-items:center; gap:6px;">
                                @option.Label
                                <form asp-action="Reactivate" method="post" style="display:inline;">
                                    <input type="hidden" name="id" value="@option.Id" />
                                    <button type="submit" style="border:none; background:none; cursor:pointer; padding:0; color:var(--dot-blue); font-size:12px; text-decoration:underline;">Restore</button>
                                </form>
                            </span>
                        }
                    </div>
                </details>
            }

            @if (list.Category == DotGlasses.Domain.Enums.ReferenceDataCategory.Coating)
            {
                <div style="margin-bottom:var(--space-3); padding-top:var(--space-2); border-top:1px solid var(--border-default);">
                    <p class="dg-stat-label" style="margin-bottom:4px;">Pairings (selecting the first auto-adds the second)</p>
                    @if (!list.CoatingPairings.Any())
                    {
                        <span style="font-size:12px; color:#999;">None yet.</span>
                    }
                    @foreach (var pairing in list.CoatingPairings)
                    {
                        <div style="display:flex; align-items:center; gap:6px; font-size:13px; margin-bottom:2px;">
                            <span>@pairing.TriggerCoatingLabel &rarr; @pairing.PairedCoatingLabel</span>
                            <form asp-action="RemoveCoatingPairing" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@pairing.Id" />
                                <button type="submit" aria-label="Remove pairing" style="border:none; background:none; cursor:pointer; padding:0; color:#888; font-size:12px; line-height:1;">&times;</button>
                            </form>
                        </div>
                    }
                    <form asp-action="AddCoatingPairing" method="post" style="display:flex; gap:6px; margin-top:6px; flex-wrap:wrap;">
                        <select class="form-select" name="triggerCoatingRefId" style="font-size:12px; width:auto;">
                            @foreach (var option in list.ActiveOptions)
                            {
                                <option value="@option.Id">@option.Label</option>
                            }
                        </select>
                        <span style="align-self:center; font-size:12px;">&rarr;</span>
                        <select class="form-select" name="pairedCoatingRefId" style="font-size:12px; width:auto;">
                            @foreach (var option in list.ActiveOptions)
                            {
                                <option value="@option.Id">@option.Label</option>
                            }
                        </select>
                        <button class="dg-btn dg-btn-ghost" style="padding:4px 12px; font-size:12px;" type="submit">Add pairing</button>
                    </form>

                    <p class="dg-stat-label" style="margin:10px 0 4px;">Exclusions (can never be selected together)</p>
                    @if (!list.CoatingExclusions.Any())
                    {
                        <span style="font-size:12px; color:#999;">None yet.</span>
                    }
                    @foreach (var exclusion in list.CoatingExclusions)
                    {
                        <div style="display:flex; align-items:center; gap:6px; font-size:13px; margin-bottom:2px;">
                            <span>@exclusion.LabelA &#8856; @exclusion.LabelB</span>
                            <form asp-action="RemoveCoatingExclusion" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@exclusion.Id" />
                                <button type="submit" aria-label="Remove exclusion" style="border:none; background:none; cursor:pointer; padding:0; color:#888; font-size:12px; line-height:1;">&times;</button>
                            </form>
                        </div>
                    }
                    <form asp-action="AddCoatingExclusion" method="post" style="display:flex; gap:6px; margin-top:6px; flex-wrap:wrap;">
                        <select class="form-select" name="coatingRefIdA" style="font-size:12px; width:auto;">
                            @foreach (var option in list.ActiveOptions)
                            {
                                <option value="@option.Id">@option.Label</option>
                            }
                        </select>
                        <span style="align-self:center; font-size:12px;">&#8856;</span>
                        <select class="form-select" name="coatingRefIdB" style="font-size:12px; width:auto;">
                            @foreach (var option in list.ActiveOptions)
                            {
                                <option value="@option.Id">@option.Label</option>
                            }
                        </select>
                        <button class="dg-btn dg-btn-ghost" style="padding:4px 12px; font-size:12px;" type="submit">Add exclusion</button>
                    </form>
                </div>
            }

            <form asp-action="Create" method="post">
                <input type="hidden" name="Category" value="@((int)list.Category)" />
                <div style="display:flex; gap:var(--space-2); margin-bottom:6px;">
                    <input class="form-control" name="Label" placeholder="Add option" />
                    <button class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px;" type="submit">Add</button>
                </div>
                @if (list.ShowImageField)
                {
                    <input class="form-control" name="ImageUrl" placeholder="Image URL (optional)" style="margin-bottom:6px;" />
                }
                <label style="display:flex; align-items:center; gap:6px; font-size:12px; color:#888;">
                    <input type="checkbox" name="IsOtherOption" value="true" disabled="@(list.HasActiveOtherOption ? "disabled" : null)" />
                    Mark as this category's "Other" option
                    @if (list.HasActiveOtherOption)
                    {
                        <span>(already set — retire it first)</span>
                    }
                </label>
            </form>
        </div>
    }
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
