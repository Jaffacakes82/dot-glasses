@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Error - DOT Glasses Admin Portal</title>
    <link rel="stylesheet" href="~/css/dot-glasses.css" asp-append-version="true" />
</head>
<body>
    <div class="dg-auth-page">
        <div class="dg-auth-card" style="max-width:480px;">
            <span class="dg-crumb">Error</span>
            <h1 class="dg-page-title">Something went wrong</h1>
            <p style="color:var(--text-muted-2);">An error occurred while processing your request.</p>
            @if (Model.ShowRequestId)
            {
                <p style="font-size:13px; color:var(--text-muted);">Request ID: <code>@Model.RequestId</code></p>
            }
            <a class="dg-btn dg-btn-primary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
        </div>
    </div>
</body>
</html>
