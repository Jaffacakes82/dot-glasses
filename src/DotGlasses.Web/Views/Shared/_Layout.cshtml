@using DotGlasses.Application.Common
@using DotGlasses.Web.Authorization
@using Microsoft.AspNetCore.Authorization
@inject ICurrentUserContext CurrentUser
@inject IAuthorizationService AuthorizationService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    bool IsActive(string controllerName) => string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase);

    var initials = string.IsNullOrWhiteSpace(CurrentUser.UserName)
        ? "?"
        : string.Concat(CurrentUser.UserName.Split([' ', '.', '@'], StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));

    var roleLabel = CurrentUser.Roles.FirstOrDefault() ?? "—";

    // Dashboard/Organisations/Event History/User Directory carry a plain [Authorize] on their
    // controllers — visible to any authenticated role. These three have a real policy gate, so
    // the sidebar mirrors it rather than advertising a link that 403s — nav filtering alone still
    // wouldn't be enough on its own (a bookmarked URL bypasses it), which is what the real
    // AccessDenied page above is for.
    var canViewPresetCatalogues = CurrentUser.IsAuthenticated &&
        (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.PresetCatalogueManage)).Succeeded;
    var canViewCustomOrders = CurrentUser.IsAuthenticated &&
        (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.CustomOrdersView)).Succeeded;
    var canViewReferenceData = CurrentUser.IsAuthenticated &&
        (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.ReferenceDataManage)).Succeeded;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dot Glasses Admin Portal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dot-glasses.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DotGlasses.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @if (CurrentUser.IsAuthenticated)
    {
        <div class="dg-shell">
            <aside class="dg-sidebar">
                <div class="dg-topbar">
                    <a class="dg-sidebar-logo" asp-controller="Home" asp-action="Index">
                        <img src="~/images/dot-glasses-logo.png" alt="Dot Glasses" />
                    </a>
                    <button class="dg-nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#dgNav"
                            aria-controls="dgNav" aria-expanded="false" aria-label="Toggle navigation">
                        &#9776;
                    </button>
                </div>
                <nav class="dg-nav collapse" id="dgNav">
                    <a class="dg-nav-item @(IsActive("Home") ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <span class="dg-dot"></span> Dashboard
                    </a>
                    <a class="dg-nav-item @(IsActive("Organisations") ? "active" : "")" asp-controller="Organisations" asp-action="Index">
                        <span class="dg-dot"></span> Organisations
                    </a>
                    <a class="dg-nav-item @(IsActive("EventHistory") ? "active" : "")" asp-controller="EventHistory" asp-action="Index">
                        <span class="dg-dot"></span> Event History
                    </a>
                    <a class="dg-nav-item @(IsActive("UserDirectory") ? "active" : "")" asp-controller="UserDirectory" asp-action="Index">
                        <span class="dg-dot"></span> User Directory
                    </a>
                    @if (canViewPresetCatalogues)
                    {
                        <a class="dg-nav-item @(IsActive("Catalogues") ? "active" : "")" asp-controller="Catalogues" asp-action="Index">
                            <span class="dg-dot"></span> Preset Catalogues
                        </a>
                    }
                    @if (canViewCustomOrders)
                    {
                        <a class="dg-nav-item @(IsActive("CustomOrders") ? "active" : "")" asp-controller="CustomOrders" asp-action="Index">
                            <span class="dg-dot"></span> Custom Orders
                        </a>
                    }
                    @if (canViewReferenceData)
                    {
                        <a class="dg-nav-item @(IsActive("ReferenceData") ? "active" : "")" asp-controller="ReferenceData" asp-action="Index">
                            <span class="dg-dot"></span> Reference Data
                        </a>
                    }
                </nav>
                <div class="dropup dg-user-chip">
                    @* A single dropdown toggle replaces the old "whole chip links to Settings, plus a
                       separate tiny sign-out icon" layout — it wasn't obvious the chip was clickable
                       at all. The caret is the discoverability cue; both destinations are named. *@
                    <button class="dg-user-chip-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Account menu">
                        <div class="dg-avatar">@initials</div>
                        <div style="flex:1; min-width:0;">
                            <div style="font-weight:600; font-size:13px;">@CurrentUser.UserName</div>
                            <div style="font-size:11px; opacity:0.7; text-transform:uppercase;">@roleLabel</div>
                        </div>
                        <span class="dg-caret">&#9662;</span>
                    </button>
                    <ul class="dropdown-menu dg-user-menu">
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Settings">My Profile</a></li>
                        <li>
                            @* AccountController.Logout has existed since the portal was built but nothing
                               ever posted to it, so there was no way to end a session short of clearing
                               cookies. *@
                            <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                                <button type="submit" class="dropdown-item" style="color:var(--dot-orange);">➜] Sign Out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </aside>
            <main class="dg-content" role="main">
                <partial name="_DomainRuleViolation" />
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main role="main">
            <partial name="_DomainRuleViolation" />
            @RenderBody()
        </main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
