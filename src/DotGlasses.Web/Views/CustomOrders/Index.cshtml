@model IReadOnlyList<DotGlasses.Web.Models.CustomOrder>
@{
    ViewData["Title"] = "Custom Orders";
}

@await Html.PartialAsync("_PageHeader", new DotGlasses.Web.Models.PageHeaderViewModel
{
    Crumb = "Fulfilment",
    Title = "Custom Orders",
})

<p style="max-width:680px; color:var(--text-muted-2); margin-bottom:var(--space-5);">
    This queue is populated from the Field App's Sale flow when the custom/special-lens toggle
    is used — field users cannot submit custom orders directly. Multi-tier approval
    (outlet → retailer → country) is a Day 2 feature; v1 is a flat status queue.
</p>

<div class="dg-card">
    @if (Model.Count == 0)
    {
        <div class="dg-empty-state"><div class="dg-ring"></div><p>No custom orders yet.</p></div>
    }
    else
    {
        <table class="dg-table">
            <thead><tr><th>Customer</th><th>Source outlet</th><th>Prescription</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Customer</td>
                    <td class="dg-muted">@order.Outlet</td>
                    <td class="dg-muted">@order.Prescription</td>
                    <td><span class="dg-badge" style="background:@DotGlasses.Web.Models.CustomOrder.StatusColor[order.Status];">@order.Status</span></td>
                    <td>
                        @if (order.NextStatus is not null)
                        {
                            <button class="dg-btn dg-btn-ghost" style="padding:6px 14px; font-size:12px;" type="button">Advance to @order.NextStatus</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
