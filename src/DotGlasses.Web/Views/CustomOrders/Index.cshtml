@model DotGlasses.Web.Models.CustomOrdersViewModel
@using DotGlasses.Domain.Enums
@{
    ViewData["Title"] = "Custom Orders";
}

@await Html.PartialAsync("_PageHeader", new DotGlasses.Web.Models.PageHeaderViewModel
{
    Crumb = "Fulfilment",
    Title = "Custom Orders",
})

<p style="max-width:680px; color:var(--text-muted-2); margin-bottom:var(--space-5);">
    This queue is populated from the Field App's Sale flow whenever a technician records a Custom
    prescription and marks it to order from DOT Glasses (the outlet doesn't have stock). Multi-tier
    approval (outlet → retailer → country) is a Day 2 feature; v1 is a flat status queue.
</p>

<div style="display:flex; gap:var(--space-2); margin-bottom:var(--space-4); flex-wrap:wrap;">
    <a class="@(Model.Status is null ? "dg-btn dg-btn-primary" : "dg-btn dg-btn-ghost")" style="padding:8px 20px; font-size:13px;" asp-action="Index">All</a>
    @foreach (var status in new[] { FulfilmentStatus.Submitted, FulfilmentStatus.InLab, FulfilmentStatus.ReadyForPickup, FulfilmentStatus.Fulfilled })
    {
        <a class="@(Model.Status == status ? "dg-btn dg-btn-primary" : "dg-btn dg-btn-ghost")" style="padding:8px 20px; font-size:13px;" asp-action="Index" asp-route-status="@status">@DotGlasses.Web.Models.CustomOrder.StatusLabel[status]</a>
    }
</div>

<div class="dg-card">
    @if (Model.Orders.Count == 0)
    {
        <div class="dg-empty-state"><div class="dg-ring"></div><p>No custom orders match the current filter.</p></div>
    }
    else
    {
        <table class="dg-table">
            <thead><tr><th>Customer</th><th>Source outlet</th><th>Prescription</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>@order.Customer</td>
                    <td class="dg-muted">@order.Outlet</td>
                    <td class="dg-muted">@order.Prescription</td>
                    <td><span class="dg-badge" style="background:@DotGlasses.Web.Models.CustomOrder.StatusColor[order.Status];">@DotGlasses.Web.Models.CustomOrder.StatusLabel[order.Status]</span></td>
                    <td>
                        @if (order.NextStatus is { } next)
                        {
                            <form asp-action="AdvanceStatus" method="post" style="display:inline;">
                                <input type="hidden" name="saleId" value="@order.SaleId" />
                                <button class="dg-btn dg-btn-ghost" style="padding:6px 14px; font-size:12px;" type="submit">Advance to @DotGlasses.Web.Models.CustomOrder.StatusLabel[next]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }

    @if (Model.TotalPages > 1)
    {
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:var(--space-4); padding-top:var(--space-4); border-top:1px solid var(--border-default);">
            <span class="dg-muted" style="font-size:13px;">Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)</span>
            <div style="display:flex; gap:var(--space-2);">
                @if (Model.Page > 1)
                {
                    <a class="dg-btn dg-btn-ghost" style="padding:6px 16px; font-size:13px;" asp-action="Index" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)">Previous</a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="dg-btn dg-btn-ghost" style="padding:6px 16px; font-size:13px;" asp-action="Index" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)">Next</a>
                }
            </div>
        </div>
    }
</div>
