@model DotGlasses.Web.Models.CustomOrdersViewModel
@using DotGlasses.Domain.Enums
@{
    ViewData["Title"] = "Custom Orders";
}

@await Html.PartialAsync("_PageHeader", new DotGlasses.Web.Models.PageHeaderViewModel
{
    Crumb = "Fulfilment",
    Title = "Custom Orders",
})

<p style="max-width:680px; color:var(--text-muted-2); margin-bottom:var(--space-5);">
    This queue is populated from the Field App's Sale flow whenever a technician records a Custom
    prescription and marks it to order from Dot Glasses (the outlet doesn't have stock). Grouped by
    retailer, then retail point, then customer. Multi-tier approval (outlet → retailer → country)
    and the retailer/retail-point grouping toggle are Day 2 features.
</p>

<div style="display:flex; gap:var(--space-2); margin-bottom:var(--space-4); flex-wrap:wrap;">
    <a class="@(Model.Status is null ? "dg-btn dg-btn-primary" : "dg-btn dg-btn-ghost")" style="padding:8px 20px; font-size:13px;" asp-action="Index">All</a>
    @foreach (var status in new[] { FulfilmentStatus.Submitted, FulfilmentStatus.InLab, FulfilmentStatus.ReadyForPickup, FulfilmentStatus.Fulfilled })
    {
        <a class="@(Model.Status == status ? "dg-btn dg-btn-primary" : "dg-btn dg-btn-ghost")" style="padding:8px 20px; font-size:13px;" asp-action="Index" asp-route-status="@status">@DotGlasses.Web.Models.CustomOrder.StatusLabel[status]</a>
    }
</div>

@if (Model.Retailers.Count == 0)
{
    <div class="dg-card">
        <div class="dg-empty-state"><div class="dg-ring"></div><p>No custom orders match the current filter.</p></div>
    </div>
}
else
{
    @foreach (var retailer in Model.Retailers)
    {
        <div class="dg-card" style="margin-bottom:var(--space-4);">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--space-3);">
                <h2 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; font-size:16px; margin:0;">@retailer.RetailerName</h2>
                <span class="dg-badge" style="background:var(--dot-orange); color:var(--dot-black);">@retailer.ActiveCount active</span>
            </div>

            @foreach (var retailPoint in retailer.RetailPoints)
            {
                <div style="margin-bottom:var(--space-3); padding-left:var(--space-3); border-left:2px solid var(--border-default);">
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:var(--space-2);">
                        <h3 style="font-family:var(--font-display); font-weight:700; text-transform:uppercase; font-size:13px; margin:0; color:var(--text-muted-2);">@retailPoint.RetailPointName</h3>
                        <span class="dg-badge" style="background:var(--dot-green); color:var(--dot-white);">@retailPoint.ActiveCount active</span>
                    </div>

                    @foreach (var customer in retailPoint.Customers)
                    {
                        <p class="dg-stat-label" style="margin:var(--space-2) 0 4px;">@customer.CustomerName</p>
                        <table class="dg-table" style="margin-bottom:var(--space-2);">
                            <thead><tr><th>Prescription</th><th>Status</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var order in customer.Orders)
                            {
                                <tr>
                                    <td class="dg-muted">@order.Prescription</td>
                                    <td><span class="dg-badge" style="background:@DotGlasses.Web.Models.CustomOrder.StatusColor[order.Status]; color:@(order.Status == FulfilmentStatus.Fulfilled ? "var(--dot-white)" : "var(--dot-black)");">@DotGlasses.Web.Models.CustomOrder.StatusLabel[order.Status]</span></td>
                                    <td>
                                        @if (order.NextStatus is { } next)
                                        {
                                            <form asp-action="AdvanceStatus" method="post" style="display:inline;">
                                                <input type="hidden" name="saleId" value="@order.SaleId" />
                                                <button class="dg-btn dg-btn-ghost" style="padding:6px 14px; font-size:12px;" type="submit">Advance to @DotGlasses.Web.Models.CustomOrder.StatusLabel[next]</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                </div>
            }
        </div>
    }

    <p class="dg-muted" style="font-size:13px;">@Model.TotalCount total custom order@(Model.TotalCount == 1 ? "" : "s") matching the current filter.</p>
}
