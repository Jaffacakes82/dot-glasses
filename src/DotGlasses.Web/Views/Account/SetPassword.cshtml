@model DotGlasses.Web.Models.SetPasswordViewModel
@{
    ViewData["Title"] = "Set your password";
}

<div class="dg-auth-page">
    <div class="dg-auth-card">
        <p class="dg-crumb" style="text-align:center;">DOT Glasses</p>
        <h1 class="dg-page-title">Set your password</h1>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="alert alert-danger" style="border-radius:var(--radius-md); text-align:left;">@Model.Error</div>
        }

        <form asp-action="SetPassword" method="post" style="text-align:left; margin-top:var(--space-5);">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />
            <div class="dg-auth-field">
                <label asp-for="Password">New password</label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger" style="font-size:13px;"></span>
            </div>
            <button type="submit" class="dg-btn dg-btn-primary" style="width:100%; justify-content:center;">Set password</button>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
