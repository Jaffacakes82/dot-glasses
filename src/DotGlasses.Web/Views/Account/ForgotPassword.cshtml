@model DotGlasses.Web.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="dg-auth-page">
    <div class="dg-auth-card">
        <p class="dg-crumb" style="text-align:center;">Dot Glasses</p>
        <h1 class="dg-page-title">Forgot password</h1>

        @if (Model.Sent)
        {
            <div class="alert alert-success" style="border-radius:var(--radius-md); text-align:left;">@DotGlasses.Application.Users.IPasswordResetService.Acknowledgement</div>
            <p style="font-size:13px; color:var(--text-muted-2); text-align:left;">The link works for 24 hours. If nothing arrives, check your spam folder or ask an admin to reset your password.</p>
            <a class="dg-btn dg-btn-primary" style="width:100%;" asp-action="Login">Back to sign in</a>
        }
        else
        {
            <p style="font-size:13px; color:var(--text-muted-2); text-align:left;">Enter the email address you sign in with and we'll send you a link to set a new password.</p>
            <form asp-action="ForgotPassword" method="post" style="text-align:left; margin-top:var(--space-4);">
                <div class="dg-auth-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" type="email" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size:13px;"></span>
                </div>
                <button type="submit" class="dg-btn dg-btn-primary" style="width:100%;">Send link</button>
            </form>
            <p style="margin-top:var(--space-4); font-size:13px;"><a asp-action="Login">Back to sign in</a></p>
        }
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
