@model DotGlasses.Web.Models.EventHistoryViewModel
@{
    ViewData["Title"] = "Event History";

    string PillClass(string tab) => tab == Model.ActiveTab ? "dg-btn dg-btn-primary" : "dg-btn dg-btn-ghost";
}

@await Html.PartialAsync("_PageHeader", new DotGlasses.Web.Models.PageHeaderViewModel
{
    Crumb = "Detail",
    Title = "Event History",
})

<div style="display:flex; gap:var(--space-2); margin-bottom:var(--space-4); flex-wrap:wrap;">
    <a class="@PillClass("sales")" style="padding:8px 20px; font-size:13px;" asp-action="Index" asp-route-tab="sales" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Sales</a>
    <a class="@PillClass("tests")" style="padding:8px 20px; font-size:13px;" asp-action="Index" asp-route-tab="tests" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Tests</a>
    <a class="@PillClass("leads")" style="padding:8px 20px; font-size:13px;" asp-action="Index" asp-route-tab="leads" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Leads</a>
    <a class="@PillClass("referrals")" style="padding:8px 20px; font-size:13px;" asp-action="Index" asp-route-tab="referrals" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Referrals</a>
</div>

<form method="get" asp-action="Index" style="display:flex; align-items:flex-end; gap:8px; margin-bottom:var(--space-5); flex-wrap:wrap;">
    <input type="hidden" name="tab" value="@Model.ActiveTab" />
    @if (Model.ActiveTab == "leads")
    {
        <input type="hidden" name="search" value="@Model.SearchQuery" />
    }
    <div>
        <label class="dg-stat-label" style="display:block; margin-bottom:4px;">From</label>
        <input class="form-control" type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label class="dg-stat-label" style="display:block; margin-bottom:4px;">To</label>
        <input class="form-control" type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
    </div>
    <button class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px;" type="submit">Apply</button>
    @if (Model.FromDate.HasValue || Model.ToDate.HasValue)
    {
        <a class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px;" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-search="@Model.SearchQuery">Clear dates</a>
    }
    <a class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px; margin-left:auto;" asp-action="Export" asp-route-tab="@Model.ActiveTab" asp-route-search="@Model.SearchQuery" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Export CSV</a>
</form>

<div class="dg-card">
    @if (Model.ActiveTab is "sales" or "tests")
    {
        var rows = Model.Events;
        @if (rows.Count == 0)
        {
            <div class="dg-empty-state"><div class="dg-ring"></div><p>No events for the current filters.</p></div>
        }
        else
        {
            <table class="dg-table">
                <thead>
                    <tr>
                        <th>Type</th>
                        @if (Model.ActiveTab == "sales")
                        {
                            <th>Name</th>
                            <th>Consent</th>
                        }
                        <th>Outlet</th>
                        <th>Country</th>
                        <th>Time</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in rows)
                {
                    <tr>
                        <td><span class="dg-badge" style="background:@(row.Type == "Sale" ? "var(--dot-green)" : "var(--dot-blue)"); color:@(row.Type == "Sale" ? "var(--dot-white)" : "var(--dot-black)");">@row.Type@(row.Custom ? " · Custom" : "")</span></td>
                        @if (Model.ActiveTab == "sales")
                        {
                            <td>@row.Name</td>
                            <td class="dg-muted">@(row.ConsentGiven == true ? "Yes" : "No")</td>
                        }
                        <td class="dg-muted">@row.Outlet</td>
                        <td class="dg-muted">@row.Country</td>
                        <td class="dg-muted">@row.Time</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
    else if (Model.ActiveTab == "leads")
    {
        <form method="get" asp-action="Index" style="display:flex; gap:8px; margin-bottom:var(--space-4);">
            <input type="hidden" name="tab" value="leads" />
            <input type="hidden" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
            <input class="form-control" style="max-width:280px;" name="search" value="@Model.SearchQuery" placeholder="Search by name" />
            <button class="dg-btn dg-btn-ghost" type="submit">Search</button>
        </form>
        @if (Model.Leads.Count == 0)
        {
            <div class="dg-empty-state"><div class="dg-ring"></div><p>No leads logged yet.</p></div>
        }
        else
        {
            <table class="dg-table">
                <thead><tr><th>Name</th><th>Phone</th><th>Outlet</th><th>Reason not purchased</th><th>Consent</th><th>Logged</th><th></th></tr></thead>
                <tbody>
                @foreach (var lead in Model.Leads)
                {
                    <tr>
                        <td>@lead.Name</td>
                        <td class="dg-muted">@lead.PhoneMasked</td>
                        <td class="dg-muted">@lead.Outlet</td>
                        <td class="dg-muted">@lead.Reason</td>
                        <td class="dg-muted">@(lead.ConsentGiven ? "Yes" : "No")</td>
                        <td class="dg-muted">@lead.Logged</td>
                        <td>
                            @if (lead.ConvertedFlag)
                            {
                                <span class="dg-badge" style="background:var(--dot-beige);">Converted</span>
                            }
                            else
                            {
                                <a class="dg-btn dg-btn-ghost" style="padding:4px 12px; font-size:12px;" asp-controller="LeadConversion" asp-action="Convert" asp-route-id="@lead.Id">Convert to sale</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
    else
    {
        <p style="color:var(--text-muted-2); margin-bottom:var(--space-4);">Tracked for government reporting requirements in several operating countries.</p>
        @if (Model.Referrals.Count == 0)
        {
            <div class="dg-empty-state"><div class="dg-ring"></div><p>No referrals logged yet.</p></div>
        }
        else
        {
            <table class="dg-table">
                <thead><tr><th>Source</th><th>Outlet</th><th>Country</th><th>Reason</th><th>Treated in facility</th><th>Time</th></tr></thead>
                <tbody>
                @foreach (var referral in Model.Referrals)
                {
                    <tr>
                        <td><span class="dg-badge" style="background:var(--dot-beige);">@referral.Source</span></td>
                        <td>@referral.Outlet</td>
                        <td class="dg-muted">@referral.Country</td>
                        <td class="dg-muted">@referral.Reason</td>
                        <td class="dg-muted">@(referral.TreatedInFacility ? "Yes" : "No")</td>
                        <td class="dg-muted">@referral.Time</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }

    @if (Model.TotalPages > 1)
    {
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:var(--space-4); padding-top:var(--space-4); border-top:1px solid var(--border-default);">
            <span class="dg-muted" style="font-size:13px;">Page @Model.Page of @Model.TotalPages (@Model.TotalCount total)</span>
            <div style="display:flex; gap:var(--space-2);">
                @if (Model.Page > 1)
                {
                    <a class="dg-btn dg-btn-ghost" style="padding:6px 16px; font-size:13px;" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-search="@Model.SearchQuery" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page - 1)">Previous</a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a class="dg-btn dg-btn-ghost" style="padding:6px 16px; font-size:13px;" asp-action="Index" asp-route-tab="@Model.ActiveTab" asp-route-search="@Model.SearchQuery" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-page="@(Model.Page + 1)">Next</a>
                }
            </div>
        </div>
    }
</div>
