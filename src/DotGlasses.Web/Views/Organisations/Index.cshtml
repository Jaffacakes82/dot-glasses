@model DotGlasses.Web.Models.OrganisationsIndexViewModel
@{
    ViewData["Title"] = "Organisations";
    ViewData["SelectedId"] = Model.Selected.Id;
    var addChildLabel = Model.ValidChildLevels.Count == 1 ? Model.ValidChildLevels[0].Label : "sub-organisation";
}

@await Html.PartialAsync("_PageHeader", new DotGlasses.Web.Models.PageHeaderViewModel
{
    Crumb = "Org Structure",
    Title = "Organisations",
})

<p style="max-width:640px; color:var(--text-muted-2); margin-bottom:var(--space-5);">
    The hierarchy is arbitrary depth — DGI is always the root and Retail Points are always the
    leaves, but any number of Retailer/Reseller layers can sit between them. For affiliated
    networks (e.g. a diocese), model one Retailer for the umbrella organisation and give each
    Retail Point a combined "Name / Location" field. You only see and manage your own node and
    everything below it.
</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" style="border-radius:var(--radius-md); margin-bottom:var(--space-4);" asp-validation-summary="All"></div>
}

<div style="display:grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-5);">
    <div class="dg-card">
        @await Html.PartialAsync("_OrgTreeNode", Model.Tree)
    </div>
    <div class="dg-card">
        <span class="dg-badge" style="background:@DotGlasses.Web.Models.OrgNode.TypeColor[Model.Selected.Type]; color:var(--dot-white);">@Model.Selected.Type</span>
        @if (Model.Selected.IsTrainingOrg)
        {
            <span class="dg-badge" style="background:var(--dot-yellow);">Training org — excluded from MI dashboards</span>
        }
        <h2 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin: var(--space-3) 0;">@Model.Selected.Name</h2>
        @if (!string.IsNullOrEmpty(Model.Selected.Kind))
        {
            <p class="dg-stat-label">@Model.Selected.Kind</p>
        }
        @if (Model.Selected.Type == "RetailPoint")
        {
            <p style="font-size:13px; color:var(--text-muted-2);">No inventory/SKU data shown here — stock is tracked externally in Zoho.</p>
        }

        @if (Model.SelectedAssignedUsers.Count > 0)
        {
            <div style="margin-top:var(--space-3);">
                <p class="dg-stat-label">Assigned users</p>
                <ul style="margin:0; padding-left:18px; font-size:13px; color:var(--text-muted-2); list-style:none;">
                    @foreach (var user in Model.SelectedAssignedUsers)
                    {
                        <li style="display:flex; align-items:center; gap:6px; margin-bottom:2px;">
                            @user.DisplayName
                            @if (Model.CanManage)
                            {
                                <form asp-action="UnassignUser" method="post" style="display:inline;">
                                    <input type="hidden" name="orgNodeId" value="@Model.Selected.Id" />
                                    <input type="hidden" name="userId" value="@user.UserId" />
                                    <button type="submit" aria-label="Unassign @user.DisplayName" style="border:none; background:none; cursor:pointer; padding:0; color:#888; font-size:12px; line-height:1;">&times;</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            </div>
        }

        @if (!Model.CanManage)
        {
            <p style="font-size:12px; color:#999; margin-top:var(--space-3);">You don't have permission to manage this node.</p>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:var(--space-2); margin-top:var(--space-4);">
                <button class="dg-btn dg-btn-ghost" type="button" data-bs-toggle="modal" data-bs-target="#renameModal">Rename</button>

                <form asp-action="SetTrainingOrgFlag" method="post">
                    <input type="hidden" name="id" value="@Model.Selected.Id" />
                    <input type="hidden" name="value" value="@((!Model.Selected.IsTrainingOrg).ToString())" />
                    <button class="dg-btn dg-btn-ghost" style="width:100%; justify-content:center;" type="submit">
                        @(Model.Selected.IsTrainingOrg ? "Remove training-org flag" : "Flag as training organisation")
                    </button>
                </form>

                @if (Model.Selected.Type != "RetailPoint")
                {
                    <button class="dg-btn dg-btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addChildModal">Add @addChildLabel</button>
                }

                @if (Model.AssignableUsers.Count > 0)
                {
                    <button class="dg-btn dg-btn-ghost" type="button" data-bs-toggle="modal" data-bs-target="#assignUserModal">Assign users</button>
                }

                @if (Model.SelectedHasChildren)
                {
                    <p style="font-size:12px; color:#999; margin:0;">Deactivate this node's child orgs first before deactivating it.</p>
                }
                else
                {
                    <form asp-action="SetActive" method="post" onsubmit="return confirm('Deactivate @Model.Selected.Name? It will disappear from the tree until reactivated.');">
                        <input type="hidden" name="id" value="@Model.Selected.Id" />
                        <input type="hidden" name="value" value="false" />
                        <button class="dg-btn dg-btn-ghost" style="width:100%; justify-content:center; color:#b00;" type="submit">Deactivate</button>
                    </form>
                }
            </div>
        }
    </div>
</div>

@if (Model.DeactivatedNodes.Count > 0)
{
    <div class="dg-card" style="margin-top:var(--space-4);">
        <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin-top:0; font-size:14px;">Deactivated orgs</h3>
        <div style="display:flex; flex-wrap:wrap; gap:6px;">
            @foreach (var node in Model.DeactivatedNodes)
            {
                <span class="dg-badge" style="background:#f2f2f2; color:#999; display:inline-flex; align-items:center; gap:6px;">
                    @node.Name
                    <form asp-action="SetActive" method="post" style="display:inline;">
                        <input type="hidden" name="id" value="@node.Id" />
                        <input type="hidden" name="value" value="true" />
                        <button type="submit" style="border:none; background:none; cursor:pointer; padding:0; color:var(--dot-blue); font-size:12px; text-decoration:underline;">Reactivate</button>
                    </form>
                </span>
            }
        </div>
    </div>
}

<div class="modal fade" id="renameModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:var(--radius-md); border:none;">
            <form asp-action="Rename" method="post">
                <input type="hidden" name="Id" value="@Model.Selected.Id" />
                <div class="modal-header">
                    <h2 class="dg-page-title" style="font-size:20px;">Rename @Model.Selected.Name</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="dg-auth-field">
                        <label>Name</label>
                        <input class="form-control" name="Name" value="@Model.Selected.Name" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="dg-btn dg-btn-ghost" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="dg-btn dg-btn-primary" type="submit">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.CanManage && Model.Selected.Type != "RetailPoint")
{
    <div class="modal fade" id="addChildModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="border-radius:var(--radius-md); border:none;">
                <form asp-action="CreateChild" method="post">
                    <input type="hidden" name="ParentId" value="@Model.Selected.Id" />
                    <div class="modal-header">
                        <h2 class="dg-page-title" style="font-size:20px;">Add @addChildLabel under @Model.Selected.Name</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="dg-auth-field">
                            <label>Name</label>
                            <input class="form-control" name="Name" />
                        </div>
                        <div class="dg-auth-field">
                            <label>Kind (optional display label, e.g. "Distributor")</label>
                            <input class="form-control" name="Kind" />
                        </div>
                        @if (Model.ValidChildLevels.Count > 1)
                        {
                            <div class="dg-auth-field">
                                <label>Level</label>
                                <select class="form-select" name="Level">
                                    @foreach (var level in Model.ValidChildLevels)
                                    {
                                        <option value="@level.Value">@level.Label</option>
                                    }
                                </select>
                            </div>
                        }
                        else if (Model.ValidChildLevels.Count == 1)
                        {
                            <input type="hidden" name="Level" value="@Model.ValidChildLevels[0].Value" />
                            <p style="font-size:12px; color:var(--text-muted);">This will be created as a @Model.ValidChildLevels[0].Label.</p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="dg-btn dg-btn-ghost" type="button" data-bs-dismiss="modal">Cancel</button>
                        <button class="dg-btn dg-btn-primary" type="submit">Create</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.CanManage && Model.AssignableUsers.Count > 0)
{
    <div class="modal fade" id="assignUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="border-radius:var(--radius-md); border:none;">
                <form asp-action="AssignUser" method="post">
                    <input type="hidden" name="OrgNodeId" value="@Model.Selected.Id" />
                    <div class="modal-header">
                        <h2 class="dg-page-title" style="font-size:20px;">Assign a user to @Model.Selected.Name</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="dg-auth-field">
                            <label>User</label>
                            <select class="form-select" name="UserId">
                                @foreach (var user in Model.AssignableUsers)
                                {
                                    <option value="@user.Id">@user.DisplayName</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="dg-btn dg-btn-ghost" type="button" data-bs-dismiss="modal">Cancel</button>
                        <button class="dg-btn dg-btn-primary" type="submit">Assign</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
