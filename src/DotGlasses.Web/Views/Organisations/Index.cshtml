@model DotGlasses.Web.Models.OrgNode
@{
    ViewData["Title"] = "Organisations";
    ViewData["SelectedId"] = Model.Id;
}

@await Html.PartialAsync("_PageHeader", new DotGlasses.Web.Models.PageHeaderViewModel
{
    Crumb = "Org Structure",
    Title = "Organisations",
})

<p style="max-width:640px; color:var(--text-muted-2); margin-bottom:var(--space-5);">
    The hierarchy is arbitrary depth — DGI is always the root and Retail Points are always the
    leaves, but any number of Retailer/Reseller layers can sit between them. For affiliated
    networks (e.g. a diocese), model one Retailer for the umbrella organisation and give each
    Retail Point a combined "Name / Location" field.
</p>

<div style="display:grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-5);">
    <div class="dg-card">
        @await Html.PartialAsync("_OrgTreeNode", Model)
    </div>
    <div class="dg-card">
        <span class="dg-badge" style="background:@DotGlasses.Web.Models.OrgNode.TypeColor[Model.Type]; color:var(--dot-white);">@Model.Type</span>
        <h2 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin: var(--space-3) 0;">@Model.Name</h2>
        @if (Model.Catalogue is not null)
        {
            <p class="dg-stat-label">Assigned catalogue</p>
            <p style="margin-top:-8px;">@Model.Catalogue <span style="color:var(--text-muted);">(cascades to child outlets)</span></p>
        }
        @if (Model.Type == "RetailPoint")
        {
            <p style="font-size:13px; color:var(--text-muted-2);">No inventory/SKU data shown here — stock is tracked externally in Zoho.</p>
        }
        <div style="display:flex; flex-direction:column; gap:var(--space-2); margin-top:var(--space-4);">
            @if (Model.Type != "RetailPoint")
            {
                <button class="dg-btn dg-btn-primary" type="button">Add child node</button>
            }
            <button class="dg-btn dg-btn-ghost" type="button">Assign users</button>
            @if (Model.Type != "DGI")
            {
                <button class="dg-btn dg-btn-ghost" type="button">Assign preset catalogue</button>
            }
        </div>
    </div>
</div>
