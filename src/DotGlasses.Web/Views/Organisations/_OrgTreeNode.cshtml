@model DotGlasses.Web.Models.OrgNode
@{
    var depth = ViewData["Depth"] as int? ?? 0;
    var selectedId = ViewData["SelectedId"] as Guid?;
    var isSelected = Model.Id == selectedId;
}
<a href="?selectedId=@Model.Id" style="text-decoration:none; color:inherit; display:block;">
    <div style="padding: 8px 12px; padding-left: @(12 + depth * 24)px; border-radius: var(--radius-sm); @(isSelected ? "background:rgba(249,103,21,0.12);" : "") display:flex; align-items:center; gap:8px;">
        @if (Model.Children.Count > 0)
        {
            <span style="font-size:11px; color:var(--text-muted);">&#9662;</span>
        }
        else
        {
            <span style="width:11px;"></span>
        }
        <span style="width:8px; height:8px; border-radius:50%; background:@DotGlasses.Web.Models.OrgNode.TypeColor[Model.Type]; flex:0 0 8px;"></span>
        <span style="font-weight:600;">@Model.Name</span>
        @if (Model.IsTrainingOrg)
        {
            <span class="dg-badge" style="background:var(--dot-yellow); font-size:10px; padding:2px 6px;">Training</span>
        }
        <span class="dg-stat-label" style="margin-left:auto;">@Model.Type</span>
    </div>
</a>
@foreach (var child in Model.Children)
{
    @await Html.PartialAsync("_OrgTreeNode", child, new ViewDataDictionary(ViewData) { ["Depth"] = depth + 1 })
}
