@model DotGlasses.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "MI Reporting Dashboard";
}

@await Html.PartialAsync("_PageHeader", new DotGlasses.Web.Models.PageHeaderViewModel
{
    Crumb = "MI Reporting",
    Title = "MI Reporting Dashboard",
})

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-5);">
    <div class="dg-card"><div class="dg-stat-label">Pending leads</div><div class="dg-stat-value">@Model.PendingLeads</div></div>
    <div class="dg-card"><div class="dg-stat-label">Total tests</div><div class="dg-stat-value">@Model.TotalTests</div></div>
    <div class="dg-card"><div class="dg-stat-label">Standard sales</div><div class="dg-stat-value">@Model.StandardSales</div></div>
    <div class="dg-card"><div class="dg-stat-label">Custom orders</div><div class="dg-stat-value">@Model.CustomOrders</div></div>
    <div class="dg-card"><div class="dg-stat-label">Test-to-sale conversion</div><div class="dg-stat-value">@Model.TestToSaleConversion.ToString("0.0")%</div></div>
    <div class="dg-card"><div class="dg-stat-label">Needed-to-sale conversion</div><div class="dg-stat-value">@Model.NeededToSaleConversion.ToString("0.0")%</div></div>
</div>

<div style="display:grid; grid-template-columns: 2fr 1fr; gap: var(--space-5);">
    <div class="dg-card">
        <h2 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; font-size:18px; margin-top:0;">Top performing</h2>
        @if (Model.TopOutlets.Count == 0 && Model.TopRetailers.Count == 0 && Model.TopCountries.Count == 0 && Model.TopTechnicians.Count == 0)
        {
            <div class="dg-empty-state"><div class="dg-ring"></div><p>No sales recorded yet.</p></div>
        }
        else
        {
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-5);">
                <div>
                    <div class="dg-stat-label" style="margin-bottom:var(--space-2);">Top outlets</div>
                    @foreach (var (entry, i) in Model.TopOutlets.Select((e, i) => (e, i)))
                    {
                        <div style="padding:var(--space-2); border-radius:var(--radius-sm); @(i == 0 ? "background:rgba(249,103,21,0.12);" : "")">
                            <div style="font-weight:600;">@entry.Name</div>
                            <div class="dg-stat-label">@entry.Sales sales · @entry.ConversionPercent.ToString("0.0")%</div>
                        </div>
                    }
                </div>
                <div>
                    <div class="dg-stat-label" style="margin-bottom:var(--space-2);">Top retailers</div>
                    @foreach (var (entry, i) in Model.TopRetailers.Select((e, i) => (e, i)))
                    {
                        <div style="padding:var(--space-2); border-radius:var(--radius-sm); @(i == 0 ? "background:rgba(249,103,21,0.12);" : "")">
                            <div style="font-weight:600;">@entry.Name</div>
                            <div class="dg-stat-label">@entry.Sales sales · @entry.ConversionPercent.ToString("0.0")%</div>
                        </div>
                    }
                </div>
                <div>
                    <div class="dg-stat-label" style="margin-bottom:var(--space-2);">Top countries</div>
                    @foreach (var (entry, i) in Model.TopCountries.Select((e, i) => (e, i)))
                    {
                        <div style="padding:var(--space-2); border-radius:var(--radius-sm); @(i == 0 ? "background:rgba(249,103,21,0.12);" : "")">
                            <div style="font-weight:600;">@entry.Name</div>
                            <div class="dg-stat-label">@entry.Sales sales · @entry.ConversionPercent.ToString("0.0")%</div>
                        </div>
                    }
                </div>
                <div>
                    <div class="dg-stat-label" style="margin-bottom:var(--space-2);">Top technicians</div>
                    @foreach (var (entry, i) in Model.TopTechnicians.Select((e, i) => (e, i)))
                    {
                        <div style="padding:var(--space-2); border-radius:var(--radius-sm); @(i == 0 ? "background:rgba(249,103,21,0.12);" : "")">
                            <div style="font-weight:600;">@entry.Name</div>
                            <div class="dg-stat-label">@entry.Sales sales · @entry.ConversionPercent.ToString("0.0")%</div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div style="display:flex; flex-direction:column; gap:var(--space-5);">
        <div class="dg-card">
            <div class="dg-stat-label" style="margin-bottom:var(--space-3);">Referrals logged</div>
            <div class="dg-stat-value" style="margin-top:0;">@Model.ReferralsLogged</div>
            <p style="font-size:13px; color:var(--text-muted-2); margin-bottom:0;">See Event History for detail.</p>
        </div>

        <div class="dg-card">
            <div class="dg-stat-label" style="margin-bottom:var(--space-3);">Conversion trend (last 6 weeks)</div>
            <div style="display:flex; align-items:flex-end; gap:6px; height:80px;">
                @foreach (var value in Model.ConversionTrend)
                {
                    <div style="flex:1; background:var(--dot-orange); border-radius:2px 2px 0 0; height:@(value)%;" title="@value%"></div>
                }
            </div>
        </div>

        <div class="dg-card">
            <div class="dg-stat-label" style="margin-bottom:var(--space-3);">Gender split</div>
            <div style="display:flex; height:20px; border-radius:var(--radius-pill); overflow:hidden;">
                <div style="width:@(Model.GenderMalePercent)%; background:var(--dot-blue);"></div>
                <div style="width:@(Model.GenderFemalePercent)%; background:var(--dot-pink);"></div>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:12px; margin-top:var(--space-2);">
                <span>Male @Model.GenderMalePercent%</span>
                <span>Female @Model.GenderFemalePercent%</span>
            </div>
        </div>
    </div>
</div>
