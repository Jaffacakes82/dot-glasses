@model DotGlasses.Web.Models.DashboardViewModel
@using DotGlasses.Application.Dashboard
@using DotGlasses.Web.Models
@{
    ViewData["Title"] = "MI Reporting Dashboard";
    var from = Model.FromDate?.ToString("yyyy-MM-dd");
    var to = Model.ToDate?.ToString("yyyy-MM-dd");
    var country = Model.Country?.ToString();
}

@await Html.PartialAsync("_PageHeader", new DotGlasses.Web.Models.PageHeaderViewModel
{
    Crumb = "MI Reporting",
    Title = "MI Reporting Dashboard",
})

<form method="get" asp-action="Index" style="display:flex; align-items:flex-end; gap:8px; margin-bottom:var(--space-4); flex-wrap:wrap;">
    <div>
        <label class="dg-stat-label" style="display:block; margin-bottom:4px;">From</label>
        <input class="form-control" type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label class="dg-stat-label" style="display:block; margin-bottom:4px;">To</label>
        <input class="form-control" type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label class="dg-stat-label" style="display:block; margin-bottom:4px;" for="country">Country</label>
        <select class="form-select" id="country" name="country">
            <option value="">All countries</option>
            @foreach (var option in Model.Countries)
            {
                <option value="@option.Id" selected="@(Model.Country == option.Id ? "selected" : null)">@option.Name</option>
            }
        </select>
    </div>
    <div>
        <label class="dg-stat-label" style="display:block; margin-bottom:4px;" for="retailer">Retailer</label>
        <select class="form-select" id="retailer" name="retailer">
            <option value="">All retailers</option>
            @foreach (var option in Model.Retailers)
            {
                <option value="@option.Id" selected="@(Model.Retailer == option.Id.ToString() ? "selected" : null)">@option.Name</option>
            }
            @if (Model.HasNoRetailerOption)
            {
                <option value="@DashboardViewModel.NoRetailerValue" selected="@(Model.Retailer == DashboardViewModel.NoRetailerValue ? "selected" : null)">No retailer</option>
            }
        </select>
    </div>
    <input type="hidden" name="rank" value="@Model.Ranking" />
    <button class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px;" type="submit">Apply</button>
    @if (Model.HasAnyFilter)
    {
        <a class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px;" asp-action="Index" asp-route-rank="@Model.Ranking">Clear filters</a>
    }
</form>

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-5);">
    <a class="dg-card" style="display:block; text-decoration:none; color:inherit;" asp-controller="EventHistory" asp-action="Index" asp-route-tab="leads" asp-route-fromDate="@from" asp-route-toDate="@to">
        <div class="dg-stat-label">Pending leads</div><div class="dg-stat-value">@Model.PendingLeads</div>
    </a>
    <a class="dg-card" style="display:block; text-decoration:none; color:inherit;" asp-controller="EventHistory" asp-action="Index" asp-route-tab="tests" asp-route-fromDate="@from" asp-route-toDate="@to">
        <div class="dg-stat-label">Total tests</div><div class="dg-stat-value">@Model.TotalTests</div>
    </a>
    <a class="dg-card" style="display:block; text-decoration:none; color:inherit;" asp-controller="EventHistory" asp-action="Index" asp-route-tab="sales" asp-route-fromDate="@from" asp-route-toDate="@to">
        <div class="dg-stat-label">Standard sales</div><div class="dg-stat-value">@Model.StandardSales</div>
    </a>
    <a class="dg-card" style="display:block; text-decoration:none; color:inherit;" asp-controller="CustomOrders" asp-action="Index">
        <div class="dg-stat-label">Custom orders</div><div class="dg-stat-value">@Model.CustomOrders</div>
    </a>
    <div class="dg-card"><div class="dg-stat-label">Test-to-sale conversion</div><div class="dg-stat-value">@Model.TestToSaleConversion.ToString("0.0")%</div></div>
    <div class="dg-card"><div class="dg-stat-label">Needed-to-sale conversion</div><div class="dg-stat-value">@Model.NeededToSaleConversion.ToString("0.0")%</div></div>
</div>

@if (Model.HasOrganisationFilter)
{
    <p id="drilldownNote" style="font-size:12px; color:var(--text-muted); margin:calc(var(--space-4) * -1) 0 var(--space-5);">
        The tiles link to Event History and Custom Orders for the same dates. Those screens don't filter by country or retailer, so they list more than the figures here count.
    </p>
}

<div style="display:grid; grid-template-columns: 2fr 1fr; gap: var(--space-5);">
    <div class="dg-card">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); flex-wrap:wrap; margin-bottom:var(--space-3);">
            <h2 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; font-size:18px; margin:0;">Top performing</h2>
            <div id="rankingSwitch" style="display:flex; gap:6px;">
                <a class="dg-btn @(Model.Ranking == DashboardRanking.MostSales ? "dg-btn-primary" : "dg-btn-ghost")" style="padding:6px 14px; font-size:12px;"
                   asp-action="Index" asp-route-fromDate="@from" asp-route-toDate="@to" asp-route-country="@country" asp-route-retailer="@Model.Retailer" asp-route-rank="@DashboardRanking.MostSales">Most sales</a>
                <a class="dg-btn @(Model.Ranking == DashboardRanking.BestConversion ? "dg-btn-primary" : "dg-btn-ghost")" style="padding:6px 14px; font-size:12px;"
                   asp-action="Index" asp-route-fromDate="@from" asp-route-toDate="@to" asp-route-country="@country" asp-route-retailer="@Model.Retailer" asp-route-rank="@DashboardRanking.BestConversion">Best conversion</a>
            </div>
        </div>
        @if (Model.TopLists.All(list => list.Entries.Count == 0))
        {
            <div class="dg-empty-state"><div class="dg-ring"></div><p>Nothing recorded yet.</p></div>
        }
        else
        {
            <p style="font-size:12px; color:var(--text-muted); margin:0 0 var(--space-3);">
                Conversion is the share of the tests recorded there that became a sale through a lead.
            </p>
            <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-5);">
                @foreach (var (heading, entries) in Model.TopLists)
                {
                    <div>
                        <div class="dg-stat-label" style="margin-bottom:var(--space-2);">@heading</div>
                        @foreach (var (entry, i) in entries.Select((e, i) => (e, i)))
                        {
                            <div class="dg-top-entry" style="padding:var(--space-2); border-radius:var(--radius-sm); @(i == 0 ? "background:rgba(249,103,21,0.12);" : "")">
                                <div style="font-weight:600;">@entry.Name</div>
                                <div class="dg-stat-label">@entry.Tests tests · @entry.Leads leads · @entry.Sales sales · @entry.ConversionPercent.ToString("0.0")%</div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div style="display:flex; flex-direction:column; gap:var(--space-5);">
        <a class="dg-card" style="display:block; text-decoration:none; color:inherit;" asp-controller="EventHistory" asp-action="Index" asp-route-tab="referrals" asp-route-fromDate="@from" asp-route-toDate="@to">
            <div class="dg-stat-label" style="margin-bottom:var(--space-3);">Referrals logged</div>
            <div class="dg-stat-value" style="margin-top:0;">@Model.ReferralsLogged</div>
            <p style="font-size:13px; color:var(--text-muted-2); margin-bottom:0;">See Event History for detail.</p>
        </a>

        <div class="dg-card">
            <div class="dg-stat-label" style="margin-bottom:var(--space-3);">Conversion trend (last 6 weeks)</div>
            <div style="display:flex; align-items:flex-end; gap:6px; height:80px;">
                @foreach (var value in Model.ConversionTrend)
                {
                    <div style="flex:1; background:var(--dot-orange); border-radius:2px 2px 0 0; height:@(value)%;" title="@value%"></div>
                }
            </div>
        </div>

        <div class="dg-card">
            <div class="dg-stat-label" style="margin-bottom:var(--space-3);">Gender split</div>
            <div style="display:flex; height:20px; border-radius:var(--radius-pill); overflow:hidden;">
                <div style="width:@(Model.GenderMalePercent)%; background:var(--dot-blue);"></div>
                <div style="width:@(Model.GenderFemalePercent)%; background:var(--dot-pink);"></div>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:12px; margin-top:var(--space-2);">
                <span>Male @Model.GenderMalePercent%</span>
                <span>Female @Model.GenderFemalePercent%</span>
            </div>
        </div>
    </div>
</div>
