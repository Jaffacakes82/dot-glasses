@model DotGlasses.Web.Models.LensSetsListViewModel
@{
    ViewData["Title"] = "Lens Sets";
    var searching = !string.IsNullOrWhiteSpace(Model.Search);
    // Lower-case, as the query string spells it.
    var status = Model.Status.ToString().ToLowerInvariant();
    var showActions = Model.LensSets.Any(x => x.CanReactivate);
}

<div class="dg-page-header">
    <div>
        <span class="dg-crumb">Configuration</span>
        <h1 class="dg-page-title">Lens Sets</h1>
    </div>
    <button class="dg-btn dg-btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createCatalogueModal">Create lens set</button>
</div>

<partial name="_LensSetTabs" model="false" />

<p class="dg-crumb" style="margin-bottom:var(--space-5);">Lens set creation is restricted to DGI/Country-office level — retailers and outlets may only assign what's pushed to them.</p>

@if (TempData["Info"] is string info)
{
    <div class="alert alert-success" style="border-radius:var(--radius-md); margin-bottom:var(--space-4);">@info</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" style="border-radius:var(--radius-md); margin-bottom:var(--space-4);" asp-validation-summary="All"></div>
}

<div class="dg-card" style="margin-bottom:var(--space-6);">
    <form method="get" asp-action="Index" style="display:flex; gap:var(--space-3); align-items:flex-end; flex-wrap:wrap; margin-bottom:var(--space-4);">
        <div style="flex:0 1 180px; min-width:0;">
            <label class="dg-stat-label" for="lensSetStatus" style="display:block; margin-bottom:4px;">Status</label>
            <select class="form-select" id="lensSetStatus" name="status" onchange="this.form.submit();">
                <option value="active" selected="@(Model.Status == LensSetStatusFilter.Active)">Active</option>
                <option value="retired" selected="@(Model.Status == LensSetStatusFilter.Retired)">Retired</option>
                <option value="all" selected="@(Model.Status == LensSetStatusFilter.All)">All</option>
            </select>
        </div>
        <div style="flex:1 1 220px; max-width:320px; min-width:0;">
            <label class="dg-stat-label" for="lensSetSearch" style="display:block; margin-bottom:4px;">Name</label>
            <input class="form-control" id="lensSetSearch" name="search" value="@Model.Search" placeholder="Search by lens set name" />
        </div>
        <button class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px;" type="submit">Search</button>
        @if (searching)
        {
            <a class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px;" asp-action="Index" asp-route-status="@status">Clear</a>
        }
    </form>

    @if (!Model.LensSets.Any())
    {
        <div class="dg-empty-state">
            <div class="dg-ring"></div>
            @if (searching)
            {
                <p>No lens sets match "@Model.Search".</p>
            }
            else if (Model.Status == LensSetStatusFilter.Retired)
            {
                <p>No retired lens sets.</p>
            }
            else
            {
                <p>No lens sets yet. Create one to start adding lenses.</p>
            }
        </div>
    }
    else
    {
        @* The table scrolls inside its card on a narrow screen, so the page itself never does;
           position:relative keeps the visually-hidden "Actions" heading inside the scroll box. *@
        <div style="overflow-x:auto; position:relative;">
            <table class="dg-table" id="lensSetsTable" aria-label="Lens sets">
                <thead>
                    <tr>
                        <th>Lens set</th>
                        <th>Owned by</th>
                        <th>Lenses</th>
                        <th>Assigned to</th>
                        <th>Status</th>
                        @if (showActions)
                        {
                            <th><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lensSet in Model.LensSets)
                    {
                        <tr data-lens-set-id="@lensSet.Id">
                            <td style="min-width:200px;">
                                <a asp-action="Details" asp-route-id="@lensSet.Id" style="font-weight:700; overflow-wrap:anywhere;">@lensSet.Name</a>
                                @if (!string.IsNullOrWhiteSpace(lensSet.Description))
                                {
                                    <div class="dg-muted" style="font-size:13px;">@lensSet.Description</div>
                                }
                            </td>
                            <td>@lensSet.OwningOrgName</td>
                            <td style="white-space:nowrap;">
                                @if (lensSet.LensCount == 0)
                                {
                                    <span class="dg-muted">No lenses yet</span>
                                }
                                else
                                {
                                    @($"{lensSet.LensCount} {(lensSet.LensCount == 1 ? "lens" : "lenses")}")
                                }
                            </td>
                            <td style="white-space:nowrap;">
                                @if (lensSet.AssignedOrgCount == 0)
                                {
                                    <span class="dg-muted">Not assigned</span>
                                }
                                else
                                {
                                    @($"{lensSet.AssignedOrgCount} {(lensSet.AssignedOrgCount == 1 ? "organisation" : "organisations")}")
                                }
                            </td>
                            <td>
                                @if (lensSet.IsRetired)
                                {
                                    <span class="dg-badge" style="background:var(--dot-beige);">Retired</span>
                                }
                                else
                                {
                                    <span class="dg-badge" style="background:var(--dot-green); color:var(--dot-white);">Active</span>
                                }
                            </td>
                            @if (showActions)
                            {
                                <td style="white-space:nowrap;">
                                    @if (lensSet.CanReactivate)
                                    {
                                        <form asp-action="ReactivateCatalogue" method="post" style="display:inline;">
                                            <input type="hidden" name="catalogueId" value="@lensSet.Id" />
                                            <button type="submit" class="dg-btn dg-btn-ghost" style="padding:4px 12px; font-size:12px;"
                                                    aria-label="Reactivate @lensSet.Name">Reactivate</button>
                                        </form>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="createCatalogueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:var(--radius-md); border:none;">
            <form asp-action="CreateCatalogue" method="post">
                <div class="modal-header">
                    <h2 class="dg-page-title" style="font-size:20px;">Create lens set</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="dg-auth-field">
                        <label>Lens set name</label>
                        <input class="form-control" name="Name" />
                    </div>
                    <div class="dg-auth-field">
                        <label>Description</label>
                        <input class="form-control" name="Description" />
                    </div>
                    @if (Model.OwningOrgOptions.Count > 1)
                    {
                        <div class="dg-auth-field">
                            <label>Owning org</label>
                            <select class="form-control" name="OwningOrgNodeId">
                                @foreach (var org in Model.OwningOrgOptions)
                                {
                                    <option value="@org.Id">@org.Name</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="dg-btn dg-btn-ghost" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="dg-btn dg-btn-primary" type="submit">Save lens set</button>
                </div>
            </form>
        </div>
    </div>
</div>
