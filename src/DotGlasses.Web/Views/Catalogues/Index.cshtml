@model DotGlasses.Web.Models.CataloguesIndexViewModel
@{
    ViewData["Title"] = "Lens Sets";
}

<div class="dg-page-header">
    <div>
        <span class="dg-crumb">Configuration</span>
        <h1 class="dg-page-title">Lens Sets</h1>
    </div>
    <div style="display:flex; gap:8px;">
        <a class="dg-btn dg-btn-ghost" asp-action="LensPowers">Lens powers</a>
        <button class="dg-btn dg-btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createCatalogueModal">Create lens set</button>
    </div>
</div>

<p class="dg-crumb" style="margin-bottom:var(--space-5);">Lens set creation is restricted to DGI/Country-office level — retailers and outlets may only assign what's pushed to them.</p>

@if (TempData["Info"] is string info)
{
    <div class="alert alert-success" style="border-radius:var(--radius-md); margin-bottom:var(--space-4);">@info</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" style="border-radius:var(--radius-md); margin-bottom:var(--space-4);" asp-validation-summary="All"></div>
}

<form method="get" asp-action="Index" style="display:flex; gap:8px; margin-bottom:var(--space-4);">
    <input class="form-control" style="max-width:280px;" name="search" value="@Model.Search" placeholder="Search by lens set name" />
    <button class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px;" type="submit">Search</button>
    @if (!string.IsNullOrEmpty(Model.Search))
    {
        <a class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px;" asp-action="Index">Clear</a>
    }
</form>

@if (Model.Catalogues.Count == 0)
{
    <div class="dg-empty-state"><div class="dg-ring"></div><p>No lens sets match "@Model.Search".</p></div>
}

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-6);">
    @foreach (var catalogue in Model.Catalogues)
    {
        <div class="dg-card">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin:0 0 var(--space-2); font-size:16px;">@catalogue.Name</h3>
                @if (catalogue.CanEdit)
                {
                    <button class="dg-btn dg-btn-ghost" style="padding:6px 14px; font-size:12px;" type="button"
                            data-bs-toggle="modal" data-bs-target="#editCatalogueModal-@catalogue.Id">Edit</button>
                }
            </div>
            @if (!catalogue.CanEdit)
            {
                <p class="dg-crumb">Owned above your organisation — you can assign it, but not change it.</p>
            }
            <p style="color:var(--text-muted-2); font-size:14px;">@catalogue.Description</p>
            <p class="dg-stat-label">Assigned to @catalogue.AssignedOrgs.Count org(s)</p>
            @if (catalogue.AssignedOrgs.Any())
            {
                <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:var(--space-2);">
                    @foreach (var assignedOrg in catalogue.AssignedOrgs)
                    {
                        <span class="dg-badge" style="background:#f2f2f2; display:inline-flex; align-items:center; gap:6px;">
                            @assignedOrg.OrgName
                            @if (assignedOrg.CanUnassign)
                            {
                                <form asp-action="UnassignCatalogue" method="post" style="display:inline;">
                                    <input type="hidden" name="catalogueId" value="@catalogue.Id" />
                                    <input type="hidden" name="orgNodeId" value="@assignedOrg.OrgNodeId" />
                                    <button type="submit" aria-label="Unassign from @assignedOrg.OrgName" style="border:none; background:none; cursor:pointer; padding:0; color:#888; font-size:13px; line-height:1;">&times;</button>
                                </form>
                            }
                        </span>
                    }
                </div>
            }

            @if (!catalogue.LensOptions.Any())
            {
                <p style="font-size:13px; color:#999; margin:var(--space-3) 0;">No lenses yet.</p>
            }
            else
            {
                @* Read-only for now: adding and editing a lens (its power, lens type, coatings and
                   pairings) is the Add lens dialog, which comes next (lens-power ticket 07). *@
                <div style="overflow-x:auto; margin:var(--space-3) 0;">
                    <table class="dg-table" aria-label="Lenses in @catalogue.Name">
                        <thead>
                            <tr>
                                <th>Label</th>
                                <th>Lens power</th>
                                <th>Lens type</th>
                                <th>Coatings</th>
                                <th>Pairings</th>
                                @if (catalogue.CanEdit)
                                {
                                    <th><span class="visually-hidden">Actions</span></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lens in catalogue.LensOptions)
                            {
                                <tr>
                                    <td>@lens.Label</td>
                                    <td style="white-space:nowrap;">@lens.LensPower</td>
                                    <td>@lens.LensType</td>
                                    <td>@string.Join(", ", lens.Coatings)</td>
                                    <td>@(lens.Pairings.Any() ? string.Join(", ", lens.Pairings) : "—")</td>
                                    @if (catalogue.CanEdit)
                                    {
                                        <td>
                                            <form asp-action="RemoveLensOption" method="post" style="display:inline;">
                                                <input type="hidden" name="lensOptionId" value="@lens.Id" />
                                                <button type="submit" class="dg-btn dg-btn-ghost" style="padding:2px 10px; font-size:12px;"
                                                        aria-label="Remove @lens.Label">Remove</button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (catalogue.CanEdit)
        {
            <div class="modal fade" id="editCatalogueModal-@catalogue.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content" style="border-radius:var(--radius-md); border:none;">
                        <form asp-action="UpdateCatalogue" method="post">
                            <input type="hidden" name="Id" value="@catalogue.Id" />
                            <div class="modal-header">
                                <h2 class="dg-page-title" style="font-size:20px;">Edit @catalogue.Name</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="dg-auth-field">
                                    <label>Lens set name</label>
                                    <input class="form-control" name="Name" value="@catalogue.Name" />
                                </div>
                                <div class="dg-auth-field">
                                    <label>Description</label>
                                    <input class="form-control" name="Description" value="@catalogue.Description" />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button class="dg-btn dg-btn-ghost" type="submit" form="retireCatalogueForm-@catalogue.Id" style="margin-right:auto;"
                                        data-confirm="Retire @catalogue.Name? It stops being offered in the Field App; records that used it keep its name, and you can reactivate it later."
                                        onclick="return confirm(this.dataset.confirm);">Retire</button>
                                <button class="dg-btn dg-btn-ghost" type="button" data-bs-dismiss="modal">Cancel</button>
                                <button class="dg-btn dg-btn-primary" type="submit">Save lens set</button>
                            </div>
                        </form>
                        @* A sibling form, not nested — HTML forbids a form inside a form; the Retire button
                           above submits this one through its form attribute. *@
                        <form id="retireCatalogueForm-@catalogue.Id" asp-action="RetireCatalogue" method="post">
                            <input type="hidden" name="catalogueId" value="@catalogue.Id" />
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (Model.RetiredCatalogues.Any())
{
    <div class="dg-card" style="margin-bottom:var(--space-6);">
        <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin-top:0;">Retired lens sets</h3>
        <p style="font-size:13px; color:var(--text-muted-2);">
            Not offered in the Field App or the assign form. Records that used them still show their name.
            Reactivating restores a lens set with its assignments as they were.
        </p>
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
            @foreach (var retired in Model.RetiredCatalogues)
            {
                <span class="dg-badge" style="background:#f2f2f2; display:inline-flex; align-items:center; gap:8px;">
                    @retired.Name
                    @if (retired.CanReactivate)
                    {
                        <form asp-action="ReactivateCatalogue" method="post" style="display:inline;">
                            <input type="hidden" name="catalogueId" value="@retired.Id" />
                            <button type="submit" class="dg-btn dg-btn-ghost" style="padding:2px 10px; font-size:12px;">Reactivate</button>
                        </form>
                    }
                </span>
            }
        </div>
    </div>
}

<div class="dg-card" style="margin-bottom:var(--space-6);">
    <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin-top:0;">Assign lens sets to a retailer</h3>
    <p style="font-size:12px; color:var(--text-muted); margin-bottom:var(--space-3);">
        An outlet can hold more than one lens set at a time (e.g. during a stock transition) — select all
        that apply. Assignment cascades automatically to every outlet under the selected org.
    </p>
    <form asp-action="AssignCatalogues" method="post" style="display:flex; gap:var(--space-3); flex-wrap:wrap; align-items:flex-end;">
        <div style="flex:1; min-width:200px;">
            <label class="dg-stat-label" style="display:block; margin-bottom:4px;">Retailer</label>
            <select class="form-select" name="OrgNodeId">
                @foreach (var org in Model.AssignableOrgs)
                {
                    <option value="@org.Id">@org.Name</option>
                }
            </select>
        </div>
        <div style="flex:1; min-width:200px;">
            <label class="dg-stat-label" style="display:block; margin-bottom:4px;">Lens sets</label>
            <select class="form-select" name="CatalogueIds" multiple size="@Math.Max(2, Model.Catalogues.Count)">
                @foreach (var catalogue in Model.Catalogues)
                {
                    <option value="@catalogue.Id">@catalogue.Name</option>
                }
            </select>
        </div>
        <button class="dg-btn dg-btn-primary" type="submit">Assign</button>
    </form>
</div>

<div class="modal fade" id="createCatalogueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:var(--radius-md); border:none;">
            <form asp-action="CreateCatalogue" method="post">
                <div class="modal-header">
                    <h2 class="dg-page-title" style="font-size:20px;">Create lens set</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="dg-auth-field">
                        <label>Lens set name</label>
                        <input class="form-control" name="Name" />
                    </div>
                    <div class="dg-auth-field">
                        <label>Description</label>
                        <input class="form-control" name="Description" />
                    </div>
                    @if (Model.OwningOrgOptions.Count > 1)
                    {
                        <div class="dg-auth-field">
                            <label>Owning org</label>
                            <select class="form-control" name="OwningOrgNodeId">
                                @foreach (var org in Model.OwningOrgOptions)
                                {
                                    <option value="@org.Id">@org.Name</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="dg-btn dg-btn-ghost" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="dg-btn dg-btn-primary" type="submit">Save lens set</button>
                </div>
            </form>
        </div>
    </div>
</div>
