@model DotGlasses.Web.Models.CataloguesIndexViewModel
@{
    ViewData["Title"] = "Preset Catalogues";
}

<div class="dg-page-header">
    <div>
        <span class="dg-crumb">Configuration</span>
        <h1 class="dg-page-title">Preset Catalogues</h1>
    </div>
    <button class="dg-btn dg-btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createCatalogueModal">Create package</button>
</div>

<p class="dg-crumb" style="margin-bottom:var(--space-5);">Catalogue creation is restricted to DGI/Country-office level — retailers and outlets may only assign what's pushed to them.</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" style="border-radius:var(--radius-md); margin-bottom:var(--space-4);" asp-validation-summary="All"></div>
}

<div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-6);">
    @foreach (var catalogue in Model.Catalogues)
    {
        <div class="dg-card">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin:0 0 var(--space-2); font-size:16px;">@catalogue.Name</h3>
                <button class="dg-btn dg-btn-ghost" style="padding:6px 14px; font-size:12px;" type="button"
                        data-bs-toggle="modal" data-bs-target="#editCatalogueModal-@catalogue.Id">Edit</button>
            </div>
            <p style="color:var(--text-muted-2); font-size:14px;">@catalogue.Description</p>
            @if (!string.IsNullOrEmpty(catalogue.RangeDescription))
            {
                <p class="dg-crumb">Diopter range: @catalogue.RangeDescription</p>
            }
            @if (catalogue.Kind != DotGlasses.Domain.Enums.PresetCatalogueKind.Other)
            {
                <p class="dg-crumb">Field App picker role: <strong>@catalogue.Kind</strong></p>
            }
            <p class="dg-stat-label">Assigned to @catalogue.AssignedOrgs.Count org(s)</p>
            @if (catalogue.AssignedOrgs.Any())
            {
                <div style="display:flex; flex-wrap:wrap; gap:6px; margin-bottom:var(--space-2);">
                    @foreach (var assignedOrg in catalogue.AssignedOrgs)
                    {
                        <span class="dg-badge" style="background:#f2f2f2; display:inline-flex; align-items:center; gap:6px;">
                            @assignedOrg.OrgName
                            <form asp-action="UnassignCatalogue" method="post" style="display:inline;">
                                <input type="hidden" name="catalogueId" value="@catalogue.Id" />
                                <input type="hidden" name="orgNodeId" value="@assignedOrg.OrgNodeId" />
                                <button type="submit" aria-label="Unassign from @assignedOrg.OrgName" style="border:none; background:none; cursor:pointer; padding:0; color:#888; font-size:13px; line-height:1;">&times;</button>
                            </form>
                        </span>
                    }
                </div>
            }

            <div style="display:flex; flex-wrap:wrap; gap:6px; margin:var(--space-3) 0;">
                @if (!catalogue.LensOptions.Any())
                {
                    <span style="font-size:13px; color:#999;">No lens options yet.</span>
                }
                @foreach (var lensOption in catalogue.LensOptions)
                {
                    <span class="dg-badge" style="background:var(--dot-beige); display:inline-flex; align-items:center; gap:6px;">
                        @lensOption.Label
                        <form asp-action="RemoveLensOption" method="post" style="display:inline;">
                            <input type="hidden" name="lensOptionId" value="@lensOption.Id" />
                            <button type="submit" aria-label="Remove @lensOption.Label" style="border:none; background:none; cursor:pointer; padding:0; color:#888; font-size:13px; line-height:1;">&times;</button>
                        </form>
                    </span>
                }
            </div>

            @{
                var availableStrengths = Model.AllLensStrengths.Where(s => !catalogue.LensOptions.Any(l => l.LensStrengthRefId == s.Id)).ToList();
            }
            @if (availableStrengths.Any())
            {
                <form asp-action="AddLensOption" method="post" style="display:flex; gap:var(--space-2);">
                    <input type="hidden" name="CatalogueId" value="@catalogue.Id" />
                    <select class="form-select" name="LensStrengthRefId" style="flex:1;">
                        @foreach (var strength in availableStrengths)
                        {
                            <option value="@strength.Id">@strength.Label</option>
                        }
                    </select>
                    <button class="dg-btn dg-btn-ghost" style="padding:8px 16px; font-size:13px; white-space:nowrap;" type="submit">Add lens</button>
                </form>
            }
            else
            {
                <p style="font-size:12px; color:#999; margin:0;">Every active lens strength is already on this catalogue.</p>
            }
        </div>

        <div class="modal fade" id="editCatalogueModal-@catalogue.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content" style="border-radius:var(--radius-md); border:none;">
                    <form asp-action="UpdateCatalogue" method="post">
                        <input type="hidden" name="Id" value="@catalogue.Id" />
                        <div class="modal-header">
                            <h2 class="dg-page-title" style="font-size:20px;">Edit @catalogue.Name</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="dg-auth-field">
                                <label>Package name</label>
                                <input class="form-control" name="Name" value="@catalogue.Name" />
                            </div>
                            <div class="dg-auth-field">
                                <label>Description</label>
                                <input class="form-control" name="Description" value="@catalogue.Description" />
                            </div>
                            <div class="dg-auth-field">
                                <label>Diopter / strength range</label>
                                <input class="form-control" name="RangeDescription" value="@catalogue.RangeDescription" />
                            </div>
                            <div class="dg-auth-field">
                                <label>Field App picker role</label>
                                <select class="form-select" name="Kind">
                                    @foreach (var kind in Enum.GetValues<DotGlasses.Domain.Enums.PresetCatalogueKind>())
                                    {
                                        <option value="@((int)kind)" selected="@(catalogue.Kind == kind ? "selected" : null)">@kind</option>
                                    }
                                </select>
                                <p class="dg-crumb" style="margin-top:4px;">SixLensSet/NineLensSet drive the Field App's 6-Lens/9-Lens buttons — only one catalogue may hold each.</p>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="dg-btn dg-btn-ghost" type="button" data-bs-dismiss="modal">Cancel</button>
                            <button class="dg-btn dg-btn-primary" type="submit">Save package</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<div class="dg-card" style="margin-bottom:var(--space-6);">
    <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin-top:0;">Assign packages to a retailer</h3>
    <p style="font-size:12px; color:var(--text-muted); margin-bottom:var(--space-3);">
        An outlet can hold more than one preset at a time (e.g. during a stock transition) — select all
        that apply. Assignment cascades automatically to every outlet under the selected org.
    </p>
    <form asp-action="AssignCatalogues" method="post" style="display:flex; gap:var(--space-3); flex-wrap:wrap; align-items:flex-end;">
        <div style="flex:1; min-width:200px;">
            <label class="dg-stat-label" style="display:block; margin-bottom:4px;">Retailer</label>
            <select class="form-select" name="OrgNodeId">
                @foreach (var org in Model.AssignableOrgs)
                {
                    <option value="@org.Id">@org.Name</option>
                }
            </select>
        </div>
        <div style="flex:1; min-width:200px;">
            <label class="dg-stat-label" style="display:block; margin-bottom:4px;">Catalogues</label>
            <select class="form-select" name="CatalogueIds" multiple size="@Math.Max(2, Model.Catalogues.Count)">
                @foreach (var catalogue in Model.Catalogues)
                {
                    <option value="@catalogue.Id">@catalogue.Name</option>
                }
            </select>
        </div>
        <button class="dg-btn dg-btn-primary" type="submit">Assign</button>
    </form>
</div>

<div class="dg-card">
    <h3 style="font-family:var(--font-display); font-weight:900; text-transform:uppercase; margin-top:0;">Lens strength coating availability</h3>
    <p style="font-size:12px; color:var(--text-muted); margin-bottom:var(--space-3);">
        Which coatings each lens strength can be sold with on a preset range — drives the Field App's
        coating picker. A strength with no coatings checked can't be sold on a preset range yet.
    </p>
    @if (!Model.ActiveCoatings.Any())
    {
        <p style="font-size:13px; color:#999;">No active Coating reference-data items exist yet — add some under Reference Data first.</p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table class="dg-table">
                <thead>
                    <tr>
                        <th>Lens strength</th>
                        @foreach (var coating in Model.ActiveCoatings)
                        {
                            <th>@coating.Label</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var strength in Model.AllLensStrengths)
                    {
                        var available = Model.AvailableCoatingsByLensStrength.GetValueOrDefault(strength.Id, []);
                        <tr>
                            <td>@strength.Label</td>
                            @foreach (var coating in Model.ActiveCoatings)
                            {
                                <td>
                                    <form asp-action="SetCoatingAvailability" method="post">
                                        <input type="hidden" name="LensStrengthRefId" value="@strength.Id" />
                                        <input type="hidden" name="CoatingRefId" value="@coating.Id" />
                                        <input type="hidden" name="Available" value="@(!available.Contains(coating.Id) ? "true" : "false")" />
                                        <button type="submit" style="border:none; background:none; cursor:pointer; padding:0; font-size:16px;"
                                                aria-label="Toggle @coating.Label for @strength.Label">
                                            @(available.Contains(coating.Id) ? "✅" : "⬜")
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="createCatalogueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:var(--radius-md); border:none;">
            <form asp-action="CreateCatalogue" method="post">
                <div class="modal-header">
                    <h2 class="dg-page-title" style="font-size:20px;">Create package</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="dg-auth-field">
                        <label>Package name</label>
                        <input class="form-control" name="Name" />
                    </div>
                    <div class="dg-auth-field">
                        <label>Description</label>
                        <input class="form-control" name="Description" />
                    </div>
                    <div class="dg-auth-field">
                        <label>Diopter / strength range</label>
                        <input class="form-control" name="RangeDescription" />
                    </div>
                    <div class="dg-auth-field">
                        <label>Field App picker role</label>
                        <select class="form-select" name="Kind">
                            @foreach (var kind in Enum.GetValues<DotGlasses.Domain.Enums.PresetCatalogueKind>())
                            {
                                <option value="@((int)kind)">@kind</option>
                            }
                        </select>
                        <p class="dg-crumb" style="margin-top:4px;">SixLensSet/NineLensSet drive the Field App's 6-Lens/9-Lens buttons — only one catalogue may hold each.</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="dg-btn dg-btn-ghost" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="dg-btn dg-btn-primary" type="submit">Save package</button>
                </div>
            </form>
        </div>
    </div>
</div>
